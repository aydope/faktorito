      /**
       * Replace Bootstrap Icons <i> tags with inline SVGs
       * so html-to-image renders them correctly.
       * Returns a restore function to put the originals back.
       */
      function replaceIconsWithSvg(root) {
        var icons = root.querySelectorAll('i[class*="bi-"]');
        var originals = [];

        icons.forEach(function (icon) {
          var biClass = Array.from(icon.classList).find(function (c) {
            return c.startsWith('bi-') && c !== 'bi';
          });
          if (!biClass) return;

          var svg = ICON_SVG_MAP[biClass];
          if (!svg) return;

          originals.push({
            el: icon,
            html: icon.innerHTML,
            className: icon.className,
          });

          // Clear font classes to avoid rendering an empty box
          icon.className = '';
          icon.innerHTML = svg;
          icon.style.display = 'inline-flex';
          icon.style.alignItems = 'center';
          icon.style.justifyContent = 'center';
          icon.style.width = '1em';
          icon.style.height = '1em';
          icon.style.verticalAlign = '-0.125em';
        });

        return function restore() {
          originals.forEach(function (o) {
            o.el.innerHTML = o.html;
            o.el.className = o.className;
            o.el.style.display = '';
            o.el.style.alignItems = '';
            o.el.style.justifyContent = '';
            o.el.style.width = '';
            o.el.style.height = '';
            o.el.style.verticalAlign = '';
          });
        };
      }

      /* Share invoice link via native share or clipboard */
      document.getElementById('shareBtn').addEventListener('click', function () {
        var data = {
          title: <%- JSON.stringify('فاکتور ' + sh.number) %>,
          text: <%- JSON.stringify(sh.club + ': ' + money(sh.total) + ' تومان').replace(/</g, '\\u003c') %>,
          url: location.href,
        };

        if (navigator.share) {
          navigator.share(data).catch(function () {});
          return;
        }

        (navigator.clipboard ? navigator.clipboard.writeText(location.href) : Promise.reject())
          .then(function () { toast('لینک فاکتور کپی شد'); })
          .catch(function () { toast('کپی نشد'); });
      });

      /* Download invoice as PNG */
      document.getElementById('dlBtn').addEventListener('click', async function () {
        if (typeof htmlToImage === 'undefined') {
          return toast('کمی بعد دوباره تلاش کنید');
        }

        var btn = this;
        var icon = document.getElementById('dlIcon');
        var text = document.getElementById('dlText');
        var originalIcon = icon.className;
        var originalText = text ? text.textContent : '';

        btn.classList.add('is-loading');
        icon.className = 'bi bi-arrow-clockwise';
        if (text) text.textContent = 'در حال ساخت...';

        var restoreIcons = null;

        try {
          // Wait for fonts to load so the PNG looks correct
          if (document.fonts && document.fonts.ready) {
            await document.fonts.ready;
          }
          await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

          var node = document.getElementById('invoiceContainer');

          // Swap icon fonts for inline SVGs before rendering
          restoreIcons = replaceIconsWithSvg(node);

          await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));

          var dataUrl = await htmlToImage.toPng(node, {
            pixelRatio: 2.5,
            backgroundColor: null,
            cacheBust: true,
            style: {
              fontFamily: "'Sahel', 'Vazirmatn', system-ui, sans-serif",
              textRendering: 'geometricPrecision',
            },
          });

          var a = document.createElement('a');
          a.download = <%- JSON.stringify('invoice-' + sh.number + '.png').replace(/</g, '\\u003c') %>;
          a.href = dataUrl;
          a.click();
          toast('تصویر ذخیره شد');
        } catch (err) {
          console.error('html-to-image error:', err);
          toast('ساخت تصویر ناموفق بود');
        } finally {
          if (restoreIcons) restoreIcons();
          btn.classList.remove('is-loading');
          icon.className = originalIcon;
          if (text) text.textContent = originalText;
        }
      });
    })();
  </script>
