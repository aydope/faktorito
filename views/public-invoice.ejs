<%
  const sh = sheet;

  const money = (n) => Number(n || 0).toLocaleString('fa-IR-u-nu-latn');

  const faDate = (d) => {
    if (!d) return { date: '-', time: '-' };
    try {
      const date = new Date(d);
      return {
        date: date.toLocaleDateString('fa-IR-u-nu-latn', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }),
        time: date.toLocaleTimeString('fa-IR-u-nu-latn', {
          hour: '2-digit',
          minute: '2-digit',
        }),
      };
    } catch (e) {
      return { date: '-', time: '-' };
    }
  };

  const dt = faDate(sh.date);
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="<%= sh.theme %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#0b0b14" />
  <title>فاکتور <%= sh.number %> | <%= sh.club %></title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <%- include('partials/invoice-sheet-css') %>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif;
    }

    body {
      min-height: 100vh;
      padding: 20px 14px 60px;
      background: #07060f;
      color: #f3f4f6;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* Theme-specific page backgrounds */
    html[data-theme="aurora"] body {
      background:
        #07060f radial-gradient(900px 420px at 85% -10%, rgba(139, 92, 246, 0.30), transparent 60%),
        radial-gradient(700px 380px at -10% 110%, rgba(34, 211, 238, 0.10), transparent 60%);
    }

    html[data-theme="midnight"] body {
      background: #030712 radial-gradient(900px 420px at 85% -10%, rgba(56, 189, 248, 0.26), transparent 60%);
    }

    html[data-theme="mono"] body {
      background: #ececef;
      color: #111827;
    }

    html[data-theme="luxe"] body {
      background:
        #050506 radial-gradient(900px 480px at 80% -12%, rgba(232, 200, 114, 0.20), transparent 60%),
        radial-gradient(700px 380px at -10% 110%, rgba(184, 134, 11, 0.14), transparent 60%);
    }

    .wrap {
      max-width: 520px;
      margin: 0 auto;
    }

    /* ===== Toolbar ===== */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 16px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    html[data-theme="mono"] .toolbar {
      background: rgba(0, 0, 0, 0.03);
      border-color: rgba(0, 0, 0, 0.08);
    }

    .toolbar-back {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 14px;
      border-radius: 11px;
      font-size: 12.5px;
      font-weight: 700;
      text-decoration: none;
      color: inherit;
      background: rgba(127, 127, 127, 0.08);
      border: 1px solid rgba(127, 127, 127, 0.18);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .toolbar-back:hover {
      background: rgba(127, 127, 127, 0.14);
      transform: translateY(-1px);
    }

    .toolbar-back i {
      font-size: 14px;
    }

    .toolbar-actions {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-shrink: 0;
    }

    .tool-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      height: 38px;
      padding: 0 13px;
      border-radius: 11px;
      font-size: 12.5px;
      font-weight: 700;
      font-family: inherit;
      text-decoration: none;
      cursor: pointer;
      color: inherit;
      background: rgba(127, 127, 127, 0.06);
      border: 1px solid rgba(127, 127, 127, 0.16);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .tool-btn:hover {
      background: rgba(127, 127, 127, 0.12);
      border-color: rgba(127, 127, 127, 0.28);
      transform: translateY(-1px);
    }

    .tool-btn:active {
      transform: scale(0.97);
    }

    .tool-btn i {
      font-size: 14px;
    }

    .tool-btn.icon-only {
      width: 38px;
      padding: 0;
    }

    .tool-btn-primary {
      color: #fff;
      background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
      border: none;
      box-shadow: 0 4px 14px -4px rgba(124, 58, 237, 0.55);
      padding: 0 15px;
      gap: 7px;
      position: relative;
      overflow: hidden;
    }

    .tool-btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.15), transparent 40%);
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }

    .tool-btn-primary:hover {
      background: linear-gradient(135deg, #8b5cf6 0%, #c4b5fd 100%);
      box-shadow: 0 8px 22px -6px rgba(124, 58, 237, 0.7);
      transform: translateY(-1px);
    }

    .tool-btn-primary:hover::before {
      opacity: 1;
    }

    .tool-btn-primary:active {
      transform: scale(0.97);
    }

    .tool-btn-primary i,
    .tool-btn-primary span {
      position: relative;
      z-index: 1;
    }

    .tool-btn-primary i {
      font-size: 15px;
    }

    /* Primary button theme overrides */
    html[data-theme="midnight"] .tool-btn-primary {
      background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);
      box-shadow: 0 4px 14px -4px rgba(2, 132, 199, 0.55);
    }

    html[data-theme="midnight"] .tool-btn-primary:hover {
      background: linear-gradient(135deg, #0ea5e9 0%, #7dd3fc 100%);
      box-shadow: 0 8px 22px -6px rgba(2, 132, 199, 0.7);
    }

    html[data-theme="mono"] .tool-btn-primary {
      color: #fff;
      background: #111827;
      box-shadow: 0 4px 12px -4px rgba(0, 0, 0, 0.3);
    }

    html[data-theme="mono"] .tool-btn-primary:hover {
      background: #1f2937;
    }

    html[data-theme="luxe"] .tool-btn-primary {
      color: #1a1405;
      background: linear-gradient(135deg, #b8860b 0%, #f0d98a 50%, #b8860b 100%);
      box-shadow: 0 4px 16px -4px rgba(184, 134, 11, 0.5);
    }

    html[data-theme="luxe"] .tool-btn-primary:hover {
      background: linear-gradient(135deg, #d4a017 0%, #f6e7a8 50%, #d4a017 100%);
      box-shadow: 0 8px 22px -6px rgba(184, 134, 11, 0.6);
    }

    .tool-btn-primary.is-loading {
      pointer-events: none;
      opacity: 0.85;
    }

    .tool-btn-primary.is-loading i {
      animation: spin 0.9s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* ===== Toast ===== */
    #toast {
      position: fixed;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      background: #111827;
      color: #fff;
      padding: 10px 22px;
      border-radius: 99px;
      font-size: 12.5px;
      font-weight: 700;
      display: none;
      z-index: 50;
      box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    }

    /* ===== Responsive toolbar ===== */
    @media (max-width: 480px) {
      body {
        padding: 12px 10px 50px;
      }

      .toolbar {
        padding: 8px 10px;
        gap: 6px;
        border-radius: 14px;
      }

      .toolbar-back {
        padding: 7px 10px;
        font-size: 12px;
      }

      .toolbar-back span {
        display: none;
      }

      .toolbar-back i {
        font-size: 15px;
      }

      .tool-btn {
        height: 36px;
        padding: 0 10px;
        font-size: 12px;
      }

      .tool-btn.icon-only {
        width: 36px;
      }

      .tool-btn i {
        font-size: 13px;
      }

      .tool-btn-primary {
        padding: 0 12px;
        gap: 6px;
      }

      .tool-btn-primary span {
        font-size: 12px;
      }
    }

    @media (max-width: 360px) {
      .tool-btn-primary span {
        display: none;
      }

      .tool-btn-primary {
        width: 36px;
        padding: 0;
      }

      .toolbar-back {
        padding: 7px 8px;
      }
    }

    /* ===== Receipt print ===== */
    .receipt {
      display: none;
    }

    @media print {
      @page {
        size: 80mm auto;
        margin: 4mm;
      }

      html,
      body {
        background: #fff !important;
        color: #000 !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 80mm !important;
        min-height: auto !important;
      }

      .toolbar,
      #toast,
      .invoice-main {
        display: none !important;
      }

      .receipt {
        display: block !important;
      }

      .receipt,
      .receipt * {
        background: #fff !important;
        background-image: none !important;
        color: #000 !important;
        box-shadow: none !important;
        text-shadow: none !important;
        border-color: #000 !important;
        filter: none !important;
        backdrop-filter: none !important;
        opacity: 1 !important;
        font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
      }

      .receipt {
        width: 100% !important;
        max-width: 80mm !important;
        margin: 0 auto !important;
        padding: 0 !important;
        font-size: 11px !important;
        line-height: 1.55 !important;
        direction: rtl !important;
        text-align: right !important;
      }

      /* Receipt header */
      .rcpt-logo {
        text-align: center !important;
        padding: 6px 0 8px !important;
        border-bottom: 1px dashed #000 !important;
        margin-bottom: 6px !important;
      }

      .rcpt-logo .rcpt-logo-mark {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 34px !important;
        height: 34px !important;
        border: 1px solid #000 !important;
        border-radius: 50% !important;
        font-size: 16px !important;
        font-weight: 900 !important;
        margin-bottom: 4px !important;
      }

      .rcpt-logo .rcpt-store {
        font-size: 14px !important;
        font-weight: 900 !important;
        letter-spacing: -0.3px !important;
        line-height: 1.3 !important;
      }

      .rcpt-logo .rcpt-store-sub {
        font-size: 10px !important;
        margin-top: 2px !important;
      }

      .rcpt-store-info {
        text-align: center !important;
        font-size: 10px !important;
        line-height: 1.7 !important;
        padding: 0 4px !important;
        margin-bottom: 6px !important;
      }

      .rcpt-divider {
        border-top: 1px dashed #000 !important;
        margin: 6px 0 !important;
        height: 0 !important;
      }

      /* Receipt rows */
      .rcpt-row {
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
        gap: 6px !important;
        font-size: 10.5px !important;
        padding: 2px 0 !important;
      }

      .rcpt-row .lbl {
        color: #000 !important;
        font-weight: 600 !important;
      }

      .rcpt-row .val {
        color: #000 !important;
        font-weight: 700 !important;
        font-variant-numeric: tabular-nums !important;
        direction: ltr !important;
      }

      /* Receipt items */
      .rcpt-items-head {
        display: flex !important;
        justify-content: space-between !important;
        font-size: 10px !important;
        font-weight: 900 !important;
        padding: 3px 0 !important;
        border-bottom: 1px solid #000 !important;
      }

      .rcpt-items-head .col-name {
        flex: 1 !important;
        text-align: right !important;
      }

      .rcpt-items-head .col-qty {
        width: 40px !important;
        text-align: center !important;
      }

      .rcpt-items-head .col-price {
        width: 75px !important;
        text-align: left !important;
        direction: ltr !important;
      }

      .rcpt-item {
        display: flex !important;
        justify-content: space-between !important;
        gap: 6px !important;
        font-size: 10.5px !important;
        padding: 3px 0 !important;
        border-bottom: 1px dotted #000 !important;
        align-items: baseline !important;
      }

      .rcpt-item:last-child {
        border-bottom: none !important;
      }

      .rcpt-item .col-name {
        flex: 1 !important;
        text-align: right !important;
        word-break: break-word !important;
      }

      .rcpt-item .col-qty {
        width: 40px !important;
        text-align: center !important;
        font-variant-numeric: tabular-nums !important;
      }

      .rcpt-item .col-price {
        width: 75px !important;
        text-align: left !important;
        font-variant-numeric: tabular-nums !important;
        direction: ltr !important;
        font-weight: 700 !important;
      }

      /* Receipt totals */
      .rcpt-total-block {
        margin-top: 4px !important;
        padding-top: 4px !important;
        border-top: 3px double #000 !important;
      }

      .rcpt-total-row {
        display: flex !important;
        justify-content: space-between !important;
        font-size: 11px !important;
        padding: 2px 0 !important;
      }

      .rcpt-total-row.big {
        font-size: 13px !important;
        font-weight: 900 !important;
        padding-top: 4px !important;
        margin-top: 4px !important;
        border-top: 1px dashed #000 !important;
      }

      .rcpt-total-row .val {
        direction: ltr !important;
        font-variant-numeric: tabular-nums !important;
        font-weight: 700 !important;
      }

      .rcpt-total-row.big .val {
        font-size: 13px !important;
        font-weight: 900 !important;
      }

      /* Receipt status and extras */
      .rcpt-status {
        text-align: center !important;
        padding: 6px 0 !important;
        font-size: 11px !important;
        font-weight: 900 !important;
        letter-spacing: 0.5px !important;
        border-top: 1px dashed #000 !important;
        border-bottom: 1px dashed #000 !important;
        margin: 6px 0 !important;
      }

      .rcpt-qr {
        text-align: center !important;
        padding: 6px 0 !important;
        margin-top: 4px !important;
      }

      .rcpt-qr svg {
        display: inline-block !important;
        width: 30mm !important;
        height: 30mm !important;
      }

      .rcpt-qr-label {
        font-size: 9px !important;
        margin-top: 3px !important;
        text-align: center !important;
      }

      .rcpt-sign {
        text-align: center !important;
        font-size: 9.5px !important;
        padding: 4px 0 !important;
      }

      .rcpt-footer {
        text-align: center !important;
        padding: 8px 0 4px !important;
        border-top: 1px dashed #000 !important;
        margin-top: 6px !important;
      }

      .rcpt-footer .thanks {
        font-size: 11px !important;
        font-weight: 900 !important;
        margin-bottom: 3px !important;
      }

      .rcpt-footer .msg {
        font-size: 9.5px !important;
        line-height: 1.7 !important;
      }

      .rcpt-footer .brand {
        font-size: 8.5px !important;
        margin-top: 4px !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px !important;
      }

      .rcpt-item,
      .rcpt-row,
      .rcpt-total-row {
        page-break-inside: avoid !important;
      }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <!-- Toolbar -->
    <div class="toolbar">
      <% if (isOwner) { %>
        <a class="toolbar-back" href="/invoices">
          <i class="bi bi-arrow-right"></i><span>فاکتورها</span>
        </a>
      <% } else { %>
        <span class="toolbar-back" style="cursor:default">
          <i class="bi bi-receipt"></i><span>فاکتور</span>
        </span>
      <% } %>

      <div class="toolbar-actions">
        <button class="tool-btn icon-only" type="button" id="shareBtn" title="اشتراک‌گذاری">
          <i class="bi bi-share"></i>
        </button>
        <button class="tool-btn icon-only" type="button" onclick="window.print()" title="چاپ فاکتور">
          <i class="bi bi-printer"></i>
        </button>
        <button class="tool-btn tool-btn-primary" type="button" id="dlBtn" title="دانلود تصویر">
          <i class="bi bi-download" id="dlIcon"></i><span id="dlText">تصویر</span>
        </button>
      </div>
    </div>

    <!-- Invoice sheet -->
    <div class="invoice-main">
      <%- include('partials/invoice-sheet', { sheet: sh }) %>
    </div>

    <!-- Print receipt (visible only on print) -->
    <div class="receipt" dir="rtl">
      <div class="rcpt-logo">
        <div class="rcpt-logo-mark">ف</div>
        <div class="rcpt-store"><%= sh.club %></div>
        <% if (sh.address || sh.phone) { %>
          <div class="rcpt-store-sub">رسید فروش</div>
        <% } %>
      </div>

      <% if (sh.address || sh.phone) { %>
      <div class="rcpt-store-info">
        <% if (sh.address) { %><div><%= sh.address %></div><% } %>
        <% if (sh.phone) { %><div style="direction:ltr">تلفن: <%= sh.phone %></div><% } %>
      </div>
      <% } %>

      <div class="rcpt-divider"></div>

      <div class="rcpt-row"><span class="lbl">شماره رسید</span><span class="val"><%= sh.number %></span></div>
      <div class="rcpt-row"><span class="lbl">تاریخ</span><span class="val"><%= dt.date %></span></div>
      <div class="rcpt-row"><span class="lbl">ساعت</span><span class="val"><%= dt.time %></span></div>
      <% if (sh.tracking) { %>
        <div class="rcpt-row"><span class="lbl">کد پیگیری</span><span class="val"><%= sh.tracking %></span></div>
      <% } %>

      <div class="rcpt-divider"></div>

      <div class="rcpt-row"><span class="lbl">مشتری</span><span class="val"><%= sh.member.name %></span></div>
      <% if (sh.member.code && sh.member.code !== '-') { %>
        <div class="rcpt-row"><span class="lbl">کد عضویت</span><span class="val"><%= sh.member.code %></span></div>
      <% } %>
      <% if (sh.member.phone && sh.member.phone !== '-') { %>
        <div class="rcpt-row"><span class="lbl">تلفن</span><span class="val" style="direction:ltr"><%= sh.member.phone %></span></div>
      <% } %>

      <div class="rcpt-divider"></div>

      <div class="rcpt-items-head">
        <span class="col-name">شرح</span>
        <span class="col-qty">تعداد</span>
        <span class="col-price">مبلغ (تومان)</span>
      </div>

      <% if (sh.plan) { %>
      <div class="rcpt-item">
        <span class="col-name"><%= sh.plan.name %><% if (sh.plan.period) { %> (<%= sh.plan.period %>)<% } %></span>
        <span class="col-qty">1</span>
        <span class="col-price"><%= money(sh.plan.price) %></span>
      </div>
      <% } %>

      <% if (sh.extras && sh.extras.length) { %>
        <% sh.extras.forEach(function (it) { %>
        <div class="rcpt-item">
          <span class="col-name"><%= it.name %></span>
          <span class="col-qty">1</span>
          <span class="col-price"><%= money(it.price) %></span>
        </div>
        <% }); %>
      <% } %>

      <div class="rcpt-divider"></div>

      <div class="rcpt-total-block">
        <% if (sh.plan) { %>
        <div class="rcpt-total-row">
          <span class="lbl">جمع اقلام</span>
          <span class="val"><%= money(sh.plan.price + (sh.extras || []).reduce(function(s,i){return s + i.price;}, 0)) %></span>
        </div>
        <% } %>

        <% if (sh.discounts && sh.discounts.length) { %>
          <% sh.discounts.forEach(function (d) { %>
          <div class="rcpt-total-row">
            <span class="lbl">تخفیف: <%= d.name %></span>
            <span class="val">- <%= money(Math.abs(d.price)) %></span>
          </div>
          <% }); %>
        <% } %>

        <div class="rcpt-total-row big">
          <span>مبلغ نهایی قابل پرداخت</span>
          <span class="val"><%= money(sh.total) %> ریال</span>
        </div>
      </div>

      <div class="rcpt-divider"></div>

      <div class="rcpt-status">
        <%= sh.isPaid ? '✓ پرداخت شده' + (sh.paidDate ? ' — ' + sh.paidDate : '') : '⏳ در انتظار پرداخت' %>
      </div>

      <% if (sh.note) { %>
        <div class="rcpt-row">
          <span class="lbl">یادداشت</span>
          <span class="val" style="text-align:left"><%= sh.note %></span>
        </div>
      <% } %>

      <% if (sh.qrSvg) { %>
        <div class="rcpt-qr">
          <%- sh.qrSvg %>
          <div class="rcpt-qr-label">اسکن کنید</div>
        </div>
      <% } %>

      <% if (sh.signature) { %>
        <div class="rcpt-sign">امضاء و مهر: <%= sh.signature.name || sh.club %></div>
      <% } %>

      <div class="rcpt-footer">
        <div class="thanks">از خرید شما سپاسگزاریم</div>
        <div class="msg">لطفاً رسید خود را تا پایان دوره نگهداری کنید</div>
        <div class="brand">صادر شده با فاکتوریتو</div>
      </div>
    </div>
  </main>

  <div id="toast"></div>

  <script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.js"></script>

  <script>
    (function () {
      /* Show a brief toast message */
      var toast = function (m) {
        var t = document.getElementById('toast');
        t.textContent = m;
        t.style.display = 'block';
        clearTimeout(t._t);
        t._t = setTimeout(function () { t.style.display = 'none'; }, 2600);
      };

      /* Inline SVG paths for icons that html-to-image needs to render as real SVG */
      var ICON_SVG_MAP = {
