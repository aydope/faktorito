                    <div>
                        <div class="skeleton h-4 w-24 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div>
                        <div class="skeleton h-4 w-24 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div>
                        <div class="skeleton h-4 w-24 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                </div>
            </div>
            <div class="card rounded-2xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="skeleton w-10 h-10 rounded-xl"></div>
                    <div class="skeleton h-6 w-24 rounded"></div>
                </div>
                <div class="skeleton h-12 rounded-xl"></div>
            </div>
            <div class="card rounded-2xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="skeleton w-10 h-10 rounded-xl"></div>
                    <div class="skeleton h-6 w-40 rounded"></div>
                </div>
                <div class="flex gap-2 items-end flex-wrap">
                    <div class="flex-1 min-w-[140px]">
                        <div class="skeleton h-4 w-20 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div class="w-32">
                        <div class="skeleton h-4 w-12 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div class="skeleton h-11 w-24 rounded-xl"></div>
                </div>
            </div>
            <div class="card rounded-2xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="skeleton w-10 h-10 rounded-xl"></div>
                    <div class="skeleton h-6 w-24 rounded"></div>
                </div>
                <div class="flex gap-2 items-end flex-wrap">
                    <div class="flex-1 min-w-[140px]">
                        <div class="skeleton h-4 w-20 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div class="w-32">
                        <div class="skeleton h-4 w-12 rounded mb-2"></div>
                        <div class="skeleton h-12 rounded-xl"></div>
                    </div>
                    <div class="skeleton h-11 w-24 rounded-xl"></div>
                </div>
            </div>
            <div class="card rounded-2xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="skeleton w-10 h-10 rounded-xl"></div>
                    <div class="skeleton h-6 w-32 rounded"></div>
                </div>
                <div class="skeleton h-24 rounded-xl"></div>
            </div>
            <div class="card rounded-2xl p-6 md:p-8">
                <div class="flex items-center gap-3 mb-6">
                    <div class="skeleton w-10 h-10 rounded-xl"></div>
                    <div class="skeleton h-6 w-24 rounded"></div>
                </div>
                <div class="space-y-2">
                    <div class="skeleton h-5 w-full rounded"></div>
                    <div class="skeleton h-5 w-full rounded"></div>
                    <div class="skeleton h-5 w-full rounded"></div>
                    <div class="skeleton h-8 w-full rounded"></div>
                </div>
            </div>
            <div class="skeleton h-14 rounded-2xl"></div>
        </div>

        <!-- Form Content (hidden initially) -->
        <div id="formContent" class="hidden space-y-5">
            <form id="invoiceForm" class="space-y-5">

                <!-- Member Info -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-accent-700/10 text-accent-400"><i class="bi bi-person-badge"></i></div>
                        <h2 class="text-lg font-extrabold text-white">اطلاعات عضو</h2>
                    </div>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 mb-1.5">نام و نام خانوادگی</label>
                            <input type="text" name="memberName" id="memberName" class="input-field" placeholder="علی محمدی" required>
                            <div class="input-error" id="memberNameError"></div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-400 mb-1.5">شماره تماس</label>
                            <input type="text" name="memberPhone" id="memberPhone" class="input-field input-left" placeholder="۰۹۱۲۳۴۵۶۷۸۹">
                            <div class="input-error" id="memberPhoneError"></div>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-semibold text-gray-400 mb-1.5">کد عضویت</label>
                            <div class="member-id-input-group">
                                <div class="member-id-input-box">
                                    <input type="text" name="memberId" id="memberId" class="input-field input-left" placeholder="کد یکتا" maxlength="12" readonly>
                                    <span class="member-id-prefix">ID</span>
                                </div>
                                <button type="button" onclick="generateMemberId()" class="btn-generate-id" id="generateBtn">
                                    <i class="bi bi-magic"></i>
                                    <span>تولید کد</span>
                                </button>
                            </div>
                            <div class="input-error" id="memberIdError"></div>
                        </div>
                    </div>
                </div>

                <!-- Plan Selection -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-purple-700/10 text-purple-400"><i class="bi bi-tag"></i></div>
                        <h2 class="text-lg font-extrabold text-white">پلن</h2>
                    </div>

                    <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
                    <div class="custom-select" id="planDropdown">
                        <div class="custom-select-trigger" onclick="togglePlanDropdown()" id="planTrigger">
                            <span id="planSelectedText" class="placeholder">انتخاب پلن...</span>
                            <i class="bi bi-chevron-down text-gray-500 text-sm transition-transform duration-200" id="dropdownArrow"></i>
                        </div>
                        <div class="input-error" id="planIdError"></div>
                        <div class="custom-options" id="planOptions">
                            <% plans.forEach(function(p) { %>
                            <div class="custom-option" data-value="<%= p._id %>" data-price="<%= p.price %>" data-name="<%= p.name %>" onclick="selectPlan(this)">
                                <div class="option-dot"></div>
                                <div class="option-info">
                                    <div class="option-name"><%= p.name %></div>
                                    <% if (p.description) { %><div class="option-desc"><%= p.description %></div><% } %>
                                </div>
                                <div class="option-price"><%= p.price.toLocaleString("fa-IR-u-nu-latn") %> <span class="toman">تومان</span></div>
                            </div>
                            <% }); %>
                        </div>
                    </div>
                    <% } else { %>
                    <div class="text-center py-10">
                        <div class="w-16 h-16 bg-accent-700/10 rounded-2xl flex items-center justify-center mx-auto mb-5 border border-accent-700/20">
                            <i class="bi bi-inbox text-3xl text-accent-400"></i>
                        </div>
                        <h3 class="text-base font-bold text-white mb-2">هیچ پلنی تعریف نشده</h3>
                        <p class="text-gray-500 text-sm mb-6">برای ایجاد فاکتور، ابتدا باید پلن تعریف کنید</p>
                        <a href="/plans" class="btn-primary inline-flex items-center gap-2 px-6 py-2.5 rounded-xl text-white font-semibold text-sm no-underline">
                            <i class="bi bi-plus-lg"></i> مدیریت پلن‌ها
                        </a>
                    </div>
                    <% } %>

                    <input type="hidden" name="planId" id="planId" required>
                </div>

                <!-- Additional Options -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-emerald-500/10 text-emerald-400"><i class="bi bi-plus-slash-minus"></i></div>
                        <div>
                            <h2 class="text-lg font-extrabold text-white">آپشن‌های اضافه</h2>
                            <p class="text-xs text-gray-500 mt-0.5">آیتم‌های اختیاری مثل بوفه، خدمات ویژه و...</p>
                        </div>
                    </div>

                    <div class="dynamic-section">
                        <div class="input-group-row">
                            <div class="input-group">
                                <label class="input-label">نام آپشن</label>
                                <input type="text" id="optionName" class="input-field" placeholder="مثلاً: بوفه، ماساژ، پارکینگ">
                            </div>
                            <div class="input-group small">
                                <label class="input-label">قیمت</label>
                                <div class="input-with-suffix">
                                    <input type="text" id="optionPrice" class="input-field" placeholder="۰" oninput="formatPrice(this)">
                                    <span class="input-suffix">تومان</span>
                                </div>
                            </div>
                            <button type="button" onclick="addOption()" class="add-btn add-btn-option">
                                <i class="bi bi-plus-lg"></i>
                                <span>افزودن</span>
                            </button>
                        </div>
                        <div class="chips-container" id="optionChips">
                            <span class="empty-state"><i class="bi bi-info-circle"></i> هنوز آپشنی اضافه نشده</span>
                        </div>
                    </div>
                </div>

                <!-- Discount -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-amber-500/10 text-amber-400"><i class="bi bi-percent"></i></div>
                        <h2 class="text-lg font-extrabold text-white">تخفیف</h2>
                    </div>

                    <div class="dynamic-section">
                        <div class="pill-group mb-4" id="pillGroup">
                            <button type="button" class="pill-btn active" data-dt="amount" onclick="setDiscType('amount', this)">تومان</button>
                            <button type="button" class="pill-btn" data-dt="percent" onclick="setDiscType('percent', this)">درصد</button>
                        </div>
                        <div class="input-group-row">
                            <div class="input-group">
                                <label class="input-label">توضیح تخفیف</label>
                                <input type="text" id="discDesc" class="input-field" placeholder="عنوان تخفیف">
                            </div>
                            <div class="input-group small">
                                <label class="input-label" id="discLabel">مبلغ</label>
                                <div class="input-with-suffix">
                                    <input type="text" id="discVal" class="input-field" placeholder="۰" oninput="formatPrice(this)">
                                    <span class="input-suffix" id="discSuffix">تومان</span>
                                </div>
                            </div>
                            <button type="button" onclick="addDisc()" class="add-btn add-btn-discount">
                                <i class="bi bi-plus-lg"></i>
                                <span>افزودن</span>
                            </button>
                        </div>
                        <div class="chips-container" id="discChips"></div>
                    </div>
                </div>

                <!-- Note -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-gray-700/10 text-gray-400"><i class="bi bi-pencil"></i></div>
                        <h2 class="text-lg font-extrabold text-white">یادداشت</h2>
                    </div>
                    <div>
                        <div class="flex justify-between items-center mb-1.5">
                            <label class="text-xs font-semibold text-gray-400">یادداشت</label>
                            <span class="counter" id="noteCounter">0 / 64</span>
                        </div>
                        <textarea name="note" id="note" rows="1" class="input-field auto-resize-textarea" placeholder="یادداشت روی فاکتور..." maxlength="64"></textarea>
                        <div class="input-error" id="noteError"></div>
                    </div>
                </div>

                <!-- Summary -->
                <div class="card rounded-2xl p-6 md:p-8">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="section-icon bg-accent-700/10 text-accent-400"><i class="bi bi-calculator"></i></div>
                        <h2 class="text-lg font-extrabold text-white">خلاصه فاکتور</h2>
                    </div>
                    <div class="space-y-2">
                        <div class="flex justify-between py-1 text-sm">
                            <span class="text-gray-400">پلن</span>
                            <span id="sPlan" class="font-bold text-white">—</span>
                        </div>
                        <div class="flex justify-between py-1 text-sm hidden" id="sOptionRow">
                            <span class="text-gray-400">آپشن‌های اضافه</span>
                            <span id="sOption" class="font-bold text-emerald-400">—</span>
                        </div>
                        <div class="flex justify-between py-1 text-sm hidden" id="sDiscRow">
                            <span class="text-red-400">تخفیف</span>
                            <span id="sDisc" class="font-bold text-red-400">—</span>
                        </div>
                        <div class="h-px bg-white/5 my-3"></div>
                        <div class="flex justify-between text-lg font-extrabold">
                            <span class="text-white">قابل پرداخت</span>
                            <span id="sTotal" class="text-accent-400">۰ تومان</span>
                        </div>
                    </div>
                </div>

                <div id="hiddenInputs"></div>

                <div id="globalError" class="input-error text-center text-red-400 hidden"></div>

                <button type="submit" class="btn-primary btn-submit w-full py-4 rounded-2xl text-white font-extrabold text-base flex items-center justify-center gap-2" id="submitBtn">
                    <i class="bi bi-check-lg text-lg"></i>
                    <span>صدور فاکتور</span>
                </button>
            </form>
        </div>
    </main>

    <!-- ========== LOGOUT MODAL ========== -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-dialog text-center">
            <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-box-arrow-right text-red-400 text-3xl"></i>
            </div>
            <h3 class="text-xl font-extrabold text-white mb-2">خروج از حساب</h3>
            <p class="text-gray-400 text-sm mb-8">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal('logoutModal')" class="px-6 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition">انصراف</button>
                <a href="/auth/logout" class="px-6 py-2.5 rounded-xl text-white font-semibold text-sm bg-red-600 hover:bg-red-500 transition shadow-lg shadow-red-900/30 no-underline">خروج</a>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="toast"></div>

    <script>
        // ====== Dropdown ======
        function toggleDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('dropdownMenu');
            const caret = document.getElementById('dropdownCaret');
            menu?.classList.toggle('active');
            if (caret) {
                const icon = caret.querySelector('i');
                if (icon) icon.style.transform = menu?.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }
        function closeDropdown() {
            const menu = document.getElementById('dropdownMenu');
            const caret = document.getElementById('dropdownCaret');
            if (menu) {
                menu.classList.remove('active');
                if (caret) {
                    const icon = caret.querySelector('i');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        }

        // ====== Mega Menu ======
        function toggleMegaMenu() {
            const menu = document.getElementById('megaMenu');
            const caret = document.getElementById('megaCaret');
            menu?.classList.toggle('active');
            if (caret) caret.style.transform = menu?.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0deg)';
        }
        function closeMegaMenu() {
            const menu = document.getElementById('megaMenu');
            const caret = document.getElementById('megaCaret');
            if (menu) {
                menu.classList.remove('active');
                if (caret) caret.style.transform = 'rotate(0deg)';
            }
        }

        // ====== Sidebar ======
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }
        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        // ====== Modals ======
        window.openModal = (id) => document.getElementById(id)?.classList.add('active');
        window.closeModal = (id) => document.getElementById(id)?.classList.remove('active');
        function openLogoutModal() {
            closeDropdown();
            closeMegaMenu();
            closeSidebar();
            openModal('logoutModal');
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('active');
            });
        });

        document.addEventListener('click', (e) => {
            const userDropdown = document.getElementById('userDropdown');
            if (userDropdown && !userDropdown.contains(e.target)) closeDropdown();

            const megaMenu = document.getElementById('megaMenu');
            const megaBtn = document.getElementById('megaMenuBtn');
            if (megaMenu && megaBtn && !megaMenu.contains(e.target) && !megaBtn.contains(e.target)) {
                closeMegaMenu();
            }

            const planDropdown = document.getElementById('planDropdown');
            if (planDropdown && !planDropdown.contains(e.target)) {
                planDropdown.classList.remove('active');
                document.getElementById('dropdownArrow').style.transform = 'rotate(0)';
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeDropdown();
                closeMegaMenu();
                closeSidebar();
                document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
            }
        });

        // ====== Toast ======
        function toast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.style.display = 'block';
            if (type === 'error') {
                t.style.background = 'rgba(127,29,29,0.95)';
                t.style.borderColor = 'rgba(239,68,68,0.4)';
                t.style.color = '#fca5a5';
            } else if (type === 'success') {
                t.style.background = 'rgba(6,78,59,0.95)';
                t.style.borderColor = 'rgba(16,185,129,0.4)';
                t.style.color = '#6ee7b7';
            } else {
                t.style.background = 'rgba(20,20,31,0.95)';
                t.style.borderColor = 'rgba(139,92,246,0.4)';
                t.style.color = '#fff';
            }
            clearTimeout(t._t);
            t._t = setTimeout(() => t.style.display = 'none', 3000);
        }

        // ====== Helpers ======
        function fmt(n) { return parseInt(n).toLocaleString("fa-IR-u-nu-latn"); }
        function unfmt(s) { return parseInt(s.replace(/,/g, '')) || 0; }
        function formatPrice(el) {
            let v = el.value.replace(/,/g, '');
            if (v === '' || isNaN(v)) { el.value = ''; return; }
            el.value = fmt(parseInt(v));
            refresh();
        }

        // ====== Generate Unique Member ID ======
        let memberIdCooldown = false;
        let memberIdTimer = null;

        function generateMemberId() {
            if (memberIdCooldown) return;

            const btn = document.getElementById('generateBtn');
            const input = document.getElementById('memberId');

            // تولید کد یکتا
            const timestamp = Date.now().toString(36).toUpperCase();
            const randomPart = Math.random().toString(36).substring(2, 6).toUpperCase();
            const userPart = '<%= (user && user._id) ? user._id.toString().slice(-4).toUpperCase() : "USER" %>';
            const uniqueId = `${userPart}${timestamp.slice(-4)}${randomPart}`;

            input.value = uniqueId;

            // فعال کردن cooldown
            memberIdCooldown = true;
            btn.disabled = true;

            let countdown = 30;
            const originalHTML = btn.innerHTML;
            btn.innerHTML = `<span>صبر کنید</span><span class="countdown">${countdown}</span>`;

            memberIdTimer = setInterval(() => {
                countdown--;
                const countdownEl = btn.querySelector('.countdown');
                if (countdownEl) {
                    countdownEl.textContent = countdown;
                }

                if (countdown <= 0) {
                    clearInterval(memberIdTimer);
                    memberIdCooldown = false;
                    btn.disabled = false;
                    btn.innerHTML = originalHTML;
                }
            }, 1000);

            toast('کد عضویت یکتا: ' + uniqueId, 'success');
        }

        // ====== Auto-resize textarea ======
        function autoResizeTextarea() {
            const textarea = document.getElementById('note');
            if (!textarea) return;

            textarea.style.height = 'auto';
            textarea.style.height = textarea.scrollHeight + 'px';

            // به‌روزرسانی شمارنده
            updateNoteCounter();
        }

        function updateNoteCounter() {
            const note = document.getElementById('note');
            const counter = document.getElementById('noteCounter');
            const maxLength = 64;
            const currentLength = note.value.length;
            counter.textContent = `${currentLength} / ${maxLength}`;
            const remaining = maxLength - currentLength;
            counter.classList.remove('warning', 'danger');
            if (remaining <= 0) counter.classList.add('danger');
            else if (remaining <= 10) counter.classList.add('warning');
        }

        // ====== Plan Dropdown ======
        function togglePlanDropdown() {
            const d = document.getElementById('planDropdown');
            const a = document.getElementById('dropdownArrow');
            if (!d) return;
            d.classList.toggle('active');
            a.style.transform = d.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0)';
        }

        function selectPlan(opt) {
            document.getElementById('planId').value = opt.dataset.value;
            document.getElementById('planSelectedText').innerHTML = `
                <div class="selected-text">
                    <span class="plan-name">${opt.dataset.name}</span>
                    <span class="plan-price">${fmt(opt.dataset.price)} تومان</span>
                </div>`;
            document.getElementById('planSelectedText').classList.remove('placeholder');
            document.querySelectorAll('.custom-option').forEach(o => o.classList.remove('selected'));
            opt.classList.add('selected');
            planPrice = parseInt(opt.dataset.price);
            const d = document.getElementById('planDropdown');
            if (d) {
                d.classList.remove('active');
                document.getElementById('dropdownArrow').style.transform = 'rotate(0)';
            }
            document.getElementById('planIdError').textContent = '';
            document.getElementById('planTrigger').classList.remove('error');
            refresh();
        }

        // ====== State ======
        let options = [], discs = [], discType = 'amount', planPrice = 0;

        function refresh() {
            const oT = options.reduce((s, o) => s + o.price, 0);
            const dT = discs.reduce((s, d) => s + (d.type === 'percent' ? Math.floor((planPrice + oT) * d.val / 100) : d.val), 0);
            const f = Math.max(0, planPrice + oT - dT);

            document.getElementById('sPlan').textContent = planPrice ? fmt(planPrice) + ' تومان' : '—';
            document.getElementById('sOptionRow').classList.toggle('hidden', oT === 0);
            document.getElementById('sOption').textContent = '+' + fmt(oT) + ' تومان';
            document.getElementById('sDiscRow').classList.toggle('hidden', dT === 0);
            document.getElementById('sDisc').textContent = '-' + fmt(dT) + ' تومان';
            document.getElementById('sTotal').textContent = fmt(f) + ' تومان';

            const h = document.getElementById('hiddenInputs');
            h.innerHTML = '';
            options.forEach((o, i) => {
                h.innerHTML += `<input type="hidden" name="cafeItems[${i}][name]" value="${o.name}"><input type="hidden" name="cafeItems[${i}][price]" value="${o.price}">`;
            });
            discs.forEach((d, i) => {
                h.innerHTML += `<input type="hidden" name="discounts[${i}][description]" value="${d.desc}"><input type="hidden" name="discounts[${i}][type]" value="${d.type}"><input type="hidden" name="discounts[${i}][value]" value="${d.val}">`;
            });
        }

        function setDiscType(t, btn) {
            discType = t;
            document.querySelectorAll('#pillGroup .pill-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('discLabel').textContent = t === 'percent' ? 'درصد' : 'مبلغ';
            document.getElementById('discSuffix').textContent = t === 'percent' ? '٪' : 'تومان';
            document.getElementById('discVal').placeholder = '۰';
            document.getElementById('discVal').value = '';
        }

        function addOption() {
            const n = document.getElementById('optionName').value.trim();
            const p = unfmt(document.getElementById('optionPrice').value);
            if (!n) { toast('نام آپشن را وارد کنید', 'error'); return; }
            if (!p || p <= 0) { toast('قیمت معتبر وارد کنید', 'error'); return; }
            options.push({ id: Date.now(), name: n, price: p });
            document.getElementById('optionName').value = '';
            document.getElementById('optionPrice').value = '';
            render();
        }

        function addDisc() {
            const d = document.getElementById('discDesc').value.trim();
            const v = unfmt(document.getElementById('discVal').value);
            if (!d) { toast('توضیح تخفیف را وارد کنید', 'error'); return; }
            if (!v || v <= 0) { toast(discType === 'percent' ? 'درصد معتبر وارد کنید' : 'مبلغ معتبر وارد کنید', 'error'); return; }
            if (discType === 'percent' && v > 100) { toast('حداکثر ۱۰۰٪', 'error'); return; }
            discs.push({ id: Date.now(), desc: d, val: v, type: discType });
            document.getElementById('discDesc').value = '';
            document.getElementById('discVal').value = '';
            render();
        }

        function render() {
            const optionChipsEl = document.getElementById('optionChips');
            if (options.length > 0) {
                optionChipsEl.innerHTML = options.map(o => `
                    <span class="chip option-chip">
                        <span>${o.name}</span>
                        <span class="font-bold">${fmt(o.price)}</span>
                        <span class="text-xs opacity-60">تومان</span>
                        <span class="chip-remove" onclick="removeOption(${o.id})"><i class="bi bi-x"></i></span>
                    </span>`).join('');
            } else {
                optionChipsEl.innerHTML = '<span class="empty-state"><i class="bi bi-info-circle"></i> هنوز آپشنی اضافه نشده</span>';
            }

            const discChipsEl = document.getElementById('discChips');
            if (discs.length > 0) {
                discChipsEl.innerHTML = discs.map(d => `
                    <span class="chip discount-chip">
                        <span>${d.desc}</span>
                        <span class="font-bold">${d.type === 'percent' ? d.val + '٪' : fmt(d.val)}</span>
                        ${d.type === 'amount' ? '<span class="text-xs opacity-60">تومان</span>' : ''}
                        <span class="chip-remove" onclick="removeDisc(${d.id})"><i class="bi bi-x"></i></span>
                    </span>`).join('');
            } else {
                discChipsEl.innerHTML = '';
            }
            refresh();
        }

        function removeOption(id) { options = options.filter(o => o.id !== id); render(); }
        function removeDisc(id) { discs = discs.filter(d => d.id !== id); render(); }

        // ====== Clear Errors ======
        function clearErrors() {
            document.querySelectorAll('.input-error').forEach(el => el.textContent = '');
            document.querySelectorAll('.input-field, .custom-select-trigger').forEach(el => el.classList.remove('error'));
            const ge = document.getElementById('globalError');
            ge.classList.add('hidden');
            ge.textContent = '';
        }

        // ====== Scroll to Error ======
        function scrollToError(fieldId) {
            const inputEl = document.getElementById(fieldId);
            const triggerEl = document.getElementById('planTrigger');
            if (inputEl) {
                const rect = inputEl.getBoundingClientRect();
                const absoluteTop = rect.top + window.pageYOffset;
                const scrollTo = absoluteTop - 120;
                window.scrollTo({ top: scrollTo, behavior: 'smooth' });
                setTimeout(() => inputEl.focus({ preventScroll: true }), 400);
            } else if (fieldId === 'planId' && triggerEl) {
                const rect = triggerEl.getBoundingClientRect();
                const absoluteTop = rect.top + window.pageYOffset;
                const scrollTo = absoluteTop - 120;
                window.scrollTo({ top: scrollTo, behavior: 'smooth' });
                setTimeout(() => triggerEl.focus({ preventScroll: true }), 400);
            }
        }

        // ====== Show Errors ======
        function showErrors(result) {
            clearErrors();
            let firstErrorField = null;
            if (result.validationErrors && typeof result.validationErrors === 'object') {
                const fieldMap = {
                    'memberName': 'memberName',
                    'memberPhone': 'memberPhone',
                    'memberId': 'memberId',
                    'planId': 'planId',
                    'note': 'note'
                };
                for (const [field, message] of Object.entries(result.validationErrors)) {
                    const fieldId = fieldMap[field] || field;
                    const errorEl = document.getElementById(`${fieldId}Error`);
                    const inputEl = document.getElementById(fieldId);
                    const triggerEl = document.getElementById('planTrigger');
                    if (errorEl) errorEl.textContent = message;
                    if (inputEl) inputEl.classList.add('error');
                    if (field === 'planId' && triggerEl) triggerEl.classList.add('error');
                    if (!firstErrorField) firstErrorField = fieldId;
                    toast(message, 'error');
                }
                if (firstErrorField) {
                    scrollToError(firstErrorField);
                }
                return;
            }
            if (result.errors && Array.isArray(result.errors)) {
                result.errors.forEach(err => toast(err, 'error'));
                const ge = document.getElementById('globalError');
                ge.textContent = result.errors.join(' • ');
                ge.classList.remove('hidden');
                scrollToError('memberName');
                return;
            }
            if (result.message) {
                const ge = document.getElementById('globalError');
                ge.textContent = result.message;
                ge.classList.remove('hidden');
                toast(result.message, 'error');
                scrollToError('memberName');
            }
        }

        // ====== Form Submit ======
        document.getElementById('invoiceForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();

            const planId = document.getElementById('planId').value;
            if (!planId) {
                document.getElementById('planIdError').textContent = 'لطفاً پلن را انتخاب کنید';
                document.getElementById('planTrigger').classList.add('error');
                toast('لطفاً پلن را انتخاب کنید', 'error');
                scrollToError('planId');
                return;
            }

            const btn = document.getElementById('submitBtn');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<span style="width:20px;height:20px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite;display:inline-block;"></span><span>در حال صدور...</span>';
            btn.disabled = true;

            try {
                const cafeItems = options.map(o => ({
                    name: o.name,
                    price: o.price
                }));

                const discounts = discs.map(d => ({
                    description: d.desc,
                    type: d.type,
                    value: d.val
                }));

                const data = {
                    memberName: document.getElementById('memberName').value,
                    memberPhone: document.getElementById('memberPhone').value || '',
                    memberId: document.getElementById('memberId').value || '',
                    planId: planId,
                    cafeItems: cafeItems,
                    discounts: discounts,
                    note: document.getElementById('note').value || ''
                };

                console.log('Sending data:', data);

                const res = await fetch('/invoices', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await res.json();

                if (result.success) {
                    toast(result.message, 'success');
                    setTimeout(() => window.location.href = result.redirect || '/invoices', 500);
                } else {
                    showErrors(result);
                }
            } catch (err) {
                toast('خطا در ارتباط با سرور', 'error');
                console.error(err);
            }

            btn.innerHTML = originalHTML;
            btn.disabled = false;
        });

        // ====== Init ======
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                document.getElementById('skeletonLoader').classList.add('hidden');
                document.getElementById('formContent').classList.remove('hidden');
                refresh();
                render();
                updateNoteCounter();
                autoResizeTextarea();
            }, 800);

            const note = document.getElementById('note');
            if (note) {
                note.addEventListener('input', autoResizeTextarea);
            }
        });
    </script>
</body>
</html>