        </div>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="max-w-4xl mx-auto px-4 pt-28 pb-16 relative z-10">

        <div class="mb-8">
            <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight mb-1">ایجاد فاکتور جدید</h1>
