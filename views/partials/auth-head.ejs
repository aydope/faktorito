<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= title %> | فاکتوریتو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        ink: {
                            950: '#050508', 900: '#0c0c14', 800: '#14141f', 700: '#1c1c2a',
                            600: '#28283a', 500: '#36364c', 400: '#4a4a63',
                        },
                        accent: {
                            400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9', 800: '#5b21b6', 900: '#4c1d95',
                        },
                        gold: {
                            400: '#fbbf24', 500: '#f59e0b', 600: '#d97706', 700: '#b45309',
                        },
                        success: {
                            300: '#6ee7b7', 400: '#34d399', 500: '#10b981', 600: '#059669',
                        },
                    },
                    boxShadow: {
                        'glow': '0 0 32px rgba(124, 58, 237, 0.35)',
                        'glow-lg': '0 8px 40px rgba(124, 58, 237, 0.45)',
                        'card': '0 10px 40px -10px rgba(0, 0, 0, 0.4)',
                    },
                    borderRadius: {
                        'xl': '12px', '2xl': '16px', '3xl': '24px',
                    },
                    keyframes: {
                        shimmer: {
                            '0%': { backgroundPosition: '200% 0' },
                            '100%': { backgroundPosition: '-200% 0' },
                        },
                        toastIn: {
                            '0%': { opacity: '0', transform: 'translateX(-50%) translateY(8px)' },
                            '100%': { opacity: '1', transform: 'translateX(-50%) translateY(0)' },
                        },
                        spin: {
                            '0%': { transform: 'rotate(0deg)' },
                            '100%': { transform: 'rotate(360deg)' },
                        },
                    },
                    animation: {
                        shimmer: 'shimmer 1.8s infinite',
                        toastIn: 'toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1)',
                        spin: 'spin 0.6s linear infinite',
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            overflow-y: auto;
            min-height: 100vh;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #050508; }
        ::-webkit-scrollbar-thumb { background: #1c1c2a; border-radius: 10px; }

        .grid-bg {
            background-image:
                linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(20,20,31,0.95);
            color: #fff;
            padding: 12px 24px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 600;
            z-index: 500;
            box-shadow: 0 20px 40px rgba(0,0,0,0.5);
            border: 1px solid rgba(139,92,246,0.3);
            display: none;
            animation: toastIn 0.3s ease;
        }

        @keyframes toastIn {
            from { opacity: 0; transform: translateX(-50%) translateY(8px); }
            to   { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        .loader-spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.2);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            display: inline-block;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .login-card {
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 20px;
            padding: 32px 28px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #7c3aed, #a78bfa, #7c3aed, transparent);
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: #7c3aed;
            box-shadow: 0 8px 30px -8px rgba(124, 58, 237, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.3);
        }

        .btn-primary:hover {
            background: #8b5cf6;
            box-shadow: 0 12px 40px -8px rgba(139, 92, 246, 0.5);
            transform: translateY(-2px);
        }

        .btn-primary:active { transform: scale(0.97); }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .float-group {
            position: relative;
            margin-bottom: 22px;
        }

        .float-group .float-input {
            width: 100%;
            padding: 20px 42px 8px 14px;
            background: #0f0f1a;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            transition: all 0.3s ease;
            outline: none;
            height: 54px;
        }

        .float-group .float-input:focus {
            border-color: rgba(139,92,246,0.5);
            box-shadow: 0 0 0 3px rgba(139,92,246,0.08);
        }

        .float-group .float-input.error    { border-color: rgba(239,68,68,0.4); }
        .float-group .float-input.valid    { border-color: rgba(16,185,129,0.4); }
        .float-group .float-input.validating { border-color: rgba(245,158,11,0.4); }
        .float-group .float-input::placeholder { color: transparent; }

        .float-group .float-label {
            position: absolute;
            right: 42px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            color: #6b7280;
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .float-group .float-input:focus ~ .float-label,
        .float-group .float-input:not(:placeholder-shown) ~ .float-label {
            top: 12px;
            font-size: 10px;
            color: #a78bfa;
            font-weight: 700;
        }

        .float-group .float-icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 15px;
            pointer-events: none;
            transition: color 0.3s ease;
        }

        .float-group .float-input:focus ~ .float-icon {
            color: #a78bfa;
        }

        .float-group .toggle-pass {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            cursor: pointer;
            font-size: 15px;
            background: none;
            border: none;
            padding: 4px;
            transition: color 0.3s ease;
        }

        .float-group .toggle-pass:hover { color: #a78bfa; }

        .float-group .float-feedback {
            font-size: 11px;
            margin-top: 5px;
            margin-right: 4px;
            font-weight: 500;
            display: none;
            align-items: center;
            gap: 5px;
        }

        .float-group .float-feedback.show {
            display: flex;
            animation: fadeIn 0.3s ease;
        }

        .float-group .float-feedback.error       { color: #fca5a5; }
        .float-group .float-feedback.success     { color: #6ee7b7; }
        .float-group .float-feedback.validating  { color: #fcd34d; }

        .error-box {
            background: rgba(239,68,68,0.06);
            border: 1px solid rgba(239,68,68,0.2);
            border-radius: 12px;
            padding: 12px 16px;
            margin-bottom: 18px;
            color: #fca5a5;
            font-size: 13px;
            font-weight: 500;
            display: none;
        }

        .error-box.show {
            display: block;
            animation: fadeIn 0.3s ease;
        }

        .error-box p {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 3px;
        }

        .error-box p:last-child { margin-bottom: 0; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .code-input {
            letter-spacing: 0.6em;
            text-align: center;
            font-size: 26px;
            font-weight: 800;
            direction: ltr;
            height: 64px !important;
            padding: 8px 14px !important;
        }

        .aud-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            background: #0f0f1a;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 14px;
            padding: 5px;
            margin-bottom: 22px;
        }

        .aud-tabs a {
            text-align: center;
            padding: 9px 6px;
            border-radius: 10px;
            font-size: 12.5px;
            font-weight: 700;
            color: #9ca3af;
            text-decoration: none;
            transition: all .25s;
        }

        .aud-tabs a.on {
            background: linear-gradient(135deg,#6d28d9,#8b5cf6);
            color: #fff;
            box-shadow: 0 6px 20px -8px rgba(124,58,237,.6);
        }

        .link-btn {
            background: none;
            border: none;
            color: #a78bfa;
            font-weight: 700;
            font-size: 12px;
            cursor: pointer;
        }

        .link-btn:disabled {
            color: #6b7280;
            cursor: not-allowed;
        }
    </style>
</head>

<body class="antialiased bg-[#050508] grid-bg">