<%
  const code = Number(statusCode) || 500;

  const KINDS = {
    400: {
      icon: 'bi-exclamation-diamond',
      title: 'درخواست نامعتبر',
      hint: 'اطلاعات ارسالی درست نبود. صفحه را بازبینی کنید و دوباره امتحان کنید.',
      tone: 'amber',
    },
    401: {
      icon: 'bi-person-lock',
      title: 'ابتدا وارد شوید',
      hint: 'برای دیدن این بخش باید وارد حساب خود شوید.',
      tone: 'violet',
    },
    403: {
      icon: 'bi-shield-lock',
      title: 'دسترسی ندارید',
      hint: 'حساب شما اجازه‌ی دیدن این بخش را ندارد.',
      tone: 'rose',
    },
    404: {
      icon: 'bi-compass',
      title: 'اینجا چیزی پیدا نشد',
      hint: 'ممکن است لینک اشتباه باشد یا صفحه جابه‌جا شده باشد.',
      tone: 'violet',
    },
    409: {
      icon: 'bi-intersect',
      title: 'تداخل در اطلاعات',
      hint: 'این مورد از قبل وجود دارد یا همزمان تغییر کرده است.',
      tone: 'amber',
    },
    413: {
      icon: 'bi-box-seam',
      title: 'حجم داده زیاد است',
      hint: 'اطلاعات ارسالی بیشتر از حد مجاز بود.',
      tone: 'amber',
    },
    429: {
      icon: 'bi-speedometer',
      title: 'کمی آهسته‌تر',
      hint: 'درخواست‌های زیادی فرستادید. چند لحظه صبر کنید.',
      tone: 'amber',
    },
  };

  const kind =
    KINDS[code] ||
    (code >= 500
      ? {
          icon: 'bi-cone-striped',
          title: 'مشکلی از سمت ما پیش آمد',
          hint: 'این خطا ثبت شد و بررسی می‌شود. کمی بعد دوباره تلاش کنید.',
          tone: 'rose',
        }
      : {
          icon: 'bi-exclamation-circle',
          title: 'خطا',
          hint: '',
          tone: 'violet',
        });

  const TONES = {
    violet: ['#8b5cf6', '#6d28d9'],
    amber: ['#fbbf24', '#d97706'],
    rose: ['#fb7185', '#e11d48'],
  };

  const [c1, c2] = TONES[kind.tone];
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <title><%= code %>، <%= kind.title %> | فاکتوریتو</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

  <style>
    :root {
      --c1: <%= c1 %>;
      --c2: <%= c2 %>;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif;
    }

    html {
      min-height: 100%;
      overflow-x: clip;
      -webkit-text-size-adjust: 100%;
    }

    /* centred when there is room, scrolls normally when there is not
       (small phones, landscape, long messages) */
    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: clip;
      line-height: 1.9;
      color: #d1d5db;
      background-color: #050508;
      padding:
        max(clamp(12px, 4vw, 24px), env(safe-area-inset-top))
        max(clamp(12px, 4vw, 24px), env(safe-area-inset-right))
        max(clamp(12px, 4vw, 24px), env(safe-area-inset-bottom))
        max(clamp(12px, 4vw, 24px), env(safe-area-inset-left));
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
      background-size: 60px 60px;
    }

    .orb {
      position: fixed;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.35;
      pointer-events: none;
      animation: float 14s ease-in-out infinite;
    }

    .orb.a {
      width: min(340px, 70vw);
      height: min(340px, 70vw);
      background: var(--c2);
      top: -90px;
      right: -70px;
    }

    .orb.b {
      width: min(280px, 60vw);
      height: min(280px, 60vw);
      background: var(--c1);
      bottom: -100px;
      left: -60px;
      animation-delay: -6s;
      opacity: 0.22;
    }

    @keyframes float {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      50% {
        transform: translate(24px, -30px) scale(1.08);
      }
    }

    .card {
      position: relative;
      z-index: 1;
      width: min(520px, 100%);
      margin: auto;
      text-align: center;
      padding:
        clamp(28px, 8vw, 44px)
        clamp(18px, 6vw, 34px)
        clamp(24px, 6vw, 34px);
      border-radius: clamp(20px, 6vw, 28px);
      overflow-wrap: anywhere;
      background: linear-gradient(180deg, rgba(20, 20, 31, 0.88), rgba(12, 12, 20, 0.92));
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow:
        0 40px 90px -30px rgba(0, 0, 0, 0.8),
        inset 0 1px 0 rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(18px);
      animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 2px;
      border-radius: 28px 28px 0 0;
      background: linear-gradient(90deg, transparent, var(--c2), var(--c1), var(--c2), transparent);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(18px) scale(0.98);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    .badge {
      width: clamp(58px, 16vw, 74px);
      height: clamp(58px, 16vw, 74px);
      margin: 0 auto 16px;
      border-radius: 22px;
      display: grid;
      place-items: center;
      font-size: clamp(26px, 8vw, 34px);
      color: #fff;
      background: linear-gradient(135deg, var(--c2), var(--c1));
      box-shadow: 0 14px 40px -10px var(--c2);
      animation: bob 4s ease-in-out infinite;
    }

    @keyframes bob {
      0%,
      100% {
        transform: translateY(0) rotate(-2deg);
      }

      50% {
        transform: translateY(-6px) rotate(2deg);
      }
    }

    .code {
      font-size: clamp(64px, 18vw, 96px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -2px;
      direction: ltr;
      background: linear-gradient(135deg, #fff 10%, var(--c1) 55%, var(--c2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    h1 {
      font-size: clamp(17px, 5vw, 20px);
      font-weight: 800;
      color: #fff;
      margin: 8px 0 6px;
    }

    .msg {
      font-size: 13.5px;
      color: #9ca3af;
    }

    .hint {
      font-size: 12px;
      color: #6b7280;
      margin-top: 6px;
    }

    .actions {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 26px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 14px;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn.primary {
      color: #fff;
      background: linear-gradient(135deg, var(--c2), var(--c1));
      box-shadow: 0 10px 30px -10px var(--c2);
    }

    .btn.primary:hover {
      transform: translateY(-2px);
    }

    .btn.ghost {
      color: #d1d5db;
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(255, 255, 255, 0.08);
    }

    .btn.ghost:hover {
      background: rgba(255, 255, 255, 0.08);
    }

    .ref {
      margin-top: 22px;
      max-width: 100%;
      display: inline-flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 7px 14px;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px dashed rgba(255, 255, 255, 0.12);
      font-size: 11.5px;
      color: #9ca3af;
      cursor: pointer;
    }

    .ref b {
      color: #fff;
      letter-spacing: 1px;
      direction: ltr;
      font-family: ui-monospace, monospace;
    }

    .retry {
      margin-top: 14px;
      font-size: 12px;
      color: #fcd34d;
    }

    @media (max-width: 480px) {
      .actions {
        flex-direction: column;
        align-items: stretch;
        margin-top: 22px;
      }

      .btn {
        justify-content: center;
        width: 100%;
        padding: 13px 18px;
        min-height: 46px;
      }

      .msg {
        font-size: 13px;
      }
    }

    @media (max-height: 520px) {
      .badge {
        display: none;
      }

      .card {
        padding-top: 22px;
      }

      .code {
        font-size: 54px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation: none !important;
      }
    }
  </style>
</head>
<body>
  <div class="orb a"></div>
  <div class="orb b"></div>

  <main class="card">
    <div class="badge"><i class="bi <%= kind.icon %>"></i></div>
    <div class="code"><%= code %></div>
    <h1><%= kind.title %></h1>
    <p class="msg" role="alert"><%= message %></p>
    <% if (kind.hint) { %>
    <p class="hint"><%= kind.hint %></p>
    <% } %>

    <% if (retryAfter) { %>
    <p class="retry">
      <i class="bi bi-hourglass-split"></i>
      تلاش مجدد تا <b id="count"><%= retryAfter %></b> ثانیه دیگر
    </p>
    <% } %>

    <div class="actions">
      <a class="btn primary" href="<%= homeHref %>">
        <i class="bi bi-house"></i>
        <%= isLoggedIn ? 'بازگشت به پنل' : 'صفحه اصلی' %>
      </a>

      <% if (code === 401 || (!isLoggedIn && code === 403)) { %>
      <a class="btn ghost" href="/auth/login">
        <i class="bi bi-box-arrow-in-right"></i> ورود
      </a>
      <% } else { %>
      <button
        class="btn ghost"
        type="button"
        onclick="history.length > 1 ? history.back() : location.assign('<%= homeHref %>')"
      >
        <i class="bi bi-arrow-right"></i> صفحه قبل
      </button>
      <% } %>

      <% if (code >= 500) { %>
      <button class="btn ghost" type="button" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> تلاش دوباره
      </button>
      <% } %>
    </div>

    <% if (errorId) { %>
    <div
      class="ref"
      id="ref"
      role="button"
      tabindex="0"
      title="کپی کد پیگیری"
      aria-label="کپی کد پیگیری"
    >
      <i class="bi bi-clipboard"></i>
      کد پیگیری: <b id="refId"><%= errorId %></b>
    </div>
    <% } %>
  </main>

  <script>
    (function () {
      var c = document.getElementById('count');
      if (c) {
        var n = parseInt(c.textContent, 10) || 0;
        var t = setInterval(function () {
          n--;
          c.textContent = Math.max(n, 0);
          if (n <= 0) {
            clearInterval(t);
            location.reload();
          }
        }, 1000);
      }

      var ref = document.getElementById('ref');
      if (ref) {
        var copy = function () {
          var id = document.getElementById('refId').textContent;
          (navigator.clipboard ? navigator.clipboard.writeText(id) : Promise.reject())
            .then(function () {
              ref.querySelector('i').className = 'bi bi-check2';
            })
            .catch(function () {});
        };
        ref.addEventListener('click', copy);
        ref.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') copy();
        });
      }
    })();
  </script>
</body>
</html>