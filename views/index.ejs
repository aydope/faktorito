                    <% } else { %>
                        <a href="/auth/register" class="btn-primary inline-flex items-center gap-2 px-10 py-4 rounded-2xl text-white font-bold text-base">
                            ثبت‌نام رایگان <i class="bi bi-arrow-left"></i>
                        </a>
                    <% } %>
                </div>
            </div>
        </section>
