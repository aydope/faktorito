<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>فاکتوریتو | فاکتور هوشمند و حرفه‌ای</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        'ink': {
                            950: '#050508', 900: '#0c0c14', 800: '#14141f', 700: '#1c1c2a',
                            600: '#28283a', 500: '#36364c', 400: '#4a4a63',
                        },
                        'accent': {
                            400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9',
                        }
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            letter-spacing: -0.1px;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #050508;
        }

        ::-webkit-scrollbar-thumb {
            background: #1c1c2a;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #28283a;
        }

        .glass-nav {
            background: rgba(12, 12, 20, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.4);
        }

        .grid-bg {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #c4b5fd 0%, #a78bfa 30%, #8b5cf6 60%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 30px rgba(139, 92, 246, 0.3));
        }

        .feature-card {
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.03);
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), transparent 40%, transparent 60%, rgba(139, 92, 246, 0.1));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            background: #10101a;
            border-color: rgba(139, 92, 246, 0.15);
        }

        .feature-icon {
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.1);
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: #7c3aed;
            box-shadow: 0 8px 30px -8px rgba(124, 58, 237, 0.4);
        }

        .btn-primary:hover {
            background: #8b5cf6;
            box-shadow: 0 12px 40px -8px rgba(139, 92, 246, 0.5);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .btn-secondary {
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.4);
        }

        .dropdown-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 16px 4px 6px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #d1d5db;
            font-weight: 500;
            font-size: 14px;
        }

        .dropdown-trigger:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(139, 92, 246, 0.4);
        }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            flex-shrink: 0;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            min-width: 250px;
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px;
            box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 100;
        }

        .dropdown-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
        }

        .dropdown-item:hover {
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
        }

        .dropdown-item i {
            font-size: 17px;
            width: 20px;
            text-align: center;
        }

        .dropdown-item.danger:hover {
            background: rgba(220, 38, 38, 0.12);
            color: #f87171;
        }

        .dropdown-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.05);
            margin: 6px 8px;
        }

        .dropdown-trigger .chevron-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s ease;
            font-size: 10px;
            color: #6b7280;
            width: 16px;
            height: 16px;
            line-height: 1;
        }

        .stat-item {
            position: relative;
        }

        .stat-item:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 1px;
            background: rgba(255, 255, 255, 0.05);
        }

        @media (max-width: 640px) {
            .stat-item:not(:last-child)::after {
                display: none;
            }
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-dialog {
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 32px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
            transform: scale(0.92) translateY(16px);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .modal-overlay.active .modal-dialog {
            transform: scale(1) translateY(0);
        }

        .modal-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 24px;
        }

        .modal-icon.about {
            background: rgba(139, 92, 246, 0.12);
            color: #a78bfa;
        }

        .modal-icon.contact {
            background: rgba(52, 211, 153, 0.12);
            color: #34d399;
        }

        .modal-icon.privacy {
            background: rgba(251, 191, 36, 0.12);
            color: #fbbf24;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            margin-bottom: 6px;
        }

        .modal-subtitle {
            font-size: 14px;
            color: #9ca3af;
            text-align: center;
            margin-bottom: 20px;
        }

        .modal-body {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
        }

        .modal-body p {
            color: #d1d5db;
            font-size: 14px;
            line-height: 1.8;
        }

        .modal-close-btn {
            width: 100%;
            padding: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #9ca3af;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .modal-close-btn:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .github-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 20px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #d1d5db;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.3s ease;
            text-decoration: none;
            width: 100%;
        }

        .github-btn:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-2px);
        }

        .github-btn i {
            font-size: 24px;
            color: #a78bfa;
        }

        .github-btn span {
            color: #fff;
        }

        .github-btn .external-icon {
            font-size: 12px;
            color: #6b7280;
        }

        .privacy-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .privacy-list li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 6px 0;
            color: #d1d5db;
            font-size: 14px;
        }

        .privacy-list li i {
            color: #34d399;
            font-size: 14px;
            margin-top: 3px;
        }

        .logout-btn-danger {
            background: #dc2626;
            transition: all 0.3s ease;
        }

        .logout-btn-danger:hover {
            background: #ef4444;
        }

        .logout-btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .logout-btn-cancel:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .invoice-card {
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 20px;
            padding: 0;
            position: relative;
            overflow: hidden;
            box-shadow: 0 20px 60px -20px rgba(0, 0, 0, 0.5);
            max-width: 520px;
            margin: 0 auto;
            transition: all 0.4s ease;
        }

        .invoice-card:hover {
            border-color: rgba(139, 92, 246, 0.2);
            box-shadow: 0 25px 70px -20px rgba(139, 92, 246, 0.15);
            transform: translateY(-4px);
        }

        .invoice-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #7c3aed, #a78bfa, #7c3aed, transparent);
            background-size: 200% 100%;
            animation: shimmerBorder 3s linear infinite;
        }

        @keyframes shimmerBorder {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        .invoice-header {
            padding: 20px 24px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.05), rgba(124, 58, 237, 0.02));
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 900;
            color: #fff;
            box-shadow: 0 8px 20px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
        }

        .brand-name {
            font-size: 16px;
            font-weight: 800;
            color: #fff;
        }

        .brand-meta {
            font-size: 10px;
            color: #6b7280;
            margin-top: 2px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .brand-meta i {
            font-size: 11px;
            color: #a78bfa;
        }

        .tracking-label {
            font-size: 8px;
            color: #6b7280;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .tracking-code {
            font-family: 'Courier New', monospace;
            font-size: 16px;
            font-weight: 900;
            color: #a78bfa;
            letter-spacing: 2px;
        }

        .invoice-body {
            padding: 20px 24px;
        }

        .status-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 50px;
            font-size: 10px;
            font-weight: 700;
        }

        .status-paid {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.2);
            color: #34d399;
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.08);
            border: 1px solid rgba(245, 158, 11, 0.2);
            color: #fbbf24;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        .invoice-number-badge {
            font-size: 11px;
            color: #6b7280;
        }

        .invoice-number-badge strong {
            color: #a78bfa;
            font-size: 13px;
        }

        .member-section {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            position: relative;
            overflow: hidden;
        }

        .member-section::before {
            content: '';
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient(180deg, #7c3aed, #a78bfa);
        }

        .member-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .member-avatar {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(124, 58, 237, 0.1));
            border: 1px solid rgba(139, 92, 246, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 800;
            color: #a78bfa;
            flex-shrink: 0;
        }

        .member-info .member-name {
            font-size: 14px;
            font-weight: 800;
            color: #fff;
        }

        .member-info .member-details {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 2px;
        }

        .member-info .member-detail {
            font-size: 10px;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .member-info .member-detail i {
            font-size: 11px;
            color: #a78bfa;
        }

        .member-right {
            text-align: left;
        }

        .member-right .member-label {
            font-size: 8px;
            color: #6b7280;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .member-right .member-id {
            font-size: 12px;
            font-weight: 700;
            color: #a78bfa;
            font-family: 'Courier New', monospace;
            letter-spacing: 1px;
        }

        .plan-box {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.06), rgba(124, 58, 237, 0.02));
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 14px;
            position: relative;
            overflow: hidden;
        }

        .plan-box::after {
            content: '';
            position: absolute;
            left: -20px;
            top: -20px;
            width: 70px;
            height: 70px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.1), transparent);
            border-radius: 50%;
        }

        .plan-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .plan-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .plan-icon {
            width: 32px;
            height: 32px;
            background: rgba(139, 92, 246, 0.15);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: #a78bfa;
        }

        .plan-info .plan-label {
            font-size: 8px;
            color: #6b7280;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .plan-info .plan-name {
            font-size: 13px;
            font-weight: 800;
            color: #a78bfa;
        }

        .plan-price {
            font-size: 16px;
            font-weight: 900;
            color: #fff;
        }

        .plan-price small {
            font-size: 10px;
            color: #6b7280;
            font-weight: 400;
        }

        .items-section {
            margin-bottom: 14px;
        }

        .items-title {
            font-size: 9px;
            font-weight: 700;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .items-title i {
            font-size: 12px;
            color: #a78bfa;
        }

        .items-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .items-column {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .items-column-title {
            font-size: 8px;
            font-weight: 700;
            color: #6b7280;
            margin-bottom: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
            letter-spacing: 0.3px;
        }

        .items-column-title i {
            font-size: 10px;
        }

        .cafe-column .items-column-title {
            color: #34d399;
        }

        .discount-column .items-column-title {
            color: #f87171;
        }

        .item-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 8px;
            padding: 6px 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .item-name {
            color: #9ca3af;
            font-size: 10px;
        }

        .item-price {
            font-weight: 700;
            font-size: 10px;
        }

        .cafe-column .item-price {
            color: #34d399;
        }

        .discount-column .item-price {
            color: #f87171;
        }

        .note-box {
            background: rgba(245, 158, 11, 0.04);
            border: 1px dashed rgba(245, 158, 11, 0.15);
            border-radius: 8px;
            padding: 8px 12px;
            color: #fcd34d;
            font-size: 10px;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 14px;
        }

        .invoice-footer {
            padding: 14px 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(0, 0, 0, 0.2);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .footer-date {
            font-size: 10px;
            color: #6b7280;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .footer-date i {
            color: #a78bfa;
        }

        .total-label {
            font-size: 9px;
            color: #6b7280;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .total-amount {
            font-size: 20px;
            font-weight: 900;
            color: #a78bfa;
        }

        .total-amount small {
            font-size: 11px;
            color: #6b7280;
            font-weight: 400;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 16px;
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.15);
            border-radius: 50px;
            font-size: 12px;
            color: #a78bfa;
            font-weight: 600;
            letter-spacing: 0.3px;
            animation: pulseGlow 2s infinite;
        }

        .hero-badge i {
            font-size: 14px;
        }

        @keyframes pulseGlow {

            0%,
            100% {
                box-shadow: 0 0 20px rgba(139, 92, 246, 0.05);
            }

            50% {
                box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
            }
        }

        .floating-icon {
            position: absolute;
            opacity: 0.06;
            font-size: 80px;
            color: #a78bfa;
            pointer-events: none;
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(5deg);
            }
        }

        .floating-icon-2 {
            position: absolute;
            opacity: 0.04;
            font-size: 120px;
            color: #7c3aed;
            pointer-events: none;
            animation: floatReverse 8s ease-in-out infinite;
        }

        @keyframes floatReverse {

            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(20px) rotate(-5deg);
            }
        }

        .counter-number {
            font-size: 2.25rem;
            font-weight: 900;
            color: #a78bfa;
            font-feature-settings: "tnum";
        }

        @media (min-width: 768px) {
            .counter-number {
                font-size: 2.5rem;
            }
        }

        .scroll-reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .scroll-reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .scroll-reveal-scale {
            opacity: 0;
            transform: scale(0.9);
            transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .scroll-reveal-scale.visible {
            opacity: 1;
            transform: scale(1);
        }

        @media (max-width: 640px) {
            .invoice-header {
                padding: 16px;
            }

            .invoice-body {
                padding: 16px;
            }

            .invoice-footer {
                padding: 12px 16px;
            }

            .items-grid {
                grid-template-columns: 1fr !important;
            }

            .member-section {
                flex-direction: column;
                align-items: flex-start;
            }

            .member-right {
                text-align: right;
                width: 100%;
            }

            .plan-content {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
</head>

