                    </div>
                    <div class="stat-item px-6 md:px-10 py-4 text-center scroll-reveal" style="transition-delay: 0.35s;">
                        <div class="counter-number text-2xl md:text-3xl font-black text-accent-400" data-target="8500" data-suffix="+">0</div>
                        <div class="text-xs text-gray-500 mt-1">فاکتور صادر شده</div>
                    </div>
                    <div class="px-6 md:px-10 py-4 text-center scroll-reveal" style="transition-delay: 0.4s;">
                        <div class="counter-number text-2xl md:text-3xl font-black text-accent-400" data-target="99" data-suffix="%">0</div>
                        <div class="text-xs text-gray-500 mt-1">رضایت کاربران</div>
                    </div>
                </div>
            </div>
        </section>

        <section id="features" class="py-16 md:py-28 px-4 max-w-6xl mx-auto">
