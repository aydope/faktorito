                    </div>
                <% } else { %>
                    <a href="/auth/login" class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-lg font-semibold text-gray-400 hover:text-white hover:bg-white/5 transition-all text-sm">
