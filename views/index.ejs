                <a href="https://github.com/aydope/faktorito" target="_blank" rel="noopener noreferrer" class="om-contact-card">
                    <span class="cc-icon"><i class="bi bi-github"></i></span>
                    <span class="cc-text">
                        <div class="cc-label">مخزن رسمی پروژه</div>
                        <div class="cc-value">github.com/aydope/faktorito</div>
