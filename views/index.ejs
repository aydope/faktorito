<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>فاکتوریتو | فاکتور هوشمند و حرفه‌ای</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        'ink': {
                            950: '#050508',
                            900: '#0c0c14',
                            800: '#14141f',
                            700: '#1c1c2a',
                            600: '#28283a',
                            500: '#36364c',
                            400: '#4a4a63',
                        },
                        'accent': {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            letter-spacing: -0.1px;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #050508;
        }

        ::-webkit-scrollbar-thumb {
            background: #1c1c2a;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #28283a;
        }

        /* ===== Global input reset ===== */
        input,
        textarea,
        select {
            outline: none !important;
            box-shadow: none;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none !important;
        }

        input:focus-visible,
        textarea:focus-visible,
        select:focus-visible {
            outline: none !important;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
        }

        .glass-nav {
            background: rgba(12, 12, 20, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.04);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.4);
        }

        .grid-bg {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #c4b5fd 0%, #a78bfa 30%, #8b5cf6 60%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 0 30px rgba(139, 92, 246, 0.3));
        }

        .feature-card {
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.03);
            transition: all 0.6s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.3), transparent 40%, transparent 60%, rgba(139, 92, 246, 0.1));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .feature-card:hover::before {
            opacity: 1;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            background: #10101a;
            border-color: rgba(139, 92, 246, 0.15);
        }

        .feature-icon {
            transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .feature-card:hover .feature-icon {
            transform: scale(1.1);
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.2);
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: #7c3aed;
            box-shadow: 0 8px 30px -8px rgba(124, 58, 237, 0.4);
        }

        .btn-primary:hover {
            background: #8b5cf6;
            box-shadow: 0 12px 40px -8px rgba(139, 92, 246, 0.5);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: scale(0.97);
        }

        .btn-secondary {
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.4);
        }

        .stat-item {
            position: relative;
        }

        .stat-item:not(:last-child)::after {
            content: "";
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 1px;
            background: rgba(255, 255, 255, 0.05);
        }

        @media (max-width: 640px) {
            .stat-item:not(:last-child)::after {
                display: none;
            }
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-dialog {
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 32px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
            transform: scale(0.92) translateY(16px);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .modal-overlay.active .modal-dialog {
            transform: scale(1) translateY(0);
        }

        .logout-btn-danger {
            background: #dc2626;
            transition: all 0.3s ease;
        }

        .logout-btn-danger:hover {
            background: #ef4444;
        }

        .logout-btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .logout-btn-cancel:hover {
            background: rgba(255, 255, 255, 0.1);
        }

        .floating-icon {
            position: absolute;
            opacity: 0.06;
            font-size: 80px;
            color: #a78bfa;
            pointer-events: none;
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-20px) rotate(5deg);
            }
        }

        .floating-icon-2 {
            position: absolute;
            opacity: 0.04;
            font-size: 120px;
            color: #7c3aed;
            pointer-events: none;
            animation: floatReverse 8s ease-in-out infinite;
        }

        @keyframes floatReverse {
            0%,
            100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(20px) rotate(-5deg);
            }
        }

        .counter-number {
            font-size: 2.25rem;
            font-weight: 900;
            color: #a78bfa;
            font-feature-settings: "tnum";
            direction: ltr;
        }

        @media (min-width: 768px) {
            .counter-number {
                font-size: 2.5rem;
            }
        }

        .scroll-reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.7s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .scroll-reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .scroll-reveal-scale {
            opacity: 0;
            transform: scale(0.9);
            transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .scroll-reveal-scale.visible {
            opacity: 1;
            transform: scale(1);
        }

        /* ===== Header CTA (New Invoice Button) ===== */
        .header-cta {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 18px;
            border-radius: 12px;
            background: linear-gradient(135deg, #7c3aed, #8b5cf6);
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            border: 1px solid rgba(139, 92, 246, 0.4);
            transition: all 0.25s ease;
            box-shadow: 0 4px 16px -4px rgba(124, 58, 237, 0.5);
        }

        .header-cta:hover {
            background: linear-gradient(135deg, #8b5cf6, #a78bfa);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px -4px rgba(139, 92, 246, 0.6);
        }

        .header-cta:active {
            transform: translateY(0) scale(0.97);
        }

        .header-cta i {
            font-size: 14px;
        }

        .header-cta-sm {
            width: 42px;
            height: 42px;
            padding: 0;
            justify-content: center;
            border-radius: 12px;
        }

        /* ===== User Dropdown (New Style) ===== */
        .dropdown-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 6px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.25s ease;
            color: #e5e7eb;
            font-weight: 600;
            font-size: 13px;
        }

        .dropdown-trigger:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(139, 92, 246, 0.35);
        }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            flex-shrink: 0;
            box-shadow: 0 2px 8px -2px rgba(124, 58, 237, 0.5);
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            min-width: 260px;
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px;
            box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.7);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 100;
        }

        .dropdown-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            background: none;
            border: none;
            width: 100%;
            text-align: right;
            font-family: 'Sahel', sans-serif !important;
        }

        .dropdown-item:hover {
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
        }

        .dropdown-item i {
            font-size: 17px;
            width: 20px;
            text-align: center;
        }

        .dropdown-item.danger:hover {
            background: rgba(220, 38, 38, 0.12);
            color: #f87171;
        }

        .dropdown-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.05);
            margin: 6px 8px;
        }

        /* ===== Footer (Simple) ===== */
        .site-footer {
            background: #08080f;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: 48px;
        }

        .footer-inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 40px 20px 24px;
        }

        @media (min-width: 768px) {
            .footer-inner {
                padding: 56px 24px 24px;
            }
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 24px;
            padding-bottom: 28px;
            margin-bottom: 28px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .footer-brand-block {
            flex: 1;
            min-width: 0;
            max-width: 420px;
        }

        .footer-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 900;
            color: #fff;
            font-size: 18px;
            text-decoration: none;
            margin-bottom: 10px;
        }

        .footer-logo-box {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 900;
            font-size: 16px;
            box-shadow: 0 4px 14px -4px rgba(124, 58, 237, 0.5);
        }

        .footer-desc {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.9;
            margin-bottom: 0;
        }

        .footer-oss {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 10px;
            background: rgba(139, 92, 246, 0.08);
            border: 1px solid rgba(139, 92, 246, 0.2);
            color: #c4b5fd;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.25s ease;
            flex-shrink: 0;
            align-self: flex-start;
        }

        .footer-oss:hover {
            background: rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.4);
            color: #fff;
            transform: translateY(-1px);
        }

        .footer-oss i:first-child {
            font-size: 14px;
        }

        .footer-oss i:last-child {
            font-size: 11px;
            opacity: 0.7;
        }

        @media (max-width: 640px) {
            .footer-top {
                flex-direction: column;
                gap: 16px;
            }

            .footer-oss {
                align-self: flex-start;
            }
        }

        .footer-sections {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        @media (min-width: 768px) {
            .footer-sections {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 40px;
            }
        }

        .footer-group {
            padding: 16px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .footer-group:last-child {
            border-bottom: none;
        }

        @media (min-width: 768px) {
            .footer-group {
                padding: 0;
                border-bottom: none;
            }
        }

        .footer-col-title {
            font-size: 12px;
            font-weight: 800;
            color: #e5e7eb;
            margin-bottom: 12px;
            letter-spacing: 0.4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .footer-col-title i {
            color: #a78bfa;
            font-size: 13px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 10px;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-links a {
            color: #6b7280;
            font-size: 13px;
            text-decoration: none;
            transition: color 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 0;
        }

        .footer-links a:hover {
            color: #c4b5fd;
        }

        .footer-links a i {
            font-size: 13px;
            opacity: 0.7;
            width: 16px;
            text-align: center;
            flex-shrink: 0;
        }

        .footer-bottom {
            padding-top: 20px;
            margin-top: 28px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #4a4a63;
            text-align: center;
        }

        @media (min-width: 640px) {
            .footer-bottom {
                flex-direction: row;
                justify-content: space-between;
                text-align: right;
                margin-top: 32px;
            }
        }

        /* ===== Official modal ===== */
        .official-modal .modal-dialog {
            background: #0f0f1a;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 0;
            max-width: 560px;
            width: 92%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            max-height: 90vh;
        }

        .om-head {
            padding: 32px 32px 24px;
            text-align: center;
            background:
                radial-gradient(circle at 30% 0%, rgba(139, 92, 246, 0.12), transparent 60%),
                radial-gradient(circle at 80% 100%, rgba(16, 185, 129, 0.06), transparent 60%),
                linear-gradient(180deg, rgba(139, 92, 246, 0.04), transparent);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
        }

        .om-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 24px;
            margin: 0 auto 16px;
            box-shadow: 0 10px 30px -10px rgba(124, 58, 237, 0.5);
        }

        .om-title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 6px;
        }

        .om-sub {
            font-size: 13px;
            color: #6b7280;
        }

        .om-body {
            padding: 28px 32px;
            overflow-y: auto;
            flex: 1;
        }

        .om-text {
            font-size: 14px;
            color: #9ca3af;
            line-height: 2;
        }

        .om-text strong {
            color: #c4b5fd;
            font-weight: 700;
        }

        .om-contact-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 18px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 14px;
            text-decoration: none;
            color: #e5e7eb;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.25s ease;
            margin-bottom: 12px;
        }

        .om-contact-card:last-child {
            margin-bottom: 0;
        }

        .om-contact-card:hover {
            background: rgba(139, 92, 246, 0.06);
            border-color: rgba(139, 92, 246, 0.3);
            transform: translateY(-2px);
        }

        .om-contact-card .cc-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(139, 92, 246, 0.1);
            color: #c4b5fd;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .om-contact-card .cc-text {
            flex: 1;
            min-width: 0;
        }

        .om-contact-card .cc-label {
            font-size: 11px;
            color: #6b7280;
            font-weight: 500;
            margin-bottom: 2px;
        }

        .om-contact-card .cc-value {
            font-size: 13px;
            color: #c4b5fd;
            direction: ltr;
            text-align: right;
        }

        .om-foot {
            padding: 20px 32px 24px;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            background: rgba(0, 0, 0, 0.1);
        }

        .om-btn-ghost {
            padding: 10px 22px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #9ca3af;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            font-family: 'Sahel', sans-serif !important;
        }

        .om-btn-ghost:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        @media (max-width: 640px) {
            .header-cta span {
                display: none;
            }

            .om-head {
                padding: 24px 20px 20px;
            }

            .om-body {
                padding: 20px;
            }

            .om-foot {
                padding: 16px 20px 20px;
            }

            .om-title {
                font-size: 17px;
            }
        }
    </style>

    <%- include('partials/invoice-sheet-css') %>

    <style>
        .fx-theme-chip {
            background: rgba(255, 255, 255, 0.03);
            cursor: pointer;
        }

        .fx-theme-chip.is-on {
            background: rgba(139, 92, 246, 0.18);
            border-color: rgba(167, 139, 250, 0.55);
            color: #fff;
        }

        .fx-theme-chip[data-theme="luxe"].is-on {
            background: linear-gradient(135deg, rgba(184, 134, 11, 0.35), rgba(232, 200, 114, 0.2));
            border-color: rgba(232, 200, 114, 0.7);
            color: #f6e7a8;
        }
    </style>

    <style>
        .railway-announcement {
            position: relative;
            z-index: 40;
            max-width: 900px;
            margin: 110px auto -90px;
            padding: 0 16px;
        }

        .announcement-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 13px 18px;
            border: 1px solid rgba(167, 139, 250, 0.2);
            border-radius: 14px;
            background: rgba(139, 92, 246, 0.09);
            color: #c4b5fd;
            font-size: 12px;
            line-height: 1.9;
            text-align: right;
        }

        .announcement-content i {
            flex-shrink: 0;
            font-size: 18px;
            color: #a78bfa;
        }

        .announcement-content p {
            margin: 0;
        }

        .announcement-content strong {
            color: #fff;
        }

        @media (max-width: 640px) {
            .railway-announcement {
                margin-top: 100px;
                margin-bottom: -80px;
            }

            .announcement-content {
                align-items: flex-start;
                font-size: 11px;
                padding: 12px;
            }
        }
    </style>
</head>

<body class="antialiased bg-[#050508] grid-bg">

