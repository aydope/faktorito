                    </a>
                    <a href="/auth/register" class="header-cta">
                        <i class="bi bi-rocket-takeoff"></i>
                        <span>شروع رایگان</span>
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <main id="main">
        <section class="relative pt-36 pb-12 md:pt-48 md:pb-20 px-4 max-w-5xl mx-auto text-center overflow-hidden">
            <div class="floating-icon" style="top: 10%; right: 5%;"><i class="bi bi-receipt"></i></div>
            <div class="floating-icon-2" style="bottom: 15%; left: 3%;"><i class="bi bi-calculator"></i></div>
            <div class="floating-icon" style="top: 20%; left: 8%; font-size: 50px; animation-delay: 2s;"><i class="bi bi-tag"></i></div>
            <div class="floating-icon-2" style="bottom: 25%; right: 6%; font-size: 60px; animation-delay: 3s;"><i class="bi bi-share"></i></div>

            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-accent-700/10 rounded-full blur-[120px] pointer-events-none"></div>
            <div class="absolute top-1/3 right-0 w-[300px] h-[300px] bg-accent-500/5 rounded-full blur-[100px] pointer-events-none"></div>
            <div class="absolute bottom-1/3 left-0 w-[300px] h-[300px] bg-emerald-500/5 rounded-full blur-[100px] pointer-events-none"></div>

            <div class="relative z-10">
                <h1 class="text-4xl md:text-6xl lg:text-7xl font-black tracking-tight text-white mb-6 leading-tight scroll-reveal">
                    فاکتور حرفه‌ای
                    <br />
                    <span class="hero-gradient">در یک دقیقه</span>
                </h1>
                <p class="text-base md:text-lg text-gray-400 max-w-xl mx-auto mb-8 leading-relaxed scroll-reveal" style="transition-delay: 0.1s;">
                    فاکتورهای زیبا و استاندارد با شماره خودکار، تخفیف درصدی و مبلغی بسازید،
                    لینک اختصاصی بگیرید و با کیفیت بالا دانلود کنید.
                </p>

                <div class="flex items-center justify-center gap-6 mb-8 scroll-reveal" style="transition-delay: 0.15s;">
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <i class="bi bi-shield-check text-emerald-400 text-sm"></i>
                        <span>امنیت SSL</span>
                    </div>
                    <div class="w-px h-4 bg-white/10"></div>
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <i class="bi bi-clock text-accent-400 text-sm"></i>
                        <span>پشتیبانی 24/7</span>
                    </div>
                    <div class="w-px h-4 bg-white/10"></div>
                    <div class="flex items-center gap-2 text-xs text-gray-500">
                        <i class="bi bi-download text-accent-400 text-sm"></i>
                        <span>خروجی PNG</span>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-center gap-2 mb-5 scroll-reveal" id="fxThemes" style="transition-delay:.15s;">
                    <% themes.forEach(function (t) { %>
                    <button type="button" data-theme="<%= t.key %>" title="<%= t.hint %>"
                        class="fx-theme-chip px-4 py-1.5 rounded-full text-xs font-bold border border-white/10 text-gray-300 hover:border-white/30 transition <%= t.key === sheet.theme ? 'is-on' : '' %>">
                        <%= t.label %><% if (t.key === 'luxe') { %> <i class="bi bi-stars"></i><% } %>
                    </button>
                    <% }); %>
                </div>

                <div class="mb-12 scroll-reveal-scale" style="transition-delay: 0.2s;">
                    <%- include('partials/invoice-sheet', { sheet: sheet }) %>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-14">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <a href="/invoices/new"
                            class="btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-white font-bold text-base scroll-reveal"
                            style="transition-delay: 0.25s;">
                            <i class="bi bi-plus-lg"></i> ساخت فاکتور جدید
                        </a>
                    <% } else { %>
                        <a href="/auth/register"
                            class="btn-primary w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-white font-bold text-base scroll-reveal"
                            style="transition-delay: 0.25s;">
                            <i class="bi bi-rocket-takeoff"></i> شروع رایگان
                        </a>
                    <% } %>
                    <a href="#features"
                        class="btn-secondary w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl text-gray-300 font-bold text-base scroll-reveal"
