<%- include('partials/auth-head') %>

<main class="max-w-md mx-auto px-5 relative z-10 flex items-center justify-center" style="min-height: 100vh; padding: 30px 0;">
    <div class="w-full">
        <div class="text-center mb-7">
            <div class="w-14 h-14 bg-gradient-to-br from-accent-700 to-accent-500 rounded-2xl flex items-center justify-center text-white text-xl font-extrabold shadow-glow mx-auto mb-4">
                ف
            </div>
            <h1 class="text-xl md:text-2xl font-black text-white mb-1">ورود به فاکتوریتو</h1>
            <p class="text-gray-400 text-xs">به حساب کاربری خود وارد شوید</p>
        </div>

        <div class="login-card">
            <form id="loginForm" autocomplete="on" novalidate>
                <div class="float-group">
                    <i class="bi bi-envelope float-icon"></i>
                    <input
                        type="email"
                        name="email"
                        id="email"
                        required
                        autocomplete="email"
                        class="float-input"
                        placeholder=" "
                    />
                    <label class="float-label" for="email">ایمیل</label>
                    <div class="float-feedback" id="emailFeedback"></div>
                </div>

                <div class="float-group">
                    <i class="bi bi-lock float-icon"></i>
                    <input
                        type="password"
                        name="password"
                        id="password"
                        required
                        autocomplete="current-password"
                        class="float-input"
                        placeholder=" "
                    />
                    <label class="float-label" for="password">رمز عبور</label>
                    <button type="button" onclick="togglePass()" class="toggle-pass" tabindex="-1">
                        <i class="bi bi-eye" id="passIcon"></i>
                    </button>
                </div>

                <div class="flex items-center justify-between -mt-2 mb-5 text-xs">
                    <a href="/auth/forgot" class="text-gray-400 hover:text-accent-400 no-underline">فراموشی رمز عبور؟</a>
                    <a href="/auth/login/otp" class="text-accent-400 font-bold no-underline">
                        <i class="bi bi-key"></i> ورود با کد ایمیل
                    </a>
                </div>

                <button type="submit" class="btn-primary w-full py-3 rounded-xl text-white font-bold text-sm flex items-center justify-center gap-2" id="submitBtn">
                    <i class="bi bi-box-arrow-in-right text-base"></i>
                    <span>ورود</span>
                </button>
            </form>

            <div class="mt-5 text-center text-xs text-gray-400">
                حساب کاربری ندارید؟
                <a href="/auth/register" class="text-accent-400 font-bold hover:text-accent-300 transition-colors no-underline">ثبت‌نام کنید</a>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/" class="text-gray-500 hover:text-gray-300 text-xs no-underline inline-flex items-center gap-1 transition-colors">
                <i class="bi bi-arrow-right"></i> بازگشت به صفحه اصلی
            </a>
        </div>
    </div>
</main>

<div id="toast" class="toast"></div>

<script>
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    function escapeHtml(str) {
        if (!str) return "";
        const div = document.createElement("div");
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }

    function togglePass() {
        const input = document.getElementById("password");
        const icon = document.getElementById("passIcon");
        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";
        icon.className = isPassword ? "bi bi-eye-slash" : "bi bi-eye";
    }

    function showFeedback(elementId, message, type) {
        const el = document.getElementById(elementId);
        el.textContent = message;
        el.className = "float-feedback show " + type;
    }

    function hideFeedback(elementId) {
        const el = document.getElementById(elementId);
        el.classList.remove("show");
    }

    function setFieldState(inputId, state) {
        const input = document.getElementById(inputId);
        input.classList.remove("error", "valid", "validating");
        if (state) input.classList.add(state);
    }

    const debouncedValidateEmail = debounce(() => {
        const input = document.getElementById("email");
        const value = input.value.trim();

        if (!value) {
            hideFeedback("emailFeedback");
            setFieldState("email", null);
            return;
        }

        setFieldState("email", "validating");
        showFeedback("emailFeedback", "در حال بررسی...", "validating");

        setTimeout(() => {
            const emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*\.[a-zA-Z]{2,}$/;

            if (!emailRegex.test(value)) {
                showFeedback("emailFeedback", "لطفاً یک ایمیل معتبر وارد کنید", "error");
                setFieldState("email", "error");
                return;
            }

            hideFeedback("emailFeedback");
            setFieldState("email", "valid");
        }, 400);
    }, 600);

    document.getElementById("email").addEventListener("input", debouncedValidateEmail);

    function toast(msg, type) {
        const t = document.getElementById("toast");
        t.textContent = msg;
        t.style.display = "block";

        if (type === "error") {
            t.style.background = 'rgba(127,29,29,0.95)';
            t.style.borderColor = 'rgba(239,68,68,0.4)';
            t.style.color = '#fca5a5';
        } else if (type === "success") {
            t.style.background = 'rgba(6,78,59,0.95)';
            t.style.borderColor = 'rgba(16,185,129,0.4)';
            t.style.color = '#6ee7b7';
        } else {
            t.style.background = 'rgba(20,20,31,0.95)';
            t.style.borderColor = 'rgba(139,92,246,0.4)';
            t.style.color = '#fff';
        }

        clearTimeout(t._t);
        t._t = setTimeout(() => {
            t.style.display = "none";
        }, 3000);
    }

    document.getElementById("loginForm").addEventListener("submit", async function (e) {
        e.preventDefault();

        const btn = document.getElementById("submitBtn");
        const originalHTML = btn.innerHTML;
        const email = document.getElementById("email").value.trim();
        const password = document.getElementById("password").value;
        const errors = [];

        if (!email) {
            errors.push("ایمیل الزامی است");
            setFieldState("email", "error");
        }

        if (!password) {
            errors.push("رمز عبور الزامی است");
            setFieldState("password", "error");
        }

        if (errors.length > 0) {
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="loader-spinner"></span><span>در حال ورود...</span>';

        try {
            const res = await fetch("/auth/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email, password })
            });

            const data = await res.json();

            if (data.success) {
                toast(data.message || "ورود با موفقیت انجام شد", "success");
                setTimeout(() => {
                    window.location.href = data.redirect || "/dashboard";
                }, 500);
            } else {
                let e = {};
                let r = data.errors || data.validationErrors;

                Array.isArray(r)
                    ? r.forEach(x => e.general = (e.general || []).concat(x))
                    : r && "object" == typeof r
                        ? e = r
                        : e.general = data.message ? [data.message] : ["ایمیل یا رمز عبور اشتباه است"];

                e.email && (
                    showFeedback("emailFeedback", e.email, "error"),
                    setFieldState("email", "error")
                );

                e.password && (
                    toast(e.password, "error"),
                    setFieldState("password", "error")
                );

                (e.general || []).forEach(x => toast(x, "error"));
            }
        } catch (err) {
            toast("خطا در ارتباط با سرور", "error");
        }

        btn.disabled = false;
        btn.innerHTML = originalHTML;
    });
</script>
</body>
</html>