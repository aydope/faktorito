<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>۴۰۴ | صفحه پیدا نشد | فاکتوریتو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        ink: {
                            950: '#050508', 900: '#0c0c14', 800: '#14141f', 700: '#1c1c2a',
                            600: '#28283a', 500: '#36364c', 400: '#4a4a63',
                        },
                        accent: {
                            400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9', 800: '#5b21b6', 900: '#4c1d95',
                        },
                        gold: { 400: '#fbbf24', 500: '#f59e0b', 600: '#d97706', 700: '#b45309' },
                        success: { 300: '#6ee7b7', 400: '#34d399', 500: '#10b981', 600: '#059669' },
                    },
                    boxShadow: {
                        'glow': '0 0 32px rgba(124, 58, 237, 0.35)',
                        'glow-lg': '0 8px 40px rgba(124, 58, 237, 0.45)',
                        'card': '0 10px 40px -10px rgba(0, 0, 0, 0.4)',
                    },
                    borderRadius: { 'xl': '12px', '2xl': '16px', '3xl': '24px' },
                    keyframes: {
                        shimmer: { '0%': { backgroundPosition: '200% 0' }, '100%': { backgroundPosition: '-200% 0' } },
                        pulseGlow: { '0%, 100%': { filter: 'drop-shadow(0 0 40px rgba(139, 92, 246, 0.4))' }, '50%': { filter: 'drop-shadow(0 0 70px rgba(139, 92, 246, 0.7))' } },
                        float1: { '0%, 100%': { transform: 'translate(0, 0)' }, '50%': { transform: 'translate(20px, -20px)' } },
                        float2: { '0%, 100%': { transform: 'translate(0, 0)' }, '50%': { transform: 'translate(-15px, 15px)' } },
                        floatOrb: { '0%, 100%': { transform: 'translateY(0)' }, '50%': { transform: 'translateY(-6px)' } },
                    },
                    animation: {
                        shimmer: 'shimmer 1.8s infinite',
                        pulseGlow: 'pulseGlow 3s ease-in-out infinite',
                        float1: 'float1 4s ease-in-out infinite',
                        float2: 'float2 5s ease-in-out infinite',
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            position: relative;
            padding: 20px;
        }
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #050508; }
        ::-webkit-scrollbar-thumb { background: #1c1c2a; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #28283a; }

        .grid-bg {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .error-gradient {
            background: linear-gradient(135deg, #c4b5fd 0%, #a78bfa 30%, #8b5cf6 60%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: pulseGlow 3s ease-in-out infinite;
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: #7c3aed;
            box-shadow: 0 8px 30px -8px rgba(124, 58, 237, 0.4);
            border: 1px solid rgba(139, 92, 246, 0.3);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 32px;
            border-radius: 16px;
            color: #fff;
            font-weight: 700;
            font-size: 14px;
            text-decoration: none;
            cursor: pointer;
            min-width: 180px;
        }
        .btn-primary:hover {
            background: #8b5cf6;
            box-shadow: 0 12px 40px -8px rgba(139, 92, 246, 0.5);
            transform: translateY(-2px);
        }
        .btn-primary:active { transform: scale(0.97); }

        .btn-outline {
            padding: 14px 28px;
            border-radius: 16px;
            color: #9ca3af;
            font-weight: 600;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            min-width: 160px;
            justify-content: center;
            cursor: pointer;
        }
        .btn-outline:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(167, 139, 250, 0.3);
            color: #fff;
            transform: translateY(-2px);
        }

        .dot-pattern {
            position: absolute;
            width: 200px;
            height: 200px;
            opacity: 0.06;
            pointer-events: none;
        }
        .dot-pattern::before,
        .dot-pattern::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: #a78bfa;
        }
        .dot-pattern::before {
            width: 8px;
            height: 8px;
            top: 20%;
            left: 30%;
            animation: float1 4s ease-in-out infinite;
        }
        .dot-pattern::after {
            width: 12px;
            height: 12px;
            bottom: 30%;
            right: 25%;
            animation: float2 5s ease-in-out infinite;
        }

        .url-display {
            display: inline-block;
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 10px 20px;
            direction: ltr;
            text-align: left;
            font-family: 'Courier New', monospace !important;
            font-size: 14px;
            color: #a78bfa;
            word-break: break-all;
            max-width: 100%;
            transition: all 0.3s ease;
        }
        .url-display:hover {
            border-color: rgba(139, 92, 246, 0.3);
            background: #10101a;
        }
        .url-display * {
            font-family: 'Courier New', monospace !important;
        }

        @media (max-width: 480px) {
            .btn-primary, .btn-outline { min-width: 140px; padding: 12px 20px; font-size: 13px; }
        }
    </style>
</head>
<body class="antialiased bg-[#050508] grid-bg">

    <!-- Glow Orbs -->
    <div style="position: fixed; top: 25%; right: 15%; width: 350px; height: 350px; background: #7c3aed; border-radius: 50%; filter: blur(140px); opacity: 0.06; pointer-events: none;"></div>
    <div style="position: fixed; bottom: 20%; left: 20%; width: 300px; height: 300px; background: #8b5cf6; border-radius: 50%; filter: blur(120px); opacity: 0.04; pointer-events: none;"></div>

    <!-- Dot Patterns -->
    <div class="dot-pattern" style="top: 15%; right: 10%;"></div>
    <div class="dot-pattern" style="bottom: 20%; left: 8%;"></div>

    <div class="relative z-10 text-center px-4 py-8 max-w-3xl mx-auto w-full">

        <!-- 404 -->
        <div class="text-[120px] md:text-[160px] lg:text-[200px] font-black error-gradient leading-none select-none tracking-tight">
            ۴۰۴
        </div>

        <!-- Title -->
        <h1 class="text-2xl md:text-3xl lg:text-4xl font-black text-white mb-2 tracking-tight">
            صفحه پیدا نشد
        </h1>

        <!-- URL -->
        <div class="mb-10">
            <div class="url-display"><%= url || '/' %></div>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center items-center flex-wrap" id="buttonContainer">
            <!-- دکمه‌ها با JS کنترل می‌شن -->
        </div>

    </div>

    <script>
        (function() {
            const container = document.getElementById('buttonContainer');
            const hasHistory = document.referrer && document.referrer !== '' && window.history.length > 1;

            if (hasHistory) {
                const backBtn = document.createElement('a');
                backBtn.href = '#';
                backBtn.className = 'btn-primary';
                backBtn.innerHTML = '<i class="bi bi-arrow-right"></i> بازگشت';
                backBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.history.back();
                });
                container.appendChild(backBtn);
            }

            const homeBtn = document.createElement('a');
            homeBtn.href = '/';
            homeBtn.className = hasHistory ? 'btn-outline' : 'btn-primary';
            homeBtn.innerHTML = '<i class="bi bi-house"></i> صفحه اصلی';
            container.appendChild(homeBtn);

        })();
    </script>

</body>
</html>