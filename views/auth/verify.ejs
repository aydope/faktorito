<%- include('../partials/auth-head') %>

<main class="max-w-md mx-auto px-5 relative z-10 flex items-center justify-center"
      style="min-height:100vh;padding:30px 0;">
    <div class="w-full">
        <div class="text-center mb-7">
            <div class="w-14 h-14 bg-gradient-to-br from-accent-700 to-accent-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-glow mx-auto mb-4">
                <i class="bi bi-envelope-check"></i>
            </div>

            <h1 class="text-xl md:text-2xl font-black text-white mb-1">
                تأیید ایمیل
            </h1>

            <p class="text-gray-400 text-xs">
                کد 6 رقمی ارسال‌شده به
                <b class="text-gray-200" dir="ltr"><%= email %></b>
                را وارد کنید
            </p>
        </div>

        <div class="error-box" id="errorBox"></div>

        <div class="login-card">
            <form id="f" novalidate>
                <!-- OTP boxes -->
                <div class="otp-wrap">
                    <div class="otp-boxes" id="otpBoxes" aria-hidden="true">
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                    </div>
                    <input type="text"
                           id="code"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           class="otp-input"
                           aria-label="کد تأیید ۶ رقمی"
                           autofocus />
                </div>

                <button type="submit"
                        class="btn-primary w-full py-3 rounded-xl text-white font-bold text-sm flex items-center justify-center gap-2"
                        id="btn">
                    <i class="bi bi-patch-check"></i>
                    <span>تأیید و ورود</span>
                </button>
            </form>

            <div class="mt-5 text-center text-xs text-gray-400">
                کد را دریافت نکردید؟
                <button type="button" id="resend" class="link-btn">
                    ارسال دوباره
                </button>
            </div>

            <p class="mt-3 text-center text-[11px] text-gray-500">
                کد 10 دقیقه اعتبار دارد و حداکثر 5 بار می‌توانید اشتباه وارد کنید.
            </p>
        </div>

        <div class="text-center mt-4">
            <a href="/auth/login"
               class="text-gray-500 hover:text-gray-300 text-xs no-underline inline-flex items-center gap-1">
                <i class="bi bi-arrow-right"></i>
                بازگشت به ورود
            </a>
        </div>
    </div>
</main>

<%- include('../partials/auth-scripts') %>

<style>
    /* ===== OTP field ===== */
    .otp-wrap {
        position: relative;
        margin-bottom: 20px;
    }

    .otp-boxes {
        display: flex;
        gap: 8px;
        justify-content: space-between;
        direction: ltr;
    }

    .otp-box {
        flex: 1;
        height: 54px;
        border-radius: 12px;
        border: 1px solid rgba(167, 139, 250, 0.15);
        background: rgba(15, 15, 26, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        color: #fff;
        font-variant-numeric: tabular-nums;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .otp-box.is-filled {
        border-color: rgba(167, 139, 250, 0.4);
        background: rgba(124, 58, 237, 0.08);
    }

    .otp-box.is-active {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        background: rgba(124, 58, 237, 0.06);
    }

    .otp-box.is-error {
        border-color: rgba(239, 68, 68, 0.5);
        background: rgba(239, 68, 68, 0.08);
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
    }

    .otp-box.is-success {
        border-color: rgba(16, 185, 129, 0.5);
        background: rgba(16, 185, 129, 0.08);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
    }

    /* The real input is transparent and sits on top of the boxes */
    .otp-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        border: none;
        outline: none;
        background: transparent;
        letter-spacing: 20px;
        font-size: 16px;
        color: transparent;
        caret-color: transparent;
        cursor: text;
        padding: 0;
    }

    .otp-input:focus {
        outline: none;
    }

    @media (max-width: 380px) {
        .otp-box {
            height: 48px;
            font-size: 18px;
            border-radius: 10px;
        }
        .otp-boxes {
            gap: 6px;
        }
    }
</style>

<script>
    const code = document.getElementById("code");
    const btn = document.getElementById("btn");
    const resend = document.getElementById("resend");
    const otpBoxes = Array.from(document.querySelectorAll("#otpBoxes .otp-box"));

    let isVerifying = false;
    let lastSubmittedCode = "";

    onlyDigits(code);
    startCooldown(resend, <%= Number(cooldown) || 0 %>, "ارسال دوباره");

    // ===== OTP boxes rendering =====
    function renderOtp(state) {
        const value = code.value.replace(/\D/g, "");
        code.value = value;

        otpBoxes.forEach((box, i) => {
            box.textContent = value[i] || "";
            box.classList.toggle("is-filled", Boolean(value[i]));
            box.classList.toggle(
                "is-active",
                !state && i === value.length && document.activeElement === code
            );
            box.classList.toggle("is-error", state === "error");
            box.classList.toggle("is-success", state === "success");
        });
    }

    document.getElementById("otpBoxes").addEventListener("click", () => code.focus());
    code.addEventListener("input", () => renderOtp());
    code.addEventListener("focus", () => renderOtp());
    code.addEventListener("blur", () => renderOtp());

    // ===== Verify OTP =====
    async function verifyCode(value) {
        if (isVerifying) return;
        isVerifying = true;

        busy(btn, true, "در حال بررسی...");

        try {
            const r = await postJson("/auth/verify", { code: value });

            if (r.ok) {
                renderOtp("success");
                toast(r.data.message || "تأیید شد", "success");
                setTimeout(() => {
                    location.href = r.data.redirect || "/";
                }, 500);
                return;
            }

            renderOtp("error");
            showErrors(errorsFrom(r.data));
            code.select();
            lastSubmittedCode = ""; // allow retry
        } catch {
            renderOtp("error");
            toast("خطا در ارتباط با سرور", "error");
            lastSubmittedCode = "";
        } finally {
            isVerifying = false;
            busy(btn, false);
        }
    }

    // ===== Auto-verify on type or paste =====
    code.addEventListener("input", () => {
        showErrors([]);

        const value = code.value.replace(/\D/g, "");
        code.value = value; // keep digits only

        if (value.length < 6) {
            lastSubmittedCode = ""; // allow retry
            return;
        }

        if (/^\d{6}$/.test(value) && value !== lastSubmittedCode && !isVerifying) {
            lastSubmittedCode = value;
            verifyCode(value);
        }
    });

    // ===== Submit =====
    document.getElementById("f").addEventListener("submit", async (e) => {
        e.preventDefault();
        showErrors([]);

        if (!/^\d{6}$/.test(code.value)) {
            return showErrors(["کد باید 6 رقم باشد"]);
        }

        verifyCode(code.value);
    });

    // ===== Resend =====
    resend.addEventListener("click", async () => {
        resend.disabled = true;

        try {
            const r = await postJson("/auth/verify/resend");

            if (r.ok) {
                toast(r.data.message, "success");
                startCooldown(resend, r.data.cooldown || 60, "ارسال دوباره");
            } else {
                showErrors(errorsFrom(r.data));
                const s = r.data.retryAfter || 5;
                startCooldown(resend, s, "ارسال دوباره");
            }
        } catch {
            resend.disabled = false;
            toast("خطا در ارتباط با سرور", "error");
        }
    });

    // Initial render
    renderOtp();
</script>

</body>
</html>