<%- include('../partials/auth-head') %>

<main class="max-w-md mx-auto px-5 relative z-10 flex items-center justify-center"
      style="min-height:100vh;padding:30px 0;">
    <div class="w-full">
        <div class="text-center mb-7">
            <div class="w-14 h-14 bg-gradient-to-br from-accent-700 to-accent-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-glow mx-auto mb-4">
                <i class="bi bi-key"></i>
            </div>

            <h1 class="text-xl md:text-2xl font-black text-white mb-1">
                ورود با کد یک‌بارمصرف
            </h1>

            <p class="text-gray-400 text-xs">
                کد ورود به ایمیل شما ارسال می‌شود؛ نیازی به رمز عبور نیست
            </p>
        </div>

        <div class="error-box" id="errorBox"></div>

        <div class="login-card">
            <form id="f1" novalidate>
                <div class="float-group">
                    <i class="bi bi-envelope float-icon"></i>
                    <input type="email"
                           id="email"
                           autocomplete="email"
                           class="float-input"
                           placeholder=" " />
                    <label class="float-label" for="email">ایمیل</label>
                </div>

                <button type="submit"
                        class="btn-primary w-full py-3 rounded-xl text-white font-bold text-sm flex items-center justify-center gap-2"
                        id="btn1">
                    <i class="bi bi-send"></i>
                    <span>ارسال کد</span>
                </button>
            </form>

            <form id="f2" novalidate style="display:none">
                <p class="text-xs text-gray-400 mb-4 text-center">
                    کد ارسال‌شده را وارد کنید
                </p>

                <!-- OTP boxes -->
                <div class="otp-wrap">
                    <div class="otp-boxes" id="otpBoxes" aria-hidden="true">
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                        <span class="otp-box"></span>
                    </div>
                    <input type="text"
                           id="code"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           maxlength="6"
                           class="otp-input"
                           aria-label="کد ورود ۶ رقمی" />
                </div>

                <button type="submit"
                        class="btn-primary w-full py-3 rounded-xl text-white font-bold text-sm flex items-center justify-center gap-2"
                        id="btn2">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>ورود</span>
                </button>

                <div class="mt-4 text-center">
                    <button type="button" id="resend" class="link-btn">
                        ارسال دوباره
                    </button>
                </div>
            </form>
        </div>

        <div class="text-center mt-4">
            <a href="/auth/login"
               class="text-gray-500 hover:text-gray-300 text-xs no-underline inline-flex items-center gap-1">
                <i class="bi bi-arrow-right"></i>
                بازگشت به ورود
            </a>
        </div>
    </div>
</main>

<%- include('../partials/auth-scripts') %>

<style>
    /* ===== OTP field ===== */
    .otp-wrap {
        position: relative;
        margin-bottom: 20px;
    }

    .otp-boxes {
        display: flex;
        gap: 8px;
        justify-content: space-between;
        direction: ltr;
    }

    .otp-box {
        flex: 1;
        height: 54px;
        border-radius: 12px;
        border: 1px solid rgba(167, 139, 250, 0.15);
        background: rgba(15, 15, 26, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 800;
        color: #fff;
        font-variant-numeric: tabular-nums;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .otp-box.is-filled {
        border-color: rgba(167, 139, 250, 0.4);
        background: rgba(124, 58, 237, 0.08);
    }

    .otp-box.is-active {
        border-color: #7c3aed;
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        background: rgba(124, 58, 237, 0.06);
    }

    /* The real input is transparent and sits on top of the boxes */
    .otp-input {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        border: none;
        outline: none;
        background: transparent;
        letter-spacing: 20px;
        font-size: 16px;
        color: transparent;
        caret-color: transparent;
        cursor: text;
        padding: 0;
    }

    .otp-input:focus {
        outline: none;
    }

    @media (max-width: 380px) {
        .otp-box {
            height: 48px;
            font-size: 18px;
            border-radius: 10px;
        }
        .otp-boxes {
            gap: 6px;
        }
    }
</style>

<script>
    const email = document.getElementById("email");
    const code = document.getElementById("code");
    const f1 = document.getElementById("f1");
    const f2 = document.getElementById("f2");
    const resend = document.getElementById("resend");
    const otpBoxes = Array.from(document.querySelectorAll("#otpBoxes .otp-box"));

    let isVerifying = false;
    let lastSubmittedCode = "";

    onlyDigits(code);

    // ===== OTP boxes rendering =====
    function renderOtp() {
        const value = code.value.replace(/\D/g, "");
        code.value = value;

        otpBoxes.forEach((box, i) => {
            box.textContent = value[i] || "";
            box.classList.toggle("is-filled", Boolean(value[i]));
            box.classList.toggle(
                "is-active",
                i === value.length && document.activeElement === code
            );
        });
    }

    document.getElementById("otpBoxes").addEventListener("click", () => code.focus());
    code.addEventListener("input", renderOtp);
    code.addEventListener("focus", renderOtp);
    code.addEventListener("blur", renderOtp);

    // ===== Request OTP =====
    async function request(btn) {
        showErrors([]);

        const v = email.value.trim().toLowerCase();
        if (!v) return showErrors(["ایمیل الزامی است"]);

        busy(btn, true, "در حال ارسال...");

        try {
            const r = await postJson("/auth/login/otp/request", { email: v });

            if (r.ok) {
                toast(r.data.message, "success");
                f1.style.display = "none";
                f2.style.display = "block";
                code.focus();
                renderOtp();
                startCooldown(resend, r.data.cooldown || 60, "ارسال دوباره");
            } else {
                showErrors(errorsFrom(r.data));
            }
        } catch {
            toast("خطا در ارتباط با سرور", "error");
        }

        busy(btn, false);
    }

    // ===== Verify OTP =====
    async function verifyCode(value) {
        if (isVerifying) return;
        isVerifying = true;

        const btn = document.getElementById("btn2");
        busy(btn, true, "در حال ورود...");

        try {
            const r = await postJson("/auth/login/otp/verify", {
                email: email.value.trim().toLowerCase(),
                code: value,
            });

            if (r.ok) {
                toast(r.data.message || "ورود موفق", "success");
                setTimeout(() => {
                    location.href = r.data.redirect || "/";
                }, 500);
                return;
            }

            showErrors(errorsFrom(r.data));
            code.select();
            lastSubmittedCode = ""; // allow retry
        } catch {
            toast("خطا در ارتباط با سرور", "error");
            lastSubmittedCode = "";
        } finally {
            isVerifying = false;
            busy(btn, false);
        }
    }

    // ===== Auto-verify on type or paste =====
    code.addEventListener("input", () => {
        showErrors([]);

        const value = code.value.replace(/\D/g, "");
        code.value = value; // keep digits only

        if (value.length < 6) {
            lastSubmittedCode = ""; // allow retry
            return;
        }

        if (/^\d{6}$/.test(value) && value !== lastSubmittedCode && !isVerifying) {
            lastSubmittedCode = value;
            verifyCode(value);
        }
    });

    // ===== Form events =====
    f1.addEventListener("submit", (e) => {
        e.preventDefault();
        request(document.getElementById("btn1"));
    });

    resend.addEventListener("click", () => request(resend));

    f2.addEventListener("submit", async (e) => {
        e.preventDefault();
        showErrors([]);

        if (!/^\d{6}$/.test(code.value)) {
            return showErrors(["کد باید 6 رقم باشد"]);
        }

        verifyCode(code.value);
    });

    // Initial render
    renderOtp();
</script>

</body>
</html>