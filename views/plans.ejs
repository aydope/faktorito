<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>مدیریت پلن‌ها | فاکتوریتو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif']
                    },
                    colors: {
                        ink: {
                            950: '#050508',
                            900: '#0c0c14',
                            800: '#14141f',
                            700: '#1c1c2a',
                            600: '#28283a',
                            500: '#36364c',
                            400: '#4a4a63'
                        },
                        accent: {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                            800: '#5b21b6',
                            900: '#4c1d95'
                        },
                        gold: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                            700: '#b45309'
                        },
                        success: {
                            300: '#6ee7b7',
                            400: '#34d399',
                            500: '#10b981',
                            600: '#059669'
                        },
                    },
                    boxShadow: {
                        'glow': '0 0 32px rgba(124, 58, 237, 0.35)',
                        'glow-lg': '0 8px 40px rgba(124, 58, 237, 0.45)',
                        'card': '0 10px 40px -10px rgba(0, 0, 0, 0.4)',
                    },
                    borderRadius: {
                        'xl': '12px',
                        '2xl': '16px',
                        '3xl': '24px'
                    },
                    keyframes: {
                        shimmer: {
                            '0%': { backgroundPosition: '200% 0' },
                            '100%': { backgroundPosition: '-200% 0' }
                        },
                        toastIn: {
                            '0%': { opacity: '0', transform: 'translateX(-50%) translateY(8px)' },
                            '100%': { opacity: '1', transform: 'translateX(-50%) translateY(0)' }
                        },
                        spin: {
                            '0%': { transform: 'rotate(0deg)' },
                            '100%': { transform: 'rotate(360deg)' }
                        },
                    },
                    animation: {
                        shimmer: 'shimmer 1.8s infinite',
                        toastIn: 'toastIn 0.3s cubic-bezier(0.16, 1, 0.3, 1)',
                        spin: 'spin 0.6s linear infinite',
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            letter-spacing: -0.1px;
            overflow-x: hidden;
            scroll-behavior: smooth;
            min-height: 100vh;
        }

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-track {
            background: #050508;
        }

        ::-webkit-scrollbar-thumb {
            background: #1c1c2a;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #28283a;
        }

        .grid-bg {
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        .card {
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.03);
        }

        .btn-primary {
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            box-shadow:
                0 8px 30px -8px rgba(124, 58, 237, 0.45),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(139, 92, 246, 0.4);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            box-shadow:
                0 12px 40px -8px rgba(139, 92, 246, 0.55),
                inset 0 1px 0 rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }

        .btn-primary:active {
            transform: translateY(0) scale(0.98);
        }

        .nav-link {
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.25s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 8px;
            border: 1px solid transparent;
        }

        .nav-link:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.04);
        }

        .nav-link.active {
            color: #c4b5fd;
            background: rgba(139, 92, 246, 0.08);
            border-color: rgba(139, 92, 246, 0.2);
        }

        .nav-link i {
            font-size: 16px;
        }

        .dropdown-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 4px 12px 4px 6px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: #d1d5db;
            font-weight: 500;
            font-size: 14px;
        }

        .dropdown-trigger:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(139, 92, 246, 0.4);
        }

        .avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            flex-shrink: 0;
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 0;
            min-width: 260px;
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 10px;
            box-shadow: 0 25px 50px -15px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px) scale(0.97);
            transition: all 0.25s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 100;
        }

        .dropdown-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            cursor: pointer;
            text-decoration: none;
            background: none;
            border: none;
            width: 100%;
            text-align: right;
        }

        .dropdown-item:hover {
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
        }

        .dropdown-item i {
            font-size: 17px;
            width: 20px;
            text-align: center;
        }

        .dropdown-item.danger:hover {
            background: rgba(220, 38, 38, 0.12);
            color: #f87171;
        }

        .dropdown-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.05);
            margin: 6px 8px;
        }

        .mega-menu {
            position: fixed;
            top: 80px;
            right: 50%;
            transform: translateX(50%) translateY(-8px);
            width: min(90%, 500px);
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 16px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
            z-index: 200;
        }

        .mega-menu.active {
            opacity: 1;
            visibility: visible;
            transform: translateX(50%) translateY(0);
        }

        .mega-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 6px;
        }

        .mega-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 14px;
            border-radius: 12px;
            transition: all 0.2s ease;
            text-decoration: none;
            color: #9ca3af;
        }

        .mega-item:hover {
            background: rgba(139, 92, 246, 0.06);
            color: #fff;
        }

        .mega-item i {
            font-size: 20px;
            width: 24px;
            text-align: center;
            color: #a78bfa;
        }

        .mega-item .mega-title {
            font-size: 14px;
            font-weight: 700;
            color: #e5e7eb;
        }

        .mega-item .mega-desc {
            font-size: 11px;
            color: #6b7280;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 85%;
            max-width: 320px;
            background: #0c0c14;
            border-left: 1px solid rgba(255, 255, 255, 0.06);
            z-index: 300;
            padding: 20px;
            overflow-y: auto;
            transform: translateX(110%);
            transition: transform 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.7);
            backdrop-filter: blur(4px);
            z-index: 290;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
            margin-bottom: 2px;
            border: 1px solid transparent;
        }

        .sidebar-link i {
            font-size: 18px;
            width: 22px;
            text-align: center;
        }

        .sidebar-link:hover {
            background: rgba(255, 255, 255, 0.04);
            color: #fff;
        }

        .sidebar-link.active {
            background: rgba(139, 92, 246, 0.08);
            color: #c4b5fd;
            border-color: rgba(139, 92, 246, 0.2);
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.06);
            margin: 12px 0;
        }

        /* ===== Page header ===== */
        .page-header {
            position: relative;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(139, 92, 246, 0.03) 100%);
            border: 1px solid rgba(139, 92, 246, 0.12);
            border-radius: 20px;
            padding: 24px 28px;
            margin-bottom: 28px;
            overflow: hidden;
        }

        .page-header::before {
            content: '';
            position: absolute;
            top: -60%;
            left: -10%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .page-header-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            border-radius: 14px;
            background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
            box-shadow: 0 8px 24px -8px rgba(124, 58, 237, 0.6);
        }

        .plan-limit-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 12.5px;
            font-weight: 700;
            color: #9ca3af;
            white-space: nowrap;
            height: 40px;
            box-sizing: border-box;
        }

        .plan-limit-badge .count {
            color: #fff;
            font-size: 14px;
            font-weight: 900;
        }

        .plan-limit-badge .divider {
            width: 1px;
            height: 14px;
            background: rgba(255, 255, 255, 0.1);
        }

        .plan-limit-badge.warning {
            border-color: rgba(245, 158, 11, 0.25);
            background: rgba(245, 158, 11, 0.06);
        }

        .plan-limit-badge.warning .count {
            color: #fcd34d;
        }

        .plan-limit-badge.danger {
            border-color: rgba(239, 68, 68, 0.25);
            background: rgba(239, 68, 68, 0.06);
        }

        .plan-limit-badge.danger .count {
            color: #fca5a5;
        }

        /* ===== Plan card ===== */
        .plan-card {
            position: relative;
            background: linear-gradient(180deg, #0f0f1a 0%, #0c0c14 100%);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 18px;
            padding: 20px 22px;
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            overflow: hidden;
        }

        .plan-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient(180deg, #7c3aed, #a78bfa);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .plan-card:hover {
            border-color: rgba(139, 92, 246, 0.2);
            background: #10101a;
            transform: translateY(-2px);
            box-shadow: 0 14px 34px -14px rgba(0, 0, 0, 0.6);
        }

        .plan-card:hover::before {
            opacity: 1;
        }

        .plan-card.is-inactive {
            opacity: 0.72;
        }

        .plan-card.is-inactive:hover {
            opacity: 0.9;
        }

        .plan-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.18) 0%, rgba(167, 139, 250, 0.1) 100%);
            border: 1px solid rgba(139, 92, 246, 0.2);
            color: #c4b5fd;
        }

        .plan-card.is-inactive .plan-icon {
            background: rgba(107, 114, 128, 0.1);
            border-color: rgba(107, 114, 128, 0.2);
            color: #9ca3af;
        }

        .plan-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 0.2px;
            white-space: nowrap;
        }

        .plan-status.active {
            background: rgba(16, 185, 129, 0.08);
            border: 1px solid rgba(16, 185, 129, 0.22);
            color: #6ee7b7;
        }

        .plan-status.inactive {
            background: rgba(107, 114, 128, 0.08);
            border: 1px solid rgba(107, 114, 128, 0.22);
            color: #9ca3af;
        }

        .plan-status i {
            font-size: 8px;
        }

        .plan-price-line {
            display: flex;
            align-items: baseline;
            gap: 4px;
            margin-top: 8px;
            direction: rtl;
            min-width: 0;
            overflow: hidden;
        }

        .plan-price-value {
            font-size: 22px;
            font-weight: 900;
            color: #fff;
            letter-spacing: -0.4px;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .plan-price-currency {
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
            flex-shrink: 0;
        }

        .plan-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .plan-action-btn {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: #9ca3af;
            cursor: pointer;
            transition: all 0.22s ease;
        }

        .plan-action-btn:hover {
            background: rgba(139, 92, 246, 0.1);
            border-color: rgba(139, 92, 246, 0.3);
            color: #c4b5fd;
            transform: translateY(-1px);
        }

        .plan-action-btn.danger:hover {
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        .plan-action-btn.toggle-on {
            color: #6ee7b7;
            background: rgba(16, 185, 129, 0.08);
            border-color: rgba(16, 185, 129, 0.2);
        }

        .plan-action-btn.toggle-on:hover {
            background: rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.35);
            color: #a7f3d0;
        }

        .plan-action-btn.toggle-off {
            color: #fca5a5;
            background: rgba(239, 68, 68, 0.06);
            border-color: rgba(239, 68, 68, 0.15);
        }

        .plan-action-btn.toggle-off:hover {
            background: rgba(239, 68, 68, 0.12);
            border-color: rgba(239, 68, 68, 0.3);
            color: #fecaca;
        }

        .plan-action-btn.is-loading {
            pointer-events: none;
            opacity: 0.6;
        }

        /* ===== Modal ===== */
        .input-field {
            width: 100%;
            padding: 12px 14px;
            background: #0c0c14;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #fff;
            font-size: 14px;
            transition: all 0.3s ease;
            outline: none;
        }

        .input-field:focus {
            border-color: rgba(139, 92, 246, 0.4);
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.05);
        }

        .input-field::placeholder {
            color: #4a4a63;
        }

        .input-field.error {
            border-color: rgba(239, 68, 68, 0.4);
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.05);
        }

        .error-text {
            font-size: 11px;
            color: #fca5a5;
            margin-top: 4px;
            display: none;
        }

        .error-text.show {
            display: block;
        }

        .field-hint {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 10px;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .field-hint i {
            font-size: 11px;
            color: #a78bfa;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 400;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            padding: 16px;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-dialog {
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 28px;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
            transform: scale(0.92) translateY(16px);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-overlay.active .modal-dialog {
            transform: scale(1) translateY(0);
        }

        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(20, 20, 31, 0.95);
            backdrop-filter: blur(12px);
            color: #fff;
            padding: 12px 24px;
            border-radius: 50px;
            font-size: 13px;
            font-weight: 600;
            z-index: 500;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(139, 92, 246, 0.3);
            display: none;
            animation: toastIn 0.3s ease;
        }

        .skeleton {
            background: linear-gradient(90deg, rgba(124, 58, 237, 0.1) 0%, rgba(139, 92, 246, 0.2) 50%, rgba(124, 58, 237, 0.1) 100%);
            background-size: 200% 100%;
            animation: shimmer 1.8s infinite;
            border-radius: 6px;
        }

        .counter {
            font-size: 10px;
            color: #6b7280;
            transition: color 0.3s ease;
        }

        .counter.warning {
            color: #fcd34d;
        }

        .counter.danger {
            color: #fca5a5;
        }

        /* ===== Mobile ===== */
        @media (max-width: 640px) {
            .page-header {
                padding: 18px 16px;
                border-radius: 16px;
                margin-bottom: 20px;
            }

            .page-header::before {
                width: 200px;
                height: 200px;
            }

            .page-header-top {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 14px;
            }

            .page-header-icon {
                width: 42px;
                height: 42px;
                font-size: 18px;
                border-radius: 12px;
            }

            .page-header h1 {
                font-size: 17px !important;
                line-height: 1.3;
                margin-bottom: 2px;
            }

            .page-header p {
                font-size: 11.5px !important;
                line-height: 1.5;
            }

            .page-header-actions {
                display: flex;
                align-items: center;
                gap: 8px;
                width: 100%;
            }

            .page-header-actions .plan-limit-badge {
                flex: 0 0 auto;
                padding: 8px 12px;
                font-size: 11.5px;
                height: 38px;
            }

            .page-header-actions .plan-limit-badge .count {
                font-size: 13px;
            }

            .page-header-actions .btn-primary {
                flex: 1;
                justify-content: center;
                padding: 10px 14px;
                font-size: 13px;
                height: 38px;
            }

            .plan-card {
                padding: 16px;
                border-radius: 14px;
            }

            .plan-card-top {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                width: 100%;
                margin-bottom: 12px;
            }

            .plan-icon {
                width: 40px;
                height: 40px;
                font-size: 17px;
                border-radius: 11px;
                flex-shrink: 0;
            }

            .plan-card-info {
                flex: 1;
                min-width: 0;
            }

            .plan-card-info .plan-name-row {
                display: flex;
                align-items: center;
                gap: 6px;
                flex-wrap: wrap;
                margin-bottom: 2px;
            }

            .plan-card-info h3 {
                font-size: 14.5px;
                line-height: 1.3;
            }

            .plan-status {
                font-size: 9.5px;
                padding: 2px 7px;
            }

            .plan-card-info .plan-desc {
                font-size: 11px;
                color: #6b7280;
                margin-bottom: 8px;
                line-height: 1.6;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .plan-price-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                padding: 10px 12px;
                background: rgba(139, 92, 246, 0.04);
                border: 1px solid rgba(139, 92, 246, 0.1);
                border-radius: 10px;
                margin-bottom: 12px;
            }

            .plan-price-row .plan-price-label {
                font-size: 10.5px;
                color: #6b7280;
                font-weight: 600;
            }

            .plan-price-row .plan-price-line {
                margin-top: 0;
                gap: 4px;
            }

            .plan-price-row .plan-price-value {
                font-size: 17px;
            }

            .plan-price-row .plan-price-currency {
                font-size: 10.5px;
            }

            .plan-actions {
                width: 100%;
                gap: 6px;
                margin-top: 0;
            }

            .plan-action-btn {
                flex: 1;
                width: auto;
                height: 38px;
                border-radius: 9px;
                font-size: 14px;
            }
        }

        @media (min-width: 769px) {
            .mobile-only {
                display: none !important;
            }
        }

        @media (max-width: 768px) {
            .desktop-only {
                display: none !important;
            }
        }
    </style>
</head>
<body class="antialiased bg-[#050508] grid-bg">

<%- include('partials/shell') %>

    <main class="max-w-5xl mx-auto px-4 pt-28 pb-16 relative z-10">

        <%
            const planCount = typeof plans !== 'undefined' ? plans.length : 0;
            const maxPlans = 7;
            let limitClass = '';
            if (planCount >= maxPlans) limitClass = 'danger';
            else if (planCount >= 5) limitClass = 'warning';
        %>

        <!-- ===== Page header ===== -->
        <div class="page-header">
            <div class="relative z-10">
                <!-- Desktop -->
                <div class="hidden sm:flex sm:items-center sm:justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="page-header-icon">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight leading-tight">مدیریت پلن‌ها</h1>
                            <p class="text-gray-400 text-xs md:text-sm mt-1">پلن‌های عضویت باشگاه خود را ایجاد و مدیریت کنید</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 flex-shrink-0">
                        <div class="plan-limit-badge <%= limitClass %>">
                            <i class="bi bi-layers"></i>
                            <span class="count"><%= planCount %></span>
                            <span class="divider"></span>
                            <span>از <%= maxPlans %></span>
                        </div>
                        <% if (planCount < maxPlans) { %>
                        <button onclick="openAddModal()" class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>پلن جدید</span>
                        </button>
                        <% } %>
                    </div>
                </div>

                <!-- Mobile -->
                <div class="sm:hidden">
                    <div class="page-header-top">
                        <div class="page-header-icon">
                            <i class="bi bi-tags-fill"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h1 class="text-2xl font-black text-white tracking-tight leading-tight">مدیریت پلن‌ها</h1>
                            <p class="text-gray-400 text-xs mt-1">پلن‌های عضویت را مدیریت کنید</p>
                        </div>
                    </div>
                    <div class="page-header-actions">
                        <div class="plan-limit-badge <%= limitClass %>">
                            <i class="bi bi-layers"></i>
                            <span class="count"><%= planCount %></span>
                            <span class="divider"></span>
                            <span>از <%= maxPlans %></span>
                        </div>
                        <% if (planCount < maxPlans) { %>
                        <button onclick="openAddModal()" class="btn-primary inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-white font-bold text-sm">
                            <i class="bi bi-plus-lg"></i>
                            <span>پلن جدید</span>
                        </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-xl p-4 mb-6 text-emerald-400 text-sm flex items-center gap-2">
            <i class="bi bi-check-circle"></i> <%= success %>
        </div>
        <% } %>

        <!-- Skeleton -->
        <div id="plansSkeleton" class="space-y-3">
            <% for (let i = 0; i < 3; i++) { %>
            <div class="plan-card">
                <div class="hidden sm:flex items-center gap-4">
                    <div class="skeleton" style="width:44px;height:44px;border-radius:12px;flex-shrink:0;"></div>
                    <div class="flex-1 min-w-0">
                        <div class="skeleton h-5 w-32 rounded mb-2"></div>
                        <div class="skeleton h-4 w-48 rounded"></div>
                    </div>
                    <div class="flex gap-2">
                        <div class="skeleton w-9 h-9 rounded-lg"></div>
                        <div class="skeleton w-9 h-9 rounded-lg"></div>
                        <div class="skeleton w-9 h-9 rounded-lg"></div>
                    </div>
                </div>
                <div class="sm:hidden">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="skeleton" style="width:40px;height:40px;border-radius:11px;flex-shrink:0;"></div>
                        <div class="flex-1">
                            <div class="skeleton h-4 w-32 rounded mb-2"></div>
                            <div class="skeleton h-3 w-24 rounded"></div>
                        </div>
                    </div>
                    <div class="skeleton h-10 w-full rounded-lg mb-3"></div>
                    <div class="flex gap-2">
                        <div class="skeleton flex-1 h-9 rounded-lg"></div>
                        <div class="skeleton flex-1 h-9 rounded-lg"></div>
                        <div class="skeleton flex-1 h-9 rounded-lg"></div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Plans list -->
        <div id="plansContent" class="space-y-3" style="display: none;">
            <% if (planCount > 0) { %>
                <% plans.forEach(function(plan) { %>
                <div class="plan-card <%= plan.isActive ? '' : 'is-inactive' %>" data-plan-id="<%= plan._id %>" data-plan-active="<%= plan.isActive ? '1' : '0' %>">
                    <!-- Desktop -->
                    <div class="hidden sm:flex sm:items-center gap-4">
                        <div class="plan-icon" data-plan-icon>
                            <i class="bi bi-award<%= plan.isActive ? '-fill' : '' %>"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap mb-1">
                                <h3 class="text-base font-extrabold text-white truncate"><%= plan.name %></h3>
                                <span class="plan-status <%= plan.isActive ? 'active' : 'inactive' %>" data-plan-status>
                                    <i class="bi bi-circle-fill"></i>
                                    <span data-plan-status-text><%= plan.isActive ? 'فعال' : 'غیرفعال' %></span>
                                </span>
                            </div>
                            <% if (plan.description) { %>
                            <p class="text-xs text-gray-500 truncate mb-2"><%= plan.description %></p>
                            <% } %>
                            <div class="plan-price-line">
                                <span class="plan-price-value"><%= plan.price.toLocaleString("fa-IR-u-nu-latn") %></span>
                                <span class="plan-price-currency">تومان</span>
                            </div>
                        </div>
                        <div class="plan-actions">
                            <button type="button" onclick="openEditModal(this)"
                                    data-id="<%= plan._id %>" data-name="<%= plan.name %>"
                                    data-price="<%= plan.price %>" data-desc="<%= plan.description || '' %>"
                                    class="plan-action-btn" title="ویرایش">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" onclick="togglePlan(this, '<%= plan._id %>')"
                                    data-toggle-btn
                                    class="plan-action-btn <%= plan.isActive ? 'toggle-on' : 'toggle-off' %>"
                                    title="<%= plan.isActive ? 'غیرفعال کردن' : 'فعال کردن' %>">
                                <i class="bi <%= plan.isActive ? 'bi-toggle-on' : 'bi-toggle-off' %>" data-toggle-icon></i>
                            </button>
                            <button type="button" onclick="openDeleteModal(this)"
                                    data-id="<%= plan._id %>" data-name="<%= plan.name %>"
                                    class="plan-action-btn danger" title="حذف">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Mobile -->
                    <div class="sm:hidden">
                        <div class="plan-card-top">
                            <div class="plan-icon" data-plan-icon>
                                <i class="bi bi-award<%= plan.isActive ? '-fill' : '' %>"></i>
                            </div>
                            <div class="plan-card-info">
                                <div class="plan-name-row">
                                    <h3 class="font-extrabold text-white truncate"><%= plan.name %></h3>
                                    <span class="plan-status <%= plan.isActive ? 'active' : 'inactive' %>" data-plan-status>
                                        <i class="bi bi-circle-fill"></i>
                                        <span data-plan-status-text><%= plan.isActive ? 'فعال' : 'غیرفعال' %></span>
                                    </span>
                                </div>
                                <% if (plan.description) { %>
                                <p class="plan-desc"><%= plan.description %></p>
                                <% } %>
                            </div>
                        </div>
                        <div class="plan-price-row">
                            <span class="plan-price-label">قیمت</span>
                            <div class="plan-price-line">
                                <span class="plan-price-value"><%= plan.price.toLocaleString("fa-IR-u-nu-latn") %></span>
                                <span class="plan-price-currency">تومان</span>
                            </div>
                        </div>
                        <div class="plan-actions">
                            <button type="button" onclick="openEditModal(this)"
                                    data-id="<%= plan._id %>" data-name="<%= plan.name %>"
                                    data-price="<%= plan.price %>" data-desc="<%= plan.description || '' %>"
                                    class="plan-action-btn" title="ویرایش">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" onclick="togglePlan(this, '<%= plan._id %>')"
                                    data-toggle-btn
                                    class="plan-action-btn <%= plan.isActive ? 'toggle-on' : 'toggle-off' %>"
                                    title="<%= plan.isActive ? 'غیرفعال کردن' : 'فعال کردن' %>">
                                <i class="bi <%= plan.isActive ? 'bi-toggle-on' : 'bi-toggle-off' %>" data-toggle-icon></i>
                            </button>
                            <button type="button" onclick="openDeleteModal(this)"
                                    data-id="<%= plan._id %>" data-name="<%= plan.name %>"
                                    class="plan-action-btn danger" title="حذف">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
            <% } else { %>
                <div class="card rounded-3xl py-16 px-6 text-center">
                    <div class="w-16 h-16 bg-accent-700/10 rounded-2xl flex items-center justify-center mx-auto mb-5 border border-accent-700/20">
                        <i class="bi bi-tags text-3xl text-accent-400"></i>
                    </div>
                    <h3 class="text-lg font-bold text-white mb-2">هیچ پلنی تعریف نشده</h3>
                    <p class="text-gray-500 text-sm mb-6">پلن‌های عضویت باشگاه خود را ایجاد کنید</p>
                    <% if (planCount < maxPlans) { %>
                    <button onclick="openAddModal()" class="btn-primary inline-flex items-center gap-2 px-6 py-3 rounded-2xl text-white font-bold text-sm w-full sm:w-auto justify-center">
                        <i class="bi bi-plus-lg"></i> ایجاد اولین پلن
                    </button>
                    <% } %>
                </div>
            <% } %>
        </div>
    </main>

    <!-- ========== ADD/EDIT MODAL ========== -->
    <div class="modal-overlay" id="planModal">
        <div class="modal-dialog">
            <h3 class="text-lg font-bold text-white mb-5" id="planModalTitle">پلن جدید</h3>
            <form id="planForm" class="space-y-4" novalidate>
                <input type="hidden" id="planId">

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs font-semibold text-gray-400">نام پلن</label>
                        <span class="counter" id="planNameCounter">0 / 24</span>
                    </div>
                    <div class="field-hint">
                        <i class="bi bi-info-circle"></i>
                        <span>بین 2 تا 24 کاراکتر</span>
                    </div>
                    <input type="text" id="planName" class="input-field" placeholder="مثلاً: عضویت طلایی" maxlength="24" minlength="2" required>
                    <p class="error-text" id="planNameError"></p>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs font-semibold text-gray-400">قیمت (تومان)</label>
                    </div>
                    <div class="field-hint">
                        <i class="bi bi-info-circle"></i>
                        <span>حداکثر 100,000,000 تومان</span>
                    </div>
                    <input type="text" id="planPrice" style="direction: ltr;" class="input-field text-left" placeholder="0" oninput="formatPlanPrice(this)" required>
                    <p class="error-text" id="planPriceError"></p>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="text-xs font-semibold text-gray-400">توضیحات</label>
                        <span class="counter" id="planDescCounter">0 / 128</span>
                    </div>
                    <div class="field-hint">
                        <i class="bi bi-info-circle"></i>
                        <span>حداکثر 128 کاراکتر</span>
                    </div>
                    <textarea id="planDesc" rows="3" class="input-field resize-none" placeholder="توضیحات اختیاری..." maxlength="128"></textarea>
                    <p class="error-text" id="planDescError"></p>
                </div>

                <div class="flex gap-3 justify-end pt-2">
                    <button type="button" onclick="closeModal('planModal')" class="px-5 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition">انصراف</button>
                    <button type="submit" class="btn-primary px-5 py-2.5 rounded-xl text-white font-semibold text-sm flex items-center gap-2" id="planSubmitBtn">
                        <span>ذخیره</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ========== DELETE MODAL ========== -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-dialog text-center">
            <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-trash text-red-400 text-3xl"></i>
            </div>
            <h3 class="text-xl font-extrabold text-white mb-2">حذف پلن</h3>
            <p class="text-gray-400 text-sm mb-8" id="deleteMsg">آیا از حذف این پلن اطمینان دارید؟</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal('deleteModal')" class="px-6 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition">انصراف</button>
                <button id="deleteConfirmBtn" class="px-6 py-2.5 rounded-xl text-white font-semibold text-sm bg-red-600 hover:bg-red-500 transition shadow-lg shadow-red-900/30">حذف</button>
            </div>
        </div>
    </div>

    <!-- ========== LOGOUT MODAL ========== -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-dialog text-center">
            <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-box-arrow-right text-red-400 text-3xl"></i>
            </div>
            <h3 class="text-xl font-extrabold text-white mb-2">خروج از حساب</h3>
            <p class="text-gray-400 text-sm mb-8">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal('logoutModal')" class="px-6 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition">انصراف</button>
                <a href="/auth/logout" class="px-6 py-2.5 rounded-xl text-white font-semibold text-sm bg-red-600 hover:bg-red-500 transition shadow-lg shadow-red-900/30 no-underline">خروج</a>
            </div>
        </div>
    </div>

    <div id="toast" class="toast"></div>

    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('plansSkeleton').style.display = 'none';
                document.getElementById('plansContent').style.display = 'block';
            }, 500);
        });

        function updateCounter(inputId, counterId, maxLength) {
            const input = document.getElementById(inputId);
            const counter = document.getElementById(counterId);
            if (!input || !counter) return;

            const len = input.value.length;
            counter.textContent = `${len} / ${maxLength}`;
            counter.classList.remove('warning', 'danger');

            if (len >= maxLength) counter.classList.add('danger');
            else if (len >= maxLength - 10) counter.classList.add('warning');
        }

        function toggleDropdown(e) {
            e.stopPropagation();
            const menu = document.getElementById('dropdownMenu');
            const caret = document.getElementById('dropdownCaret');
            menu?.classList.toggle('active');

            if (caret) {
                const icon = caret.querySelector('i');
                if (icon) icon.style.transform = menu?.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }

        function closeDropdown() {
            const menu = document.getElementById('dropdownMenu');
            const caret = document.getElementById('dropdownCaret');

            if (menu) {
                menu.classList.remove('active');
                if (caret) {
                    const icon = caret.querySelector('i');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        }

        function toggleMegaMenu() {
            const menu = document.getElementById('megaMenu');
            const caret = document.getElementById('megaCaret');
            menu?.classList.toggle('active');
            if (caret) caret.style.transform = menu?.classList.contains('active') ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        function closeMegaMenu() {
            const menu = document.getElementById('megaMenu');
            const caret = document.getElementById('megaCaret');

            if (menu) {
                menu.classList.remove('active');
                if (caret) caret.style.transform = 'rotate(0deg)';
            }
        }

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        window.openModal = (id) => document.getElementById(id)?.classList.add('active');
        window.closeModal = (id) => document.getElementById(id)?.classList.remove('active');

        function openLogoutModal() {
            closeDropdown();
            closeMegaMenu();
            closeSidebar();
            openModal('logoutModal');
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('active');
            });
        });

        document.addEventListener('click', (e) => {
            const userDropdown = document.getElementById('userDropdown');
            if (userDropdown && !userDropdown.contains(e.target)) closeDropdown();

            const megaMenu = document.getElementById('megaMenu');
            const megaBtn = document.getElementById('megaMenuBtn');
            if (megaMenu && megaBtn && !megaMenu.contains(e.target) && !megaBtn.contains(e.target)) {
                closeMegaMenu();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeDropdown();
                closeMegaMenu();
                closeSidebar();
                document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
            }
        });

        function toast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.style.display = 'block';

            if (type === 'error') {
                t.style.background = 'rgba(127,29,29,0.95)';
                t.style.borderColor = 'rgba(239,68,68,0.4)';
                t.style.color = '#fca5a5';
            } else if (type === 'success') {
                t.style.background = 'rgba(6,78,59,0.95)';
                t.style.borderColor = 'rgba(16,185,129,0.4)';
                t.style.color = '#6ee7b7';
            } else {
                t.style.background = 'rgba(20,20,31,0.95)';
                t.style.borderColor = 'rgba(139,92,246,0.4)';
                t.style.color = '#fff';
            }

            clearTimeout(t._t);
            t._t = setTimeout(() => t.style.display = 'none', 3000);
        }

        function fmt(n) {
            return parseInt(n).toLocaleString("fa-IR-u-nu-latn");
        }

        function unfmt(s) {
            return parseInt(s.replace(/,/g, '')) || 0;
        }

        function formatPlanPrice(el) {
            let v = el.value.replace(/,/g, '');
            if (v === '' || isNaN(v)) {
                el.value = '';
                return;
            }

            const num = parseInt(v);
            if (num > 100000000) {
                el.value = fmt(100000000);
            } else {
                el.value = fmt(num);
            }
        }

        function clearErrors() {
            document.querySelectorAll('.error-text').forEach(el => {
                el.textContent = '';
                el.classList.remove('show');
            });
            document.querySelectorAll('.input-field.error').forEach(el => el.classList.remove('error'));
        }

        function showError(fieldId, message) {
            const field = document.getElementById(fieldId);
            const errorEl = document.getElementById(fieldId + 'Error');

            if (field) field.classList.add('error');
            if (errorEl) {
                errorEl.textContent = message;
                errorEl.classList.add('show');
            }
        }

        function openAddModal() {
            const planCount = document.querySelectorAll('#plansContent .plan-card').length;
            if (planCount >= 7) {
                toast('حداکثر 7 پلن می‌توانید ایجاد کنید', 'error');
                return;
            }

            clearErrors();
            document.getElementById('planId').value = '';
            document.getElementById('planName').value = '';
            document.getElementById('planPrice').value = '';
            document.getElementById('planDesc').value = '';
            document.getElementById('planModalTitle').textContent = 'پلن جدید';

            updateCounter('planName', 'planNameCounter', 24);
            updateCounter('planDesc', 'planDescCounter', 128);

            openModal('planModal');
        }

        function openEditModal(btn) {
            const { id, name, price, desc } = btn.dataset;

            clearErrors();
            document.getElementById('planId').value = id;
            document.getElementById('planName').value = name;
            document.getElementById('planPrice').value = fmt(Number(price));
            document.getElementById('planDesc').value = desc || '';
            document.getElementById('planModalTitle').textContent = 'ویرایش پلن';

            updateCounter('planName', 'planNameCounter', 24);
            updateCounter('planDesc', 'planDescCounter', 128);

            openModal('planModal');
        }

        let hasError = false;

        document.getElementById('planForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearErrors();
            hasError = false;

            const id = document.getElementById('planId').value;
            const name = document.getElementById('planName').value.trim();
            const price = unfmt(document.getElementById('planPrice').value);
            const description = document.getElementById('planDesc').value.trim();

            if (!name) {
                showError('planName', 'نام پلن الزامی است');
                hasError = true;
            } else if (name.length < 2) {
                showError('planName', 'نام پلن باید حداقل 2 کاراکتر باشد');
                hasError = true;
            } else if (name.length > 24) {
                showError('planName', 'نام پلن باید حداکثر 24 کاراکتر باشد');
                hasError = true;
            }

            if (!price || price <= 0) {
                showError('planPrice', 'قیمت معتبر وارد کنید');
                hasError = true;
            } else if (price > 100000000) {
                showError('planPrice', 'قیمت نمی‌تواند بیشتر از 100,000,000 تومان باشد');
                hasError = true;
            }

            if (description.length > 128) {
                showError('planDesc', 'توضیحات باید حداکثر 128 کاراکتر باشد');
                hasError = true;
            }

            if (hasError) return;

            const url = id ? `/plans/${id}` : '/plans';
            const method = id ? 'PUT' : 'POST';
            const btn = document.getElementById('planSubmitBtn');

            btn.disabled = true;
            btn.innerHTML = '<span style="width:20px;height:20px;border:2px solid rgba(255,255,255,0.2);border-top-color:#fff;border-radius:50%;animation:spin 0.6s linear infinite;display:inline-block;"></span> در حال ذخیره...';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, price, description })
                });

                const result = await res.json();

                if (result.success) {
                    toast(result.message, 'success');
                    closeModal('planModal');
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (result.validationErrors) {
                        const fieldMap = { 'name': 'planName', 'price': 'planPrice', 'description': 'planDesc' };
                        for (const [field, message] of Object.entries(result.validationErrors)) {
                            showError(fieldMap[field] || field, message);
                        }
                    }
                    toast(result.message || 'خطا', 'error');
                }
            } catch (err) {
                toast('خطا در ارتباط با سرور', 'error');
            }

            btn.disabled = false;
            btn.innerHTML = '<span>ذخیره</span>';
        });

        document.getElementById('planName')?.addEventListener('input', function() {
            updateCounter('planName', 'planNameCounter', 24);
        });

        document.getElementById('planDesc')?.addEventListener('input', function() {
            updateCounter('planDesc', 'planDescCounter', 128);
        });

        // ===== Toggle without reload =====
        async function togglePlan(btn, id) {
            const card = btn.closest('.plan-card');
            if (!card || btn.classList.contains('is-loading')) return;

            btn.classList.add('is-loading');

            try {
                const res = await fetch(`/plans/${id}/toggle`, { method: 'PATCH' });
                const result = await res.json();

                if (!result.success) {
                    toast(result.message || 'خطا', 'error');
                    btn.classList.remove('is-loading');
                    return;
                }

                const wasActive = card.dataset.planActive === '1';
                const isActive = !wasActive;
                card.dataset.planActive = isActive ? '1' : '0';

                // Card opacity (is-inactive)
                card.classList.toggle('is-inactive', !isActive);

                // Update every toggle button inside this card (mobile + desktop)
                card.querySelectorAll('[data-toggle-btn]').forEach(b => {
                    b.classList.remove('toggle-on', 'toggle-off');
                    b.classList.add(isActive ? 'toggle-on' : 'toggle-off');
                    b.title = isActive ? 'غیرفعال کردن' : 'فعال کردن';
                    const icon = b.querySelector('[data-toggle-icon]');
                    if (icon) icon.className = 'bi ' + (isActive ? 'bi-toggle-on' : 'bi-toggle-off');
                });

                // Update status badge text
                card.querySelectorAll('[data-plan-status]').forEach(badge => {
                    badge.classList.remove('active', 'inactive');
                    badge.classList.add(isActive ? 'active' : 'inactive');
                    const txt = badge.querySelector('[data-plan-status-text]');
                    if (txt) txt.textContent = isActive ? 'فعال' : 'غیرفعال';
                });

                // Update plan icon (filled vs outline)
                card.querySelectorAll('[data-plan-icon] i').forEach(icon => {
                    icon.className = 'bi ' + (isActive ? 'bi-award-fill' : 'bi-award');
                });

                toast(result.message || (isActive ? 'پلن فعال شد' : 'پلن غیرفعال شد'), 'success');
                btn.classList.remove('is-loading');
            } catch (err) {
                toast('خطا در ارتباط با سرور', 'error');
                btn.classList.remove('is-loading');
            }
        }

        let deleteId = null;

        function openDeleteModal(btn) {
            const { id, name } = btn.dataset;
            deleteId = id;
            document.getElementById('deleteMsg').textContent = `آیا از حذف پلن "${name}" اطمینان دارید؟ این عمل قابل بازگشت نیست.`;
            openModal('deleteModal');
        }

        document.getElementById('deleteConfirmBtn').addEventListener('click', async function() {
            if (!deleteId) return;

            const btn = this;
            btn.disabled = true;
            btn.textContent = '...';

            try {
                const res = await fetch(`/plans/${deleteId}`, { method: 'DELETE' });
                const result = await res.json();

                if (result.success) {
                    toast(result.message, 'success');
                    closeModal('deleteModal');
                    setTimeout(() => location.reload(), 600);
                } else {
                    toast(result.message || 'خطا', 'error');
                    closeModal('deleteModal');
                }
            } catch (err) {
                toast('خطا در ارتباط با سرور', 'error');
            }

            btn.disabled = false;
            btn.textContent = 'حذف';
            deleteId = null;
        });
    </script>
</body>
</html>