                <span class="badge badge--accent" id="userCountBadge"><%= users.length %></span>
            </h1>
            <p class="page__subtitle">مدیریت و نظارت بر کاربران سیستم</p>
        </header>

        <!-- Search + Filter -->
        <div class="search-bar">
            <div class="search-bar__field">
                <input
                    type="text"
                    id="searchInput"
                    placeholder="جستجوی کاربر..."
                    class="search-bar__input"
                    autocomplete="off"
                    value="<%= filters.search %>"
                    aria-label="جستجوی کاربر"
                />
                <i class="bi bi-search search-bar__icon" aria-hidden="true"></i>

                <div class="search-bar__menu" id="filterMenu" role="menu" aria-label="فیلتر وضعیت">
                    <button
                        type="button"
                        class="search-bar__menu-item search-bar__menu-item--selected"
                        data-value=""
                        onclick="selectFilter(this, '')"
                        role="menuitem"
                    >
                        <span class="search-bar__menu-dot" style="background: transparent; border: 2px solid #4a4a63;"></span>
                        همه وضعیت‌ها
                    </button>
                    <button
                        type="button"
                        class="search-bar__menu-item"
                        data-value="active"
                        onclick="selectFilter(this, 'active')"
                        role="menuitem"
                    >
                        <span class="search-bar__menu-dot" style="background: #34d399;"></span>
                        فعال
                    </button>
                    <button
                        type="button"
                        class="search-bar__menu-item"
                        data-value="suspended"
                        onclick="selectFilter(this, 'suspended')"
                        role="menuitem"
                    >
                        <span class="search-bar__menu-dot" style="background: #fbbf24;"></span>
                        تعلیق
                    </button>
                    <button
                        type="button"
                        class="search-bar__menu-item"
                        data-value="disabled"
                        onclick="selectFilter(this, 'disabled')"
                        role="menuitem"
                    >
                        <span class="search-bar__menu-dot" style="background: #f87171;"></span>
                        غیرفعال
                    </button>
                </div>
            </div>

            <button
                type="button"
                class="search-bar__filter-btn"
                id="filterBtn"
                onclick="toggleFilterMenu()"
                aria-label="فیلتر وضعیت"
                aria-expanded="false"
                aria-controls="filterMenu"
            >
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>فیلتر</span>
            </button>

            <select id="statusFilter" class="search-bar__select" aria-label="فیلتر وضعیت">
                <option value="">همه وضعیت‌ها</option>
                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>فعال</option>
                <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>تعلیق</option>
                <option value="disabled" <%= filters.status === 'disabled' ? 'selected' : '' %>>غیرفعال</option>
            </select>
        </div>

        <!-- Desktop table -->
        <div class="data-table" id="desktopTableWrapper" data-loading="true" aria-busy="true">
            <div class="data-table__inner">
                <div class="js-content">
                    <table class="data-table__table">
                        <thead class="data-table__head">
                            <tr>
                                <th class="data-table__th">کاربر</th>
                                <th class="data-table__th hidden md:table-cell">ایمیل</th>
                                <th class="data-table__th hidden lg:table-cell">باشگاه</th>
                                <th class="data-table__th">نقش</th>
                                <th class="data-table__th">وضعیت</th>
                                <th class="data-table__th hidden sm:table-cell">تاریخ ثبت‌نام</th>
                                <th class="data-table__th" style="text-align: center;">عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <% users.forEach(function(u) { %>
                            <tr class="data-table__row" data-user-id="<%= u._id %>">
                                <td class="data-table__cell">
                                    <div class="data-table__user">
                                        <div class="data-table__avatar">
                                            <%= u.username ? u.username.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                        <span class="data-table__name"><%= u.username %></span>
                                    </div>
                                </td>
                                <td class="data-table__cell data-table__email hidden md:table-cell"><%= u.email %></td>
                                <td class="data-table__cell data-table__email hidden lg:table-cell"><%= u.clubName || '-' %></td>
                                <td class="data-table__cell">
                                    <span class="role-badge role-badge--<%= u.role %>">
                                        <i
                                            class="bi <%= u.role === 'admin' ? 'bi-shield-fill' : u.role === 'moderator' ? 'bi-star-fill' : u.role === 'owner' ? 'bi-crown-fill' : 'bi-person-fill' %>"
                                            style="font-size: 10px;"
                                            aria-hidden="true"
                                        ></i>
                                        <%= u.role === 'admin' ? 'ادمین' : u.role === 'moderator' ? 'مدیر' : u.role === 'owner' ? 'مالک' : 'کاربر' %>
                                    </span>
                                </td>
                                <td class="data-table__cell">
                                    <span class="status-badge status-badge--<%= u.status %>">
                                        <span
                                            class="status-badge__dot"
                                            style="background: <%= u.status === 'active' ? '#34d399' : u.status === 'suspended' ? '#fbbf24' : '#f87171' %>;"
                                        ></span>
                                        <%= u.status === 'active' ? 'فعال' : u.status === 'suspended' ? 'تعلیق' : 'غیرفعال' %>
                                    </span>
                                </td>
                                <td class="data-table__cell data-table__date hidden sm:table-cell">
                                    <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '-' %>
                                </td>
                                <td class="data-table__cell">
                                    <div class="data-table__actions">
                                        <a href="/admin/users/<%= u._id %>" class="action__btn" title="مشاهده" aria-label="مشاهده">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </a>
                                        <button
                                            type="button"
                                            class="action__btn action__btn--promote"
                                            data-user-id="<%= u._id %>"
                                            data-username="<%= u.username %>"
                                            data-role="<%= u.role %>"
                                            title="تغییر نقش"
                                            aria-label="تغییر نقش"
                                        >
                                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                        </button>
                                        <button
                                            type="button"
                                            class="action__btn action__btn--status"
                                            data-user-id="<%= u._id %>"
                                            data-username="<%= u.username %>"
                                            data-status="<%= u.status %>"
                                            title="تغییر وضعیت"
                                            aria-label="تغییر وضعیت"
                                        >
                                            <i class="bi bi-sliders" aria-hidden="true"></i>
                                        </button>
                                        <button
                                            type="button"
                                            class="action__btn action__btn--delete"
                                            data-user-id="<%= u._id %>"
                                            data-username="<%= u.username %>"
                                            title="حذف"
                                            aria-label="حذف"
                                        >
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>

                <div class="js-skeleton" aria-hidden="true">
                    <table class="data-table__table">
                        <thead class="data-table__head">
                            <tr>
                                <th class="data-table__th">کاربر</th>
                                <th class="data-table__th hidden md:table-cell">ایمیل</th>
                                <th class="data-table__th hidden lg:table-cell">باشگاه</th>
                                <th class="data-table__th">نقش</th>
                                <th class="data-table__th">وضعیت</th>
                                <th class="data-table__th hidden sm:table-cell">تاریخ ثبت‌نام</th>
                                <th class="data-table__th" style="text-align: center;">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for (let i = 0; i < 5; i++) { %>
                            <tr class="data-table__row">
                                <td class="data-table__cell">
                                    <div class="data-table__user">
                                        <div class="skeleton skeleton__avatar"></div>
                                        <div class="skeleton skeleton__line skeleton__line--md" style="width: 80px;"></div>
                                    </div>
                                </td>
                                <td class="data-table__cell hidden md:table-cell">
                                    <div class="skeleton skeleton__line skeleton__line--lg" style="width: 120px;"></div>
                                </td>
                                <td class="data-table__cell hidden lg:table-cell">
                                    <div class="skeleton skeleton__line skeleton__line--md" style="width: 80px;"></div>
                                </td>
                                <td class="data-table__cell"><div class="skeleton skeleton__badge"></div></td>
                                <td class="data-table__cell"><div class="skeleton skeleton__badge"></div></td>
                                <td class="data-table__cell hidden sm:table-cell">
                                    <div class="skeleton skeleton__line skeleton__line--md" style="width: 80px;"></div>
                                </td>
                                <td class="data-table__cell">
                                    <div class="data-table__actions">
                                        <div class="skeleton skeleton__action"></div>
                                        <div class="skeleton skeleton__action"></div>
                                        <div class="skeleton skeleton__action"></div>
                                        <div class="skeleton skeleton__action"></div>
                                    </div>
                                </td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Mobile cards -->
        <div class="user-cards" id="mobileCardsWrapper" data-loading="true" aria-busy="true">
            <div class="js-content">
                <% users.forEach(function(u) { %>
                <div class="user-card" data-user-id="<%= u._id %>">
                    <div class="user-card__top">
                        <div class="user-card__info">
                            <div class="user-card__badges">
                                <span class="role-badge role-badge--<%= u.role %>">
                                    <i
                                        class="bi <%= u.role === 'admin' ? 'bi-shield-fill' : u.role === 'moderator' ? 'bi-star-fill' : u.role === 'owner' ? 'bi-crown-fill' : 'bi-person-fill' %>"
                                        style="font-size: 9px;"
                                        aria-hidden="true"
                                    ></i>
                                    <%= u.role === 'admin' ? 'ادمین' : u.role === 'moderator' ? 'مدیر' : u.role === 'owner' ? 'مالک' : 'کاربر' %>
                                </span>
                                <span class="status-badge status-badge--<%= u.status %>">
                                    <span
                                        class="status-badge__dot"
                                        style="background: <%= u.status === 'active' ? '#34d399' : u.status === 'suspended' ? '#fbbf24' : '#f87171' %>;"
                                    ></span>
                                    <%= u.status === 'active' ? 'فعال' : u.status === 'suspended' ? 'تعلیق' : 'غیرفعال' %>
                                </span>
                            </div>
                            <div class="user-card__name"><%= u.username %></div>
                            <div class="user-card__meta">
                                <span><i class="bi bi-envelope" aria-hidden="true"></i> <%= u.email %></span>
                                <span><i class="bi bi-building" aria-hidden="true"></i> <%= u.clubName || '-' %></span>
                                <span>
                                    <i class="bi bi-calendar3" aria-hidden="true"></i>
                                    <%= u.createdAt ? new Date(u.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '-' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="user-card__actions">
                        <a href="/admin/users/<%= u._id %>" class="action__btn" title="مشاهده">
                            <i class="bi bi-eye" aria-hidden="true"></i> مشاهده
                        </a>
                        <button
                            type="button"
                            class="action__btn action__btn--promote"
                            data-user-id="<%= u._id %>"
                            data-username="<%= u.username %>"
                            data-role="<%= u.role %>"
                            title="تغییر نقش"
                        >
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i> نقش
                        </button>
                        <button
                            type="button"
                            class="action__btn action__btn--status"
                            data-user-id="<%= u._id %>"
                            data-username="<%= u.username %>"
                            data-status="<%= u.status %>"
                            title="تغییر وضعیت"
                        >
                            <i class="bi bi-sliders" aria-hidden="true"></i> وضعیت
                        </button>
                        <button
                            type="button"
                            class="action__btn action__btn--delete"
                            data-user-id="<%= u._id %>"
                            data-username="<%= u.username %>"
                            title="حذف"
                        >
                            <i class="bi bi-trash" aria-hidden="true"></i> حذف
                        </button>
                    </div>
                </div>
                <% }); %>
            </div>

            <div class="js-skeleton" aria-hidden="true">
                <% for (let i = 0; i < 3; i++) { %>
                <div class="user-card">
                    <div class="user-card__top">
                        <div class="user-card__info">
                            <div class="user-card__badges">
                                <div class="skeleton skeleton__badge"></div>
                                <div class="skeleton skeleton__badge"></div>
                            </div>
                            <div class="skeleton skeleton__line skeleton__line--title" style="margin-top: 8px;"></div>
                            <div class="skeleton skeleton__line skeleton__line--subtitle"></div>
                        </div>
                    </div>
                    <div class="user-card__actions">
                        <div class="skeleton skeleton__action" style="flex: 1;"></div>
                        <div class="skeleton skeleton__action" style="flex: 1;"></div>
                        <div class="skeleton skeleton__action" style="flex: 1;"></div>
                        <div class="skeleton skeleton__action" style="flex: 1;"></div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div id="emptyState" class="empty-state" style="display: none;">
            <div class="empty-state__icon">
                <i class="bi bi-search" aria-hidden="true"></i>
            </div>
            <h3 class="empty-state__title">نتیجه‌ای یافت نشد</h3>
            <p class="empty-state__desc">هیچ کاربری با این فیلترها پیدا نشد. لطفاً جستجوی خود را تغییر دهید.</p>
            <button type="button" class="empty-state__action" onclick="resetFilters()">
                بازنشانی فیلترها
            </button>
        </div>

        <% if (pagination.totalPages > 1) { %>
        <div class="pagination" id="paginationRoot">
            <div class="pagination__info">
                نمایش <strong><%= (pagination.currentPage - 1) * 20 + 1 %></strong>
                تا <strong><%= Math.min(pagination.currentPage * 20, pagination.totalCount) %></strong>
                از <strong><%= pagination.totalCount %></strong> کاربر
            </div>

            <div class="pagination__controls" id="paginationContainer">
                <button
                    type="button"
                    class="pagination__btn"
                    id="prevPageBtn"
                    <%= pagination.currentPage === 1 ? 'disabled' : '' %>
                    title="صفحه قبلی"
                >
                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>

                <div id="pageNumbers" style="display: flex; align-items: center; gap: 4px;"></div>

                <button
                    type="button"
                    class="pagination__btn"
                    id="nextPageBtn"
                    <%= pagination.currentPage === pagination.totalPages ? 'disabled' : '' %>
                    title="صفحه بعدی"
                >
                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <% } %>
    </main>

    <!-- Role modal -->
    <div class="modal" id="roleModal" role="dialog" aria-modal="true" aria-labelledby="role-title" aria-hidden="true">
        <div class="modal__dialog">
            <button type="button" class="modal__close" onclick="closeModal('roleModal')" aria-label="بستن">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="modal__icon modal__icon--purple" aria-hidden="true">
                <i class="bi bi-arrow-repeat"></i>
            </div>
            <h3 id="role-title" class="modal__title">تغییر نقش کاربر</h3>
            <p class="modal__desc" id="roleModalMsg">انتخاب نقش جدید</p>

            <div class="modal__options">
                <button type="button" class="option" data-role="member">
                    <div class="option__dot"></div>
                    <div class="option__content">
                        <div class="option__label">کاربر</div>
                        <div class="option__desc">دسترسی پایه</div>
                    </div>
                </button>
                <button type="button" class="option" data-role="admin">
                    <div class="option__dot"></div>
                    <div class="option__content">
                        <div class="option__label">ادمین</div>
                        <div class="option__desc">مدیریت کاربران</div>
                    </div>
                </button>
                <button type="button" class="option" data-role="moderator">
                    <div class="option__dot"></div>
                    <div class="option__content">
                        <div class="option__label">مدیر ارشد</div>
                        <div class="option__desc">دسترسی کامل</div>
                    </div>
                </button>
            </div>

            <div class="modal__actions">
                <button type="button" class="modal__btn modal__btn--cancel" onclick="closeModal('roleModal')">انصراف</button>
                <button type="button" id="roleConfirmBtn" class="modal__btn modal__btn--confirm" disabled>تأیید</button>
            </div>
        </div>
    </div>

    <!-- Status modal -->
    <div class="modal" id="statusModal" role="dialog" aria-modal="true" aria-labelledby="status-title" aria-hidden="true">
        <div class="modal__dialog">
            <button type="button" class="modal__close" onclick="closeModal('statusModal')" aria-label="بستن">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="modal__icon modal__icon--amber" aria-hidden="true">
                <i class="bi bi-sliders"></i>
            </div>
            <h3 id="status-title" class="modal__title">تغییر وضعیت کاربر</h3>
            <p class="modal__desc" id="statusModalMsg">انتخاب وضعیت جدید</p>

            <div class="modal__options">
                <button type="button" class="option" data-status="active">
                    <div class="option__dot" style="background: #34d399;"></div>
                    <div class="option__content">
                        <div class="option__label">فعال</div>
                        <div class="option__desc">دسترسی کامل به حساب</div>
                    </div>
                </button>
                <button type="button" class="option" data-status="suspended">
                    <div class="option__dot" style="background: #fbbf24;"></div>
                    <div class="option__content">
                        <div class="option__label">تعلیق</div>
                        <div class="option__desc">محدودیت موقت</div>
                    </div>
                </button>
                <button type="button" class="option" data-status="disabled">
                    <div class="option__dot" style="background: #f87171;"></div>
                    <div class="option__content">
                        <div class="option__label">غیرفعال</div>
                        <div class="option__desc">مسدود شدن کامل حساب</div>
                    </div>
                </button>
            </div>

            <div class="modal__actions">
                <button type="button" class="modal__btn modal__btn--cancel" onclick="closeModal('statusModal')">انصراف</button>
                <button type="button" id="statusConfirmBtn" class="modal__btn modal__btn--confirm" disabled>تأیید</button>
            </div>
        </div>
    </div>

    <!-- Delete modal -->
    <div class="modal" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="delete-title" aria-hidden="true">
        <div class="modal__dialog">
            <button type="button" class="modal__close" onclick="closeModal('deleteModal')" aria-label="بستن">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="modal__icon modal__icon--red" aria-hidden="true">
                <i class="bi bi-trash"></i>
            </div>
            <h3 id="delete-title" class="modal__title">حذف کاربر</h3>
            <p class="modal__desc" id="deleteMsg">
                آیا از حذف این کاربر و تمام داده‌هایش اطمینان دارید؟ این عمل قابل بازگشت نیست.
            </p>

            <div class="modal__actions">
                <button type="button" class="modal__btn modal__btn--cancel" onclick="closeModal('deleteModal')">انصراف</button>
                <button type="button" id="deleteConfirmBtn" class="modal__btn modal__btn--danger">حذف</button>
            </div>
        </div>
    </div>

    <!-- Logout modal -->
    <div class="modal" id="logoutModal" role="dialog" aria-modal="true" aria-labelledby="logout-title" aria-hidden="true">
        <div class="modal__dialog">
            <button type="button" class="modal__close" onclick="closeModal('logoutModal')" aria-label="بستن">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="modal__icon modal__icon--red" aria-hidden="true">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <h3 id="logout-title" class="modal__title">خروج از حساب</h3>
            <p class="modal__desc">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>

            <div class="modal__actions">
                <button type="button" class="modal__btn modal__btn--cancel" onclick="closeModal('logoutModal')">انصراف</button>
                <a href="/auth/logout" class="modal__btn modal__btn--danger">خروج</a>
            </div>
        </div>
    </div>

    <div id="toast" class="toast" style="display: none;" role="status" aria-live="polite"></div>

    <script>
        let lastFocusedElement = null;

        // Open sidebar
        function openSidebar() {
            lastFocusedElement = document.activeElement;
            var sidebar = document.getElementById('sidebar');
            var menuBtn = document.getElementById('menuBtn');
            var overlay = document.getElementById('sidebarOverlay');
            if (!sidebar) return;
            sidebar.classList.add('sidebar--open');
            sidebar.setAttribute('aria-hidden', 'false');
            if (overlay) {
                overlay.classList.add('sidebar-overlay--active');
                overlay.setAttribute('aria-hidden', 'false');
            }
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        // Close sidebar
        function closeSidebar() {
            var sidebar = document.getElementById('sidebar');
            var menuBtn = document.getElementById('menuBtn');
            var overlay = document.getElementById('sidebarOverlay');
            if (!sidebar) return;
            sidebar.classList.remove('sidebar--open');
            sidebar.setAttribute('aria-hidden', 'true');
            if (overlay) {
                overlay.classList.remove('sidebar-overlay--active');
                overlay.setAttribute('aria-hidden', 'true');
            }
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
            if (lastFocusedElement && lastFocusedElement.focus) lastFocusedElement.focus();
        }

        // Open modal
        function openModal(id) {
            lastFocusedElement = document.activeElement;
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.add('modal--active');
            el.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(function() {
                var first = el.querySelector('button, a');
                if (first) first.focus();
            });
        }

        // Close modal
        function closeModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('modal--active');
            el.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
            if (lastFocusedElement && lastFocusedElement.focus) lastFocusedElement.focus();
        }

        // Open logout modal
        function openLogoutModal() {
            closeSidebar();
            openModal('logoutModal');
        }

        function toast(msg, type) {
            var t = document.getElementById('toast');
            if (!t) return;
            t.textContent = msg;
            t.style.display = 'block';
            t.className = 'toast';
            if (type === 'success') t.classList.add('toast--success');
            else if (type === 'error') t.classList.add('toast--error');
            clearTimeout(t._t);
            t._t = setTimeout(function() {
                t.style.display = 'none';
            }, 3000);
        }

        var currentPage = <%= pagination.currentPage %>;
        var totalPages = <%= pagination.totalPages %>;
        var currentSearch = '<%= filters.search %>';
        var currentStatus = '<%= filters.status %>';
        var isLoading = false;

        // Toggle filter menu
        function toggleFilterMenu() {
            var menu = document.getElementById('filterMenu');
            var btn = document.getElementById('filterBtn');
            if (!menu || !btn) return;
            var isOpen = menu.classList.contains('search-bar__menu--open');
            menu.classList.toggle('search-bar__menu--open', !isOpen);
            btn.classList.toggle('search-bar__filter-btn--active', !isOpen);
            btn.setAttribute('aria-expanded', String(!isOpen));
        }

        // Close filter menu
        function closeFilterMenu() {
            var menu = document.getElementById('filterMenu');
            var btn = document.getElementById('filterBtn');
            if (menu) menu.classList.remove('search-bar__menu--open');
            if (btn) {
                btn.classList.remove('search-bar__filter-btn--active');
                btn.setAttribute('aria-expanded', 'false');
            }
        }

        // Select filter
        function selectFilter(el, value) {
            document.querySelectorAll('.search-bar__menu-item').forEach(function(item) {
                item.classList.remove('search-bar__menu-item--selected');
            });
            el.classList.add('search-bar__menu-item--selected');

            currentStatus = value;
            closeFilterMenu();

            var statusFilter = document.getElementById('statusFilter');
            if (statusFilter) statusFilter.value = value;

            fetchUsers(1, currentSearch, currentStatus);
        }

        // Reset filters
        function resetFilters() {
            var searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = '';
            currentSearch = '';
            currentStatus = '';

            var statusFilter = document.getElementById('statusFilter');
            if (statusFilter) statusFilter.value = '';

            document.querySelectorAll('.search-bar__menu-item').forEach(function(item) {
                item.classList.toggle('search-bar__menu-item--selected', item.dataset.value === '');
            });

            fetchUsers(1, '', '');
        }

        // Global listeners
        document.addEventListener('DOMContentLoaded', function() {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');

            // overlay click -> close sidebar
            if (overlay) {
                overlay.addEventListener('click', closeSidebar);
            }

            // sidebar link click -> close sidebar (then navigate)
            if (sidebar) {
                sidebar.addEventListener('click', function(e) {
                    if (e.target.closest('a[href]')) closeSidebar();
                });
            }

            // Close modals on backdrop click
            document.querySelectorAll('.modal').forEach(function(overlayEl) {
                overlayEl.addEventListener('click', function(e) {
                    if (e.target === this) {
                        this.classList.remove('modal--active');
                        this.setAttribute('aria-hidden', 'true');
                        document.body.style.overflow = '';
                    }
                });
            });

            // Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    closeSidebar();
                    closeFilterMenu();
                    document.querySelectorAll('.modal.modal--active').forEach(function(m) {
                        m.classList.remove('modal--active');
                        m.setAttribute('aria-hidden', 'true');
                    });
                    document.body.style.overflow = '';
                }
            });

            // Close filter menu on outside click
            document.addEventListener('click', function(e) {
                var menu = document.getElementById('filterMenu');
                var btn = document.getElementById('filterBtn');
                if (!menu || !menu.classList.contains('search-bar__menu--open')) return;
                if (menu.contains(e.target)) return;
                if (btn && btn.contains(e.target)) return;
                closeFilterMenu();
            });

            // Status select change
            var statusFilter = document.getElementById('statusFilter');
            if (statusFilter) {
                statusFilter.addEventListener('change', function() {
                    currentStatus = this.value;
                    document.querySelectorAll('.search-bar__menu-item').forEach(function(item) {
                        item.classList.toggle('search-bar__menu-item--selected', item.dataset.value === currentStatus);
                    });
                    fetchUsers(1, currentSearch, currentStatus);
                });
            }

            // Reveal skeleton
            setTimeout(function() {
                var wrappers = ['desktopTableWrapper', 'mobileCardsWrapper'];
                wrappers.forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el && el.querySelector('.js-content')) {
                        el.setAttribute('data-loading', 'false');
                        el.setAttribute('aria-busy', 'false');
                    }
                });
            }, 400);
        });

        function renderUsers(users) {
            var tbody = document.getElementById('usersTableBody');
            var mobileWrapper = document.getElementById('mobileCardsWrapper');
            var emptyState = document.getElementById('emptyState');
            var badge = document.getElementById('userCountBadge');

            if (badge) badge.textContent = users.length;

            if (users.length === 0) {
                if (tbody) tbody.innerHTML = '';
                var mc = mobileWrapper ? mobileWrapper.querySelector('.js-content') : null;
                if (mc) mc.innerHTML = '';
                if (emptyState) emptyState.style.display = 'block';
                return;
            }

            if (emptyState) emptyState.style.display = 'none';

            if (tbody) {
                tbody.innerHTML = '';
                users.forEach(function(u) {
                    var roleLabel =
                        u.role === 'admin' ? 'ادمین' :
                        u.role === 'moderator' ? 'مدیر ارشد' :
                        u.role === 'owner' ? 'مالک' :
                        'کاربر';
                    var roleIcon =
                        u.role === 'admin' ? 'bi-shield-fill' :
                        u.role === 'moderator' ? 'bi-star-fill' :
                        u.role === 'owner' ? 'bi-crown-fill' :
                        'bi-person-fill';
                    var statusLabel = u.status === 'active' ? 'فعال' : u.status === 'suspended' ? 'تعلیق' : 'غیرفعال';
                    var statusColor = u.status === 'active' ? '#34d399' : u.status === 'suspended' ? '#fbbf24' : '#f87171';

                    var tr = document.createElement('tr');
                    tr.className = 'data-table__row';
                    tr.dataset.userId = u._id;
                    tr.innerHTML =
                        '<td class="data-table__cell"><div class="data-table__user"><div class="data-table__avatar">' +
                        (u.username ? u.username.charAt(0).toUpperCase() : '?') +
                        '</div><span class="data-table__name">' + u.username + '</span></div></td>' +
                        '<td class="data-table__cell data-table__email hidden md:table-cell">' + u.email + '</td>' +
                        '<td class="data-table__cell data-table__email hidden lg:table-cell">' + (u.clubName || '-') + '</td>' +
                        '<td class="data-table__cell"><span class="role-badge role-badge--' + u.role + '"><i class="bi ' +
                        roleIcon + '" style="font-size: 10px;"></i>' + roleLabel + '</span></td>' +
                        '<td class="data-table__cell"><span class="status-badge status-badge--' + u.status + '"><span class="status-badge__dot" style="background: ' +
                        statusColor + ';"></span>' + statusLabel + '</span></td>' +
                        '<td class="data-table__cell data-table__date hidden sm:table-cell">' +
                        (u.createdAt ? new Date(u.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '-') +
                        '</td>' +
                        '<td class="data-table__cell"><div class="data-table__actions">' +
                        '<a href="/admin/users/' + u._id + '" class="action__btn" title="مشاهده"><i class="bi bi-eye"></i></a>' +
                        '<button type="button" class="action__btn action__btn--promote" data-user-id="' + u._id + '" data-username="' + u.username + '" data-role="' + u.role + '" title="تغییر نقش"><i class="bi bi-arrow-repeat"></i></button>' +
                        '<button type="button" class="action__btn action__btn--status" data-user-id="' + u._id + '" data-username="' + u.username + '" data-status="' + u.status + '" title="تغییر وضعیت"><i class="bi bi-sliders"></i></button>' +
                        '<button type="button" class="action__btn action__btn--delete" data-user-id="' + u._id + '" data-username="' + u.username + '" title="حذف"><i class="bi bi-trash"></i></button>' +
                        '</div></td>';
                    tbody.appendChild(tr);
                });
            }

            if (mobileWrapper) {
                var content = mobileWrapper.querySelector('.js-content');
                if (content) {
                    content.innerHTML = '';
                    users.forEach(function(u) {
                        var roleLabel =
                            u.role === 'admin' ? 'ادمین' :
                            u.role === 'moderator' ? 'مدیر ارشد' :
                            u.role === 'owner' ? 'مالک' :
                            'کاربر';
                        var roleIcon =
                            u.role === 'admin' ? 'bi-shield-fill' :
                            u.role === 'moderator' ? 'bi-star-fill' :
                            u.role === 'owner' ? 'bi-crown-fill' :
                            'bi-person-fill';
                        var statusLabel = u.status === 'active' ? 'فعال' : u.status === 'suspended' ? 'تعلیق' : 'غیرفعال';
                        var statusColor = u.status === 'active' ? '#34d399' : u.status === 'suspended' ? '#fbbf24' : '#f87171';

                        var card = document.createElement('div');
                        card.className = 'user-card';
                        card.dataset.userId = u._id;
                        card.innerHTML =
                            '<div class="user-card__top"><div class="user-card__info"><div class="user-card__badges">' +
                            '<span class="role-badge role-badge--' + u.role + '"><i class="bi ' +
                            roleIcon + '" style="font-size: 9px;"></i>' + roleLabel + '</span>' +
                            '<span class="status-badge status-badge--' + u.status + '"><span class="status-badge__dot" style="background: ' +
                            statusColor + ';"></span>' + statusLabel + '</span></div>' +
                            '<div class="user-card__name">' + u.username + '</div>' +
                            '<div class="user-card__meta"><span><i class="bi bi-envelope"></i> ' + u.email +
                            '</span><span><i class="bi bi-building"></i> ' + (u.clubName || '-') +
                            '</span><span><i class="bi bi-calendar3"></i> ' +
                            (u.createdAt ? new Date(u.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '-') +
                            '</span></div></div></div>' +
                            '<div class="user-card__actions">' +
                            '<a href="/admin/users/' + u._id + '" class="action__btn" title="مشاهده"><i class="bi bi-eye"></i> مشاهده</a>' +
                            '<button type="button" class="action__btn action__btn--promote" data-user-id="' + u._id + '" data-username="' + u.username + '" data-role="' + u.role + '" title="تغییر نقش"><i class="bi bi-arrow-repeat"></i> نقش</button>' +
                            '<button type="button" class="action__btn action__btn--status" data-user-id="' + u._id + '" data-username="' + u.username + '" data-status="' + u.status + '" title="تغییر وضعیت"><i class="bi bi-sliders"></i> وضعیت</button>' +
                            '<button type="button" class="action__btn action__btn--delete" data-user-id="' + u._id + '" data-username="' + u.username + '" title="حذف"><i class="bi bi-trash"></i> حذف</button>' +
                            '</div>';
                        content.appendChild(card);
                    });
                }
            }
        }

        function updatePagination(pagination) {
            var container = document.getElementById('paginationContainer');
            var paginationRoot = document.getElementById('paginationRoot') || (container ? container.closest('.pagination') : null);
            if (!container) return;

            currentPage = pagination.currentPage || 1;
            totalPages = pagination.totalPages || 1;

            var pageNumbers = document.getElementById('pageNumbers');
            var prevBtn = document.getElementById('prevPageBtn');
            var nextBtn = document.getElementById('nextPageBtn');

            if (paginationRoot) {
                paginationRoot.style.display = totalPages > 1 ? '' : 'none';
            }

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;

            if (!pageNumbers) return;

            if (totalPages <= 1) {
                pageNumbers.innerHTML = '';
                return;
            }

            var total = totalPages;
            var current = currentPage;
            var html = '';

            if (total <= 7) {
                for (var i = 1; i <= total; i++) {
                    html += '<button type="button" class="pagination__btn' +
                        (i === current ? ' pagination__btn--active' : '') +
                        '" data-page="' + i + '">' + i + '</button>';
                }
            } else if (current <= 3) {
                for (var i = 1; i <= 5; i++) {
                    html += '<button type="button" class="pagination__btn' +
                        (i === current ? ' pagination__btn--active' : '') +
                        '" data-page="' + i + '">' + i + '</button>';
                }
                html += '<span class="pagination__dots">...</span>';
                html += '<button type="button" class="pagination__btn" data-page="' + total + '">' + total + '</button>';
            } else if (current >= total - 2) {
                html += '<button type="button" class="pagination__btn" data-page="1">1</button>';
                html += '<span class="pagination__dots">...</span>';
                for (var i = total - 4; i <= total; i++) {
                    html += '<button type="button" class="pagination__btn' +
                        (i === current ? ' pagination__btn--active' : '') +
                        '" data-page="' + i + '">' + i + '</button>';
                }
            } else {
                html += '<button type="button" class="pagination__btn" data-page="1">1</button>';
                html += '<span class="pagination__dots">...</span>';
                for (var i = current - 1; i <= current + 1; i++) {
                    html += '<button type="button" class="pagination__btn' +
                        (i === current ? ' pagination__btn--active' : '') +
                        '" data-page="' + i + '">' + i + '</button>';
                }
                html += '<span class="pagination__dots">...</span>';
                html += '<button type="button" class="pagination__btn" data-page="' + total + '">' + total + '</button>';
            }

            pageNumbers.innerHTML = html;
        }

        function debounce(fn, delay) {
            var timer;
            return function() {
                var args = arguments;
                clearTimeout(timer);
                timer = setTimeout(function() {
                    fn.apply(null, args);
                }, delay);
            };
        }

        async function fetchUsers(page, search, status) {
            page = page || 1;
            search = search || '';
            status = status || '';

            if (isLoading) return;
            isLoading = true;

            var wrappers = ['desktopTableWrapper', 'mobileCardsWrapper'];
            wrappers.forEach(function(id) {
                var el = document.getElementById(id);
                if (el) {
                    el.setAttribute('data-loading', 'true');
                    el.setAttribute('aria-busy', 'true');
                }
            });

            try {
                var params = new URLSearchParams({ page: page, search: search, status: status });
                var res = await fetch('/admin/users?' + params.toString(), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var data = await res.json();

                if (data.success) {
                    renderUsers(data.data);
                    updatePagination(data.pagination);
                }
            } catch (e) {
                toast('خطا در بارگذاری کاربران', 'error');
            } finally {
                wrappers.forEach(function(id) {
                    var el = document.getElementById(id);
                    if (el) {
                        el.setAttribute('data-loading', 'false');
                        el.setAttribute('aria-busy', 'false');
                    }
                });
                isLoading = false;
            }
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages || page === currentPage || isLoading) return;
            fetchUsers(page, currentSearch, currentStatus);
        }

        document.addEventListener('DOMContentLoaded', function() {
            var searchInput = document.getElementById('searchInput');

            var debouncedSearch = debounce(function() {
                currentSearch = searchInput ? searchInput.value.trim() : '';
                fetchUsers(1, currentSearch, currentStatus);
            }, 400);

            if (searchInput) searchInput.addEventListener('input', debouncedSearch);

            var pageNumbers = document.getElementById('pageNumbers');
            if (pageNumbers) {
                pageNumbers.addEventListener('click', function(e) {
                    var btn = e.target.closest('button');
                    if (btn && btn.dataset.page) {
                        goToPage(parseInt(btn.dataset.page));
                    }
                });
            }

            var prevBtn = document.getElementById('prevPageBtn');
            var nextBtn = document.getElementById('nextPageBtn');
            if (prevBtn) prevBtn.addEventListener('click', function() { goToPage(currentPage - 1); });
            if (nextBtn) nextBtn.addEventListener('click', function() { goToPage(currentPage + 1); });

            // Role modal
            var selectedRole = null;
            var roleData = null;

            document.querySelectorAll('#roleModal .option').forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var role = this.dataset.role;
                    selectedRole = role;
                    document.querySelectorAll('#roleModal .option').forEach(function(o) {
                        o.classList.toggle('option--selected', o.dataset.role === role);
                    });
                    var btn = document.getElementById('roleConfirmBtn');
                    if (btn) btn.disabled = false;
                });
            });

            document.getElementById('roleConfirmBtn').addEventListener('click', async function() {
                if (!roleData || !selectedRole) return;
                var btn = this;
                var originalHTML = btn.innerHTML;
                btn.innerHTML = '<span class="btn-spinner"></span>';
                btn.disabled = true;

                try {
                    var res = await fetch('/admin/users/' + roleData.userId + '/role', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ role: selectedRole })
                    });
                    var data = await res.json();
                    if (res.ok) {
                        toast(data.message || 'نقش کاربر تغییر کرد', 'success');
                        setTimeout(function() { location.reload(); }, 600);
                    } else {
                        toast(data.message || data.error || 'خطا در تغییر نقش', 'error');
                        closeModal('roleModal');
                    }
                } catch (e) {
                    toast('خطا در ارتباط با سرور', 'error');
                }

                btn.innerHTML = originalHTML;
                btn.disabled = false;
            });

            function openRoleModal(userId, username, currentRole) {
                roleData = { userId: userId, username: username, currentRole: currentRole };
                selectedRole = currentRole;

                document.querySelectorAll('#roleModal .option').forEach(function(opt) {
                    var isCurrent = opt.dataset.role === currentRole;
                    opt.classList.toggle('option--selected', isCurrent);
                    opt.classList.remove('option--disabled');
                    opt.setAttribute('aria-checked', isCurrent ? 'true' : 'false');
                });

                var msgEl = document.getElementById('roleModalMsg');
                if (msgEl) msgEl.textContent = 'انتخاب نقش جدید برای "' + username + '"';

                var btn = document.getElementById('roleConfirmBtn');
                if (btn) btn.disabled = false;

                openModal('roleModal');
            }

            // Status modal
            var selectedStatus = null;
            var statusData = null;

            document.querySelectorAll('#statusModal .option').forEach(function(opt) {
                opt.addEventListener('click', function() {
                    var status = this.dataset.status;
                    selectedStatus = status;
                    document.querySelectorAll('#statusModal .option').forEach(function(o) {
                        o.classList.toggle('option--selected', o.dataset.status === status);
                    });
                    var btn = document.getElementById('statusConfirmBtn');
                    if (btn) btn.disabled = false;
                });
            });

            document.getElementById('statusConfirmBtn').addEventListener('click', async function() {
                if (!statusData || !selectedStatus) return;
                var btn = this;
                var originalHTML = btn.innerHTML;
                btn.innerHTML = '<span class="btn-spinner"></span>';
                btn.disabled = true;

                try {
                    var res = await fetch('/admin/users/' + statusData.userId + '/status', {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: selectedStatus })
                    });
                    var data = await res.json();
                    if (res.ok) {
                        toast(data.message || 'وضعیت کاربر تغییر کرد', 'success');
                        setTimeout(function() { location.reload(); }, 600);
                    } else {
                        toast(data.message || data.error || 'خطا در تغییر وضعیت', 'error');
                        closeModal('statusModal');
                    }
                } catch (e) {
                    toast('خطا در ارتباط با سرور', 'error');
                }

                btn.innerHTML = originalHTML;
                btn.disabled = false;
            });

            function openStatusModal(userId, username, currentStatus) {
                statusData = { userId: userId, username: username, currentStatus: currentStatus };
                selectedStatus = currentStatus;

                document.querySelectorAll('#statusModal .option').forEach(function(opt) {
                    var isCurrent = opt.dataset.status === currentStatus;
                    opt.classList.toggle('option--selected', isCurrent);
                    opt.classList.remove('option--disabled');
                });

                var msgEl = document.getElementById('statusModalMsg');
                if (msgEl) msgEl.textContent = 'انتخاب وضعیت جدید برای "' + username + '"';
                var btn = document.getElementById('statusConfirmBtn');
                if (btn) btn.disabled = false;

                openModal('statusModal');
            }

            // Delete modal
            var deleteId = null;

            document.getElementById('deleteConfirmBtn').addEventListener('click', async function() {
                if (!deleteId) return;
                var btn = this;
                var originalHTML = btn.innerHTML;
                btn.innerHTML = '<span class="btn-spinner"></span> در حال حذف...';
                btn.disabled = true;

                try {
                    var res = await fetch('/admin/users/' + deleteId, { method: 'DELETE' });
                    var data = await res.json();
                    if (res.ok) {
                        toast(data.message || 'کاربر حذف شد', 'success');
                        setTimeout(function() { location.reload(); }, 600);
                    } else {
                        toast(data.message || data.error || 'خطا در حذف کاربر', 'error');
                        closeModal('deleteModal');
                    }
                } catch (e) {
                    toast('خطا در ارتباط با سرور', 'error');
                }

                btn.innerHTML = originalHTML;
                btn.disabled = false;
                deleteId = null;
            });

            function openDeleteModal(userId, username) {
                deleteId = userId;
                var msgEl = document.getElementById('deleteMsg');
                if (msgEl) {
                    msgEl.textContent =
                        'آیا از حذف کاربر "' + username + '" و تمام داده‌هایش اطمینان دارید؟ این عمل قابل بازگشت نیست.';
                }
                openModal('deleteModal');
            }

            // Event delegation - table
            var tbody = document.getElementById('usersTableBody');
            if (tbody) {
                tbody.addEventListener('click', function(e) {
                    var btn = e.target.closest('button');
                    if (!btn) return;

                    if (btn.classList.contains('action__btn--promote')) {
                        openRoleModal(btn.dataset.userId, btn.dataset.username, btn.dataset.role);
                    } else if (btn.classList.contains('action__btn--status')) {
                        openStatusModal(btn.dataset.userId, btn.dataset.username, btn.dataset.status);
                    } else if (btn.classList.contains('action__btn--delete')) {
                        openDeleteModal(btn.dataset.userId, btn.dataset.username);
                    }
                });
            }

            // Event delegation - mobile cards
            var mobileWrapper = document.getElementById('mobileCardsWrapper');
            if (mobileWrapper) {
                mobileWrapper.addEventListener('click', function(e) {
                    var btn = e.target.closest('button');
                    if (!btn) return;

                    if (btn.classList.contains('action__btn--promote')) {
                        openRoleModal(btn.dataset.userId, btn.dataset.username, btn.dataset.role);
                    } else if (btn.classList.contains('action__btn--status')) {
                        openStatusModal(btn.dataset.userId, btn.dataset.username, btn.dataset.status);
                    } else if (btn.classList.contains('action__btn--delete')) {
                        openDeleteModal(btn.dataset.userId, btn.dataset.username);
                    }
                });
            }

            updatePagination({ currentPage: currentPage, totalPages: totalPages });
        });
    </script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="/realtime.js" defer></script>
</body>
</html>