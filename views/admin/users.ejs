<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050508" />
    <meta name="color-scheme" content="dark" />
    <title>مدیریت کاربران | فاکتوریتو</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { 'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'] },
                    colors: {
                        'ink': {
                            950: '#050508', 900: '#0a0a12', 800: '#0f0f1a',
                            700: '#151522', 600: '#1a1a2e', 500: '#22223a', 400: '#2a2a46'
                        },
                        'accent': {
                            400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9'
                        },
                    },
                }
            }
        }
    </script>

    <style>
        :root {
            --color-bg: #050508;
            --color-surface: #0f0f1a;
            --color-surface-elevated: #14141f;
            --color-border: rgba(167, 139, 250, 0.06);
            --color-border-strong: rgba(167, 139, 250, 0.15);
            --color-accent: #a78bfa;
            --color-accent-strong: #7c3aed;
            --color-accent-soft: rgba(167, 139, 250, 0.06);
            --color-accent-soft-hover: rgba(167, 139, 250, 0.12);
            --color-text-primary: #e5e7eb;
            --color-text-secondary: #9ca3af;
            --color-text-muted: #6b7280;
            --color-danger: #f87171;
            --color-danger-soft: rgba(239, 68, 68, 0.06);
            --color-danger-soft-hover: rgba(239, 68, 68, 0.12);
            --color-success: #34d399;
            --color-success-soft: rgba(52, 211, 153, 0.08);
            --color-warning: #fbbf24;
            --color-warning-soft: rgba(251, 191, 36, 0.08);

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;

            --duration-fast: 150ms;
            --duration-base: 250ms;
            --duration-slow: 400ms;
            --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        *,
        *::before,
        *::after {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            -webkit-text-size-adjust: 100%;
            text-rendering: optimizeLegibility;
        }

        body {
            background: var(--color-bg);
            color: var(--color-text-secondary);
            line-height: 1.8;
            font-weight: 400;
            overflow-x: hidden;
            min-height: 100dvh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--color-bg); }
        ::-webkit-scrollbar-thumb { background: var(--color-surface); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #2a2a46; }

        :focus-visible {
            outline: 2px solid var(--color-accent);
            outline-offset: 2px;
            border-radius: 6px;
        }

        .skip-link {
            position: absolute;
            top: -100px;
            right: 16px;
            background: var(--color-accent-strong);
            color: #fff;
            padding: 12px 20px;
            border-radius: var(--radius-md);
            z-index: 9999;
            text-decoration: none;
            font-weight: 700;
            transition: top var(--duration-fast) ease;
        }
        .skip-link:focus {
            top: 16px;
            outline: 2px solid var(--color-accent);
            outline-offset: 2px;
        }

        .u-visually-hidden {
            position: absolute !important;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        /* Block: sidebar overlay */
        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 90;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity var(--duration-slow) var(--ease-out),
                        visibility var(--duration-slow) var(--ease-out);
        }
        .sidebar-overlay--active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        /* Block: sidebar */
        .sidebar {
            position: fixed;
            top: 16px;
            right: 16px;
            bottom: 16px;
            width: 280px;
            max-width: calc(100vw - 32px);
            background: rgba(10, 10, 18, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--color-border-strong);
            border-radius: 24px;
            box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.85);
            z-index: 110;
            padding: 20px;
            overflow-y: auto;
            transform: translateX(calc(100% + 32px));
            visibility: hidden;
            pointer-events: none;
            transition: transform var(--duration-slow) var(--ease-out),
                        visibility var(--duration-slow) var(--ease-out);
            scrollbar-width: none;
            -ms-overflow-style: none;
            will-change: transform;
            contain: layout style;
        }
        .sidebar::-webkit-scrollbar { display: none; width: 0; }
        .sidebar--open {
            transform: translateX(0);
            visibility: visible;
            pointer-events: auto;
        }
        @media (max-width: 480px) {
            .sidebar {
                top: 12px;
                right: 12px;
                bottom: 12px;
                width: calc(100vw - 24px);
                max-width: 280px;
            }
        }

        .sidebar__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-border);
            margin-bottom: 20px;
        }

        .sidebar__brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sidebar__logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
        }

        .sidebar__title {
            font-weight: 800;
            font-size: 18px;
            color: #fff;
        }

        .sidebar__close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
            font-size: 18px;
            flex-shrink: 0;
            font-family: inherit;
        }
        .sidebar__close:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .sidebar__nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar__link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: var(--color-text-secondary);
            font-size: 14px;
            font-weight: 500;
            transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
            text-decoration: none;
            min-height: 44px;
            width: 100%;
            text-align: right;
            font-family: inherit;
            cursor: pointer;
        }
        .sidebar__link:hover {
            background: var(--color-accent-soft);
            color: #c4b5fd;
        }
        .sidebar__link--active {
            background: rgba(167, 139, 250, 0.08);
            color: var(--color-accent);
        }

        .sidebar__link-icon {
            font-size: 18px;
            width: 22px;
            text-align: center;
            color: var(--color-text-muted);
            flex-shrink: 0;
        }
        .sidebar__link--active .sidebar__link-icon {
            color: var(--color-accent);
        }

        .sidebar__link--danger { color: var(--color-danger); }
        .sidebar__link--danger .sidebar__link-icon { color: var(--color-danger); }

        .sidebar__divider {
            height: 1px;
            background: var(--color-border);
            margin: 8px 12px;
        }

        /* Block: nav */
        .nav {
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            z-index: 30;
            padding: 12px;
        }
        @media (min-width: 769px) {
            .nav { padding: 20px 24px; }
        }

        .nav__container {
            max-width: 72rem;
            margin: 0 auto;
            background: rgba(10, 10, 18, 0.9);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        @media (min-width: 769px) {
            .nav__container {
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                padding: 12px 24px;
            }
        }

        .nav__brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            flex-shrink: 0;
            min-width: 0;
        }

        .nav__logo {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 14px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
            transition: transform var(--duration-base) var(--ease-out);
        }
        .nav__brand:hover .nav__logo { transform: scale(1.05); }
        @media (min-width: 769px) {
            .nav__logo { width: 36px; height: 36px; font-size: 16px; }
        }

        .nav__title {
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            letter-spacing: -0.02em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        @media (min-width: 769px) {
            .nav__title { font-size: 18px; }
        }

        .nav__mobile {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }
        @media (min-width: 769px) {
            .nav__mobile { display: none; }
        }

        .nav__icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 10px;
            color: var(--color-text-primary);
            cursor: pointer;
            transition: background-color var(--duration-base) ease, color var(--duration-base) ease;
            font-size: 18px;
            font-family: inherit;
        }
        .nav__icon-btn:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .nav__icon-btn--danger {
            color: var(--color-danger);
            background: var(--color-danger-soft);
            border-color: rgba(239, 68, 68, 0.1);
        }
        .nav__icon-btn--danger:hover {
            background: var(--color-danger-soft-hover);
            color: #fca5a5;
        }

        .nav__links {
            display: none;
            align-items: center;
            gap: 4px;
        }
        @media (min-width: 769px) {
            .nav__links { display: flex; }
        }

        .nav__link {
            color: var(--color-text-secondary);
            font-size: 13px;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 10px;
            transition: color var(--duration-base) ease, background-color var(--duration-base) ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
            min-height: 40px;
        }
        .nav__link::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 2px;
            height: 0;
            background: var(--color-accent);
            border-radius: 2px;
            transition: height var(--duration-base) ease;
        }
        .nav__link:hover {
            color: var(--color-text-primary);
            background: var(--color-accent-soft);
        }
        .nav__link--active {
            color: var(--color-accent);
            background: var(--color-accent-soft);
        }
        .nav__link--active::before { height: 24px; }

        .nav__divider {
            width: 1px;
            height: 24px;
            background: rgba(255, 255, 255, 0.05);
            margin: 0 8px;
        }

        .nav__logout {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: var(--color-danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.1);
            border-radius: 10px;
            color: var(--color-danger);
            font-size: 13px;
            font-weight: 600;
            transition: background-color var(--duration-base) ease,
                        border-color var(--duration-base) ease,
                        color var(--duration-base) ease;
            cursor: pointer;
            min-height: 40px;
            font-family: inherit;
        }
        .nav__logout:hover {
            background: var(--color-danger-soft-hover);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        /* Block: page */
        .page {
            max-width: 72rem;
            margin: 0 auto;
            padding: 76px 12px 48px;
        }
        @media (min-width: 769px) {
            .page { padding: 112px 16px 64px; }
        }

        .page__header { margin-bottom: 24px; }
        @media (min-width: 769px) {
            .page__header { margin-bottom: 40px; }
        }

        .page__title {
            font-size: 22px;
            font-weight: 900;
            color: #fff;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        @media (min-width: 769px) { .page__title { font-size: 30px; } }
        @media (min-width: 1025px) { .page__title { font-size: 36px; } }

        .page__title-accent {
            background: linear-gradient(90deg, var(--color-accent), var(--color-accent-strong));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .page__subtitle {
            font-size: 12px;
            color: var(--color-text-muted);
        }
        @media (min-width: 769px) {
            .page__subtitle { font-size: 14px; }
        }

        /* Block: search-bar — responsive */
        .search-bar {
            display: flex;
            align-items: stretch;
            gap: 10px;
            margin-bottom: 24px;
            width: 100%;
        }

        .search-bar__field {
            position: relative;
            flex: 1;
            min-width: 0;
        }

        .search-bar__input {
            width: 100%;
            height: 48px;
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 0 44px 0 16px;
            color: #fff;
            font-size: 14px;
            line-height: 48px;
            transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease;
            outline: none;
            font-family: inherit;
        }
        .search-bar__input::placeholder { color: #4a4a63; }
        .search-bar__input:focus {
            border-color: var(--color-accent-strong);
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        }

        .search-bar__icon {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #4a4a63;
            font-size: 16px;
            pointer-events: none;
            transition: color var(--duration-base) ease;
        }
        .search-bar__input:focus ~ .search-bar__icon {
            color: var(--color-accent);
        }

        .search-bar__filter-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 48px;
            padding: 0 16px;
            min-width: 48px;
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            color: var(--color-text-secondary);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color var(--duration-fast) ease,
                        border-color var(--duration-fast) ease,
                        color var(--duration-fast) ease;
            flex-shrink: 0;
            font-family: inherit;
            white-space: nowrap;
        }
        .search-bar__filter-btn:hover {
            background: var(--color-accent-soft);
            border-color: var(--color-border-strong);
            color: var(--color-accent);
        }
        .search-bar__filter-btn--active {
            background: var(--color-accent-soft);
            border-color: rgba(167, 139, 250, 0.3);
            color: var(--color-accent);
        }
        .search-bar__filter-btn i { font-size: 16px; }
        .search-bar__filter-btn span { display: none; }
        @media (min-width: 400px) {
            .search-bar__filter-btn span { display: inline; }
        }

        .search-bar__menu {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            left: 0;
            background: var(--color-surface-elevated);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-md);
            padding: 6px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: opacity var(--duration-base) var(--ease-out),
                        visibility var(--duration-base) var(--ease-out),
                        transform var(--duration-base) var(--ease-out);
            z-index: 30;
            pointer-events: none;
        }
        .search-bar__menu--open {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            pointer-events: auto;
        }

        .search-bar__menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border-radius: var(--radius-sm);
            color: var(--color-text-secondary);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: right;
            font-family: inherit;
            min-height: 44px;
        }
        .search-bar__menu-item:hover {
            background: var(--color-accent-soft);
            color: #e5e7eb;
        }
        .search-bar__menu-item--selected {
            background: rgba(167, 139, 250, 0.08);
            color: var(--color-accent);
        }

        .search-bar__menu-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .search-bar__select {
            display: none;
            height: 48px;
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-md);
            padding: 0 16px;
            color: #fff;
            font-size: 14px;
            font-family: inherit;
            cursor: pointer;
            transition: border-color var(--duration-base) ease, box-shadow var(--duration-base) ease;
            outline: none;
            min-width: 180px;
            flex-shrink: 0;
            appearance: none;
            -webkit-appearance: none;
            -moz-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239ca3af' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: left 12px center;
            background-size: 16px;
            padding-left: 36px;
        }
        .search-bar__select:focus {
            border-color: var(--color-accent-strong);
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
        }

        @media (max-width: 639px) {
            .search-bar__filter-btn { display: flex; }
            .search-bar__select { display: none; }
        }

        @media (min-width: 640px) {
            .search-bar__filter-btn { display: none; }
            .search-bar__select { display: block; }
            .search-bar__menu { display: none; }
        }

        @media (max-width: 480px) {
            .search-bar { gap: 8px; margin-bottom: 20px; }
            .search-bar__input {
                height: 44px;
                padding: 0 40px 0 14px;
                font-size: 13px;
                line-height: 44px;
            }
            .search-bar__icon { right: 12px; font-size: 14px; }
            .search-bar__filter-btn {
                height: 44px;
                padding: 0 12px;
                min-width: 44px;
            }
        }

        /* Block: badge */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            line-height: 1.4;
            white-space: nowrap;
        }
        .badge--accent {
            background: var(--color-accent-soft);
            color: var(--color-accent);
        }

        /* Block: data-table */
        .data-table {
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            contain: layout style;
        }
        @media (max-width: 768px) {
            .data-table { display: none; }
        }

        .data-table__inner { overflow-x: auto; }

        .data-table__table {
            width: 100%;
            font-size: 14px;
        }

        .data-table__head {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            color: var(--color-text-muted);
            font-size: 12px;
        }

        .data-table__th {
            padding: 16px;
            text-align: right;
            font-weight: 500;
        }

        .data-table__row {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: background-color var(--duration-fast) ease;
            content-visibility: auto;
            contain-intrinsic-size: auto 64px;
        }
        .data-table__row:last-child { border-bottom: none; }
        .data-table__row:hover { background: rgba(167, 139, 250, 0.02); }

        .data-table__cell { padding: 16px; }

        .data-table__user {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .data-table__avatar {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(124, 58, 237, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-accent);
            font-weight: 800;
            font-size: 12px;
            flex-shrink: 0;
            contain: layout style;
        }

        .data-table__name {
            font-weight: 600;
            color: #fff;
            font-size: 14px;
        }

        .data-table__email {
            color: var(--color-text-secondary);
            font-size: 14px;
        }

        .data-table__date {
            color: var(--color-text-muted);
            font-size: 12px;
            font-variant-numeric: tabular-nums;
        }

        .data-table__actions {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        /* Block: role-badge & status-badge */
        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }
        .role-badge--admin {
            background: var(--color-danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: var(--color-danger);
        }
        .role-badge--moderator {
            background: rgba(168, 85, 247, 0.08);
            border: 1px solid rgba(168, 85, 247, 0.15);
            color: #c4b5fd;
        }
        .role-badge--user,
        .role-badge--member {
            background: var(--color-accent-soft);
            border: 1px solid rgba(167, 139, 250, 0.15);
            color: var(--color-accent);
        }
        .role-badge--owner {
            background: rgba(251, 191, 36, 0.08);
            border: 1px solid rgba(251, 191, 36, 0.15);
            color: var(--color-warning);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }
        .status-badge--active {
            background: var(--color-success-soft);
            border: 1px solid rgba(52, 211, 153, 0.15);
            color: var(--color-success);
        }
        .status-badge--suspended {
            background: var(--color-warning-soft);
            border: 1px solid rgba(251, 191, 36, 0.15);
            color: var(--color-warning);
        }
        .status-badge--disabled {
            background: var(--color-danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: var(--color-danger);
        }
        .status-badge__dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        @media (max-width: 768px) {
            .role-badge,
            .status-badge {
                font-size: 9px;
                padding: 2px 8px;
            }
        }
        @media (max-width: 480px) {
            .role-badge,
            .status-badge {
                font-size: 8px;
                padding: 2px 6px;
            }
        }

        /* Block: action */
        .action__btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color var(--duration-fast) ease,
                        border-color var(--duration-fast) ease,
                        color var(--duration-fast) ease;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-muted);
            font-size: 14px;
            text-decoration: none;
            outline: none;
            font-family: inherit;
        }
        .action__btn:hover {
            background: rgba(167, 139, 250, 0.1);
            border-color: rgba(167, 139, 250, 0.2);
            color: var(--color-accent);
        }
        .action__btn--promote:hover {
            background: rgba(168, 85, 247, 0.1);
            border-color: rgba(168, 85, 247, 0.2);
            color: #c4b5fd;
        }
        .action__btn--status:hover {
            background: rgba(251, 191, 36, 0.1);
            border-color: rgba(251, 191, 36, 0.2);
            color: var(--color-warning);
        }
        .action__btn--delete:hover {
            background: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.2);
            color: var(--color-danger);
        }

        /* Block: user-card (mobile) */
        .user-cards {
            display: none;
            flex-direction: column;
            gap: 12px;
        }
        @media (max-width: 768px) {
            .user-cards { display: flex; }
        }

        .user-card {
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 16px;
            transition: border-color var(--duration-slow) var(--ease-out),
                        transform var(--duration-slow) var(--ease-out);
            position: relative;
            overflow: hidden;
            content-visibility: auto;
            contain-intrinsic-size: auto 180px;
            contain: layout style;
        }
        .user-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient(180deg, var(--color-accent-strong), var(--color-accent));
            opacity: 0;
            transition: opacity var(--duration-slow) ease;
        }
        .user-card:hover {
            border-color: var(--color-border-strong);
            transform: translateY(-2px);
        }
        .user-card:hover::before { opacity: 1; }

        .user-card__top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
        }

        .user-card__info {
            flex: 1;
            min-width: 0;
        }

        .user-card__badges {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .user-card__name {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            margin-top: 4px;
            line-height: 1.3;
        }

        .user-card__meta {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 10px;
            margin-top: 4px;
        }
        .user-card__meta span {
            font-size: 10px;
            color: var(--color-text-secondary);
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .user-card__meta span i {
            font-size: 9px;
            color: var(--color-text-muted);
        }

        .user-card__actions {
            display: flex;
            gap: 6px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
        }

        .user-card__actions .action__btn {
            flex: 1;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-muted);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--duration-fast) ease;
            text-decoration: none;
            padding: 0 8px;
            font-family: inherit;
        }
        .user-card__actions .action__btn:hover {
            background: rgba(167, 139, 250, 0.08);
            border-color: rgba(167, 139, 250, 0.2);
            color: var(--color-accent);
        }
        .user-card__actions .action__btn i { font-size: 13px; }
        .user-card__actions .action__btn--delete { color: var(--color-danger); }
        .user-card__actions .action__btn--delete:hover {
            background: rgba(239, 68, 68, 0.08);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        @media (max-width: 768px) {
            .user-card {
                padding: 14px;
                border-radius: 14px;
            }
            .user-card__name { font-size: 14px; }
            .user-card__meta span { font-size: 9px; }
            .user-card__actions .action__btn { font-size: 10px; height: 36px; }
            .user-card__actions .action__btn i { font-size: 12px; }
        }
        @media (max-width: 480px) {
            .user-card {
                padding: 12px;
                border-radius: 12px;
            }
            .user-card__name { font-size: 13px; }
            .user-card__meta span { font-size: 8px; }
            .user-card__actions .action__btn {
                font-size: 9px;
                height: 32px;
                border-radius: 8px;
            }
            .user-card__actions .action__btn i { font-size: 11px; }
        }

        /* Block: pagination */
        .pagination {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            margin-top: 24px;
            padding: 16px 20px;
            background: rgba(15, 15, 26, 0.4);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
        }
        @media (max-width: 768px) {
            .pagination { padding: 12px 16px; }
        }

        .pagination__info {
            font-size: 13px;
            color: var(--color-text-secondary);
            text-align: center;
        }
        .pagination__info strong {
            color: #fff;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }
        @media (max-width: 480px) {
            .pagination__info { font-size: 11px; }
        }

        .pagination__controls {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .pagination__btn {
            min-width: 38px;
            height: 38px;
            padding: 0 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            background: transparent;
            border: 1px solid transparent;
            color: var(--color-text-secondary);
            transition: all var(--duration-fast) ease;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-family: inherit;
            font-variant-numeric: tabular-nums;
        }
        .pagination__btn:hover:not(:disabled):not(.pagination__btn--active) {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.08);
            color: #e5e7eb;
        }
        .pagination__btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }
        .pagination__btn--active {
            background: rgba(167, 139, 250, 0.15);
            border-color: rgba(167, 139, 250, 0.3);
            color: var(--color-accent);
            font-weight: 600;
        }
        .pagination__btn i { font-size: 14px; }
        @media (max-width: 768px) {
            .pagination__btn {
                min-width: 34px;
                height: 34px;
                font-size: 12px;
            }
        }

        .pagination__dots {
            color: var(--color-text-muted);
            padding: 0 4px;
            font-size: 14px;
            user-select: none;
        }

        /* Block: empty-state */
        .empty-state {
            padding: 60px 20px;
            text-align: center;
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
        }

        .empty-state__icon {
            width: 72px;
            height: 72px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 32px;
            color: #4a4a63;
        }
        @media (max-width: 480px) {
            .empty-state__icon {
                width: 56px;
                height: 56px;
                font-size: 24px;
            }
        }

        .empty-state__title {
            font-size: 18px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 8px;
        }
        @media (max-width: 480px) {
            .empty-state__title { font-size: 15px; }
        }

        .empty-state__desc {
            font-size: 14px;
            color: var(--color-text-muted);
        }
        @media (max-width: 480px) {
            .empty-state__desc { font-size: 12px; }
        }

        .empty-state__action {
            margin-top: 16px;
            padding: 10px 20px;
            border-radius: 12px;
            background: var(--color-accent-strong);
            color: #fff;
            font-weight: 600;
            font-size: 14px;
            border: none;
            cursor: pointer;
            transition: background-color var(--duration-fast) ease;
            font-family: inherit;
        }
        .empty-state__action:hover {
            background: var(--color-accent);
        }

        /* Block: skeleton */
        .skeleton {
            position: relative;
            overflow: hidden;
            background: rgba(167, 139, 250, 0.04);
            border-radius: 6px;
        }
        .skeleton::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(167, 139, 250, 0.10) 50%,
                transparent 100%
            );
            transform: translateX(-100%);
            animation: skeleton-shimmer 1.6s infinite;
        }
        @keyframes skeleton-shimmer {
            100% { transform: translateX(100%); }
        }

        .skeleton__line {
            height: 12px;
            margin-bottom: 6px;
        }
        .skeleton__line--title {
            height: 14px;
            width: 70%;
        }
        .skeleton__line--subtitle {
            height: 10px;
            width: 50%;
        }
        .skeleton__line--md {
            height: 12px;
            width: 60%;
        }
        .skeleton__line--lg {
            height: 14px;
            width: 80%;
        }

        .skeleton__avatar {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .skeleton__badge {
            width: 60px;
            height: 20px;
            border-radius: 20px;
        }

        .skeleton__action {
            width: 34px;
            height: 34px;
            border-radius: 8px;
        }

        [data-loading="true"] .js-content { display: none; }
        [data-loading="false"] .js-content { display: block; }
        [data-loading="true"] .js-skeleton { display: block; }
        [data-loading="false"] .js-skeleton { display: none; }

        /* Block: modal */
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity var(--duration-base) ease,
                        visibility var(--duration-base) ease;
            padding: 16px;
        }
        .modal--active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .modal__dialog {
            background: var(--color-surface-elevated);
            border: 1px solid rgba(167, 139, 250, 0.08);
            border-radius: 24px;
            padding: 32px 28px;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(124, 58, 237, 0.05);
            transform: scale(0.92) translateY(20px);
            transition: transform var(--duration-slow) var(--ease-spring);
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            contain: layout style;
        }
        .modal--active .modal__dialog {
            transform: scale(1) translateY(0);
        }
        @media (max-width: 768px) {
            .modal__dialog {
                padding: 24px 20px;
                border-radius: 20px;
            }
        }
        @media (max-width: 480px) {
            .modal__dialog {
                padding: 20px 16px;
                border-radius: 18px;
            }
        }

        .modal__icon {
            width: 72px;
            height: 72px;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 32px;
            position: relative;
        }
        .modal__icon::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 28px;
            background: inherit;
            opacity: 0.3;
            filter: blur(12px);
            z-index: -1;
        }
        .modal__icon--purple {
            background: rgba(167, 139, 250, 0.12);
            color: var(--color-accent);
        }
        .modal__icon--amber {
            background: rgba(251, 191, 36, 0.12);
            color: var(--color-warning);
        }
        .modal__icon--red {
            background: rgba(239, 68, 68, 0.12);
            color: var(--color-danger);
        }
        @media (max-width: 480px) {
            .modal__icon {
                width: 56px;
                height: 56px;
                font-size: 24px;
                border-radius: 18px;
            }
        }

        .modal__title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            margin-bottom: 4px;
        }
        @media (max-width: 480px) {
            .modal__title { font-size: 17px; }
        }

        .modal__desc {
            font-size: 13px;
            color: var(--color-text-secondary);
            text-align: center;
            margin-bottom: 20px;
        }

        .modal__close {
            position: absolute;
            top: 16px;
            left: 16px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
            font-size: 18px;
            font-family: inherit;
        }
        .modal__close:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #d1d5db;
        }
        @media (max-width: 480px) {
            .modal__close {
                top: 10px;
                left: 10px;
                width: 30px;
                height: 30px;
                font-size: 14px;
            }
        }

        .modal__options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.02);
            border: 2px solid rgba(255, 255, 255, 0.04);
            border-radius: 14px;
            cursor: pointer;
            transition: background-color var(--duration-base) ease,
                        border-color var(--duration-base) ease,
                        color var(--duration-base) ease;
            color: var(--color-text-secondary);
            position: relative;
            font-family: inherit;
            width: 100%;
            text-align: right;
        }
        .option:hover {
            background: rgba(255, 255, 255, 0.04);
            border-color: rgba(167, 139, 250, 0.2);
        }
        .option--selected {
            background: var(--color-accent-soft);
            border-color: rgba(167, 139, 250, 0.4);
            color: #c4b5fd;
        }
        .option--disabled {
            opacity: 0.35;
            pointer-events: none;
            cursor: not-allowed;
        }

        .option__dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid rgba(255, 255, 255, 0.15);
            flex-shrink: 0;
            transition: border-color var(--duration-base) ease,
                        background-color var(--duration-base) ease,
                        box-shadow var(--duration-base) ease;
        }
        .option--selected .option__dot {
            border-color: var(--color-accent);
            background: var(--color-accent);
            box-shadow: 0 0 0 4px rgba(167, 139, 250, 0.15);
        }

        .option__content {
            flex: 1;
            min-width: 0;
        }
        .option__label {
            font-weight: 600;
            font-size: 14px;
        }
        .option__desc {
            font-size: 11px;
            color: var(--color-text-muted);
        }

        .modal__actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        @media (max-width: 480px) {
            .modal__actions {
                flex-direction: column-reverse;
                gap: 8px;
            }
        }

        .modal__btn {
            flex: 1;
            padding: 12px 20px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            transition: background-color var(--duration-fast) ease,
                        border-color var(--duration-fast) ease,
                        transform var(--duration-fast) ease,
                        box-shadow var(--duration-fast) ease;
            cursor: pointer;
            border: none;
            outline: none;
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        @media (max-width: 480px) {
            .modal__btn {
                width: 100%;
                padding: 14px;
            }
        }

        .modal__btn--cancel {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-secondary);
        }
        .modal__btn--cancel:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #d1d5db;
        }

        .modal__btn--confirm {
            background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
            color: #fff;
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3);
        }
        .modal__btn--confirm:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(124, 58, 237, 0.4);
        }
        .modal__btn--confirm:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .modal__btn--danger {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: #fff;
            box-shadow: 0 8px 24px rgba(220, 38, 38, 0.3);
            text-decoration: none;
            text-align: center;
        }
        .modal__btn--danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(220, 38, 38, 0.4);
        }

        /* Spinner */
        .btn-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: btn-spin 0.6s linear infinite;
            vertical-align: middle;
        }
        @keyframes btn-spin {
            to { transform: rotate(360deg); }
        }

        /* Block: toast */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-surface-elevated);
            color: var(--color-text-primary);
            padding: 12px 24px;
            border-radius: var(--radius-lg);
            font-size: 13px;
            font-weight: 600;
            z-index: 1000;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.06);
            animation: toast-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-width: calc(100vw - 32px);
        }
        @keyframes toast-in {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }
        .toast--success {
            background: #0d2818;
            border-color: rgba(16, 185, 129, 0.3);
            color: #6ee7b7;
        }
        .toast--error {
            background: #3b1010;
            border-color: rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        /* Reduced motion */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
            .skeleton::after {
                animation: none;
                opacity: 0.05;
            }
            .sidebar {
                transition: none;
            }
        }
    </style>
</head>
