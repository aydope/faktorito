<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>مدیریت فاکتورها | فاکتوریتو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        'ink': {
                            950: '#050508',
                            900: '#0a0a12',
                            800: '#0f0f1a',
                            700: '#151522',
                            600: '#1a1a2e',
                            500: '#22223a',
                            400: '#2a2a46',
                        },
                        'accent': {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #050508; }
        ::-webkit-scrollbar-thumb { background: #1a1a2e; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #2a2a46; }

        .glass-nav {
            background: rgba(10, 10, 18, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(167, 139, 250, 0.08);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
        }

        .nav-link {
            color: #9ca3af;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
        }
        .nav-link::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 2px;
            height: 0;
            background: #a78bfa;
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        .nav-link:hover {
            color: #e5e7eb;
            background: rgba(167, 139, 250, 0.04);
        }
        .nav-link.active {
            color: #a78bfa;
            background: rgba(167, 139, 250, 0.06);
        }
        .nav-link.active::before {
            height: 24px;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(239, 68, 68, 0.06);
            border: 1px solid rgba(239, 68, 68, 0.1);
            border-radius: 10px;
            color: #f87171;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.12);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }
        .status-paid {
            background: rgba(52, 211, 153, 0.08);
            border: 1px solid rgba(52, 211, 153, 0.15);
            color: #34d399;
        }
        .status-pending {
            background: rgba(251, 191, 36, 0.08);
            border: 1px solid rgba(251, 191, 36, 0.15);
            color: #fbbf24;
        }

        .badge-purple {
            background: rgba(167, 139, 250, 0.08);
            color: #a78bfa;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.7);
            backdrop-filter: blur(8px);
            z-index: 60;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background: rgba(10, 10, 18, 0.95);
            backdrop-filter: blur(20px);
            border-left: 1px solid rgba(167, 139, 250, 0.06);
            z-index: 70;
            padding: 20px;
            transition: right 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            overflow-y: auto;
        }
        .sidebar.open {
            right: 0;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(167, 139, 250, 0.06);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .sidebar-logo .logo-box {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
        }
        .sidebar-logo span {
            font-weight: 800;
            font-size: 18px;
            color: #fff;
        }

        .sidebar-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #6b7280;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-size: 18px;
        }
        .sidebar-close:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .sidebar-link:hover {
            background: rgba(167, 139, 250, 0.06);
            color: #c4b5fd;
        }
        .sidebar-link.active {
            background: rgba(167, 139, 250, 0.08);
            color: #a78bfa;
        }
        .sidebar-link i {
            font-size: 18px;
            width: 22px;
            text-align: center;
            color: #6b7280;
        }
        .sidebar-link.active i {
            color: #a78bfa;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(167, 139, 250, 0.06);
            margin: 8px 12px;
        }

        .menu-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #d1d5db;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .menu-btn:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: #14141f;
            color: #d1d5db;
            padding: 12px 24px;
            border-radius: 16px;
            font-size: 13px;
            font-weight: 600;
            z-index: 1000;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.06);
            animation: toastIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes toastIn {
            from { opacity: 0; transform: translateX(-50%) translateY(12px); }
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.85);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-dialog {
            background: #14141f;
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 20px;
            padding: 28px;
            max-width: 420px;
            width: 90%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6);
            transform: scale(0.92) translateY(16px);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .modal-overlay.active .modal-dialog {
            transform: scale(1) translateY(0);
        }

        .loading-overlay {
            position: absolute;
            inset: 0;
            background: rgba(5, 5, 8, 0.5);
            backdrop-filter: blur(4px);
            border-radius: 16px;
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }
        .loading-overlay.active {
            display: flex;
        }
        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid rgba(255, 255, 255, 0.1);
            border-top-color: #a78bfa;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .invoices-wrapper {
            position: relative;
            min-height: 200px;
        }

        .invoice-card {
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid rgba(167, 139, 250, 0.06);
            border-radius: 16px;
            padding: 16px;
            transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
            position: relative;
            overflow: hidden;
        }
        .invoice-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient(180deg, #7c3aed, #a78bfa);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .invoice-card:hover {
            border-color: rgba(167, 139, 250, 0.15);
            transform: translateY(-2px);
        }
        .invoice-card:hover::before {
            opacity: 1;
        }

        .invoice-card .top-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
        }

        .invoice-card .member-info {
            flex: 1;
            min-width: 0;
        }

        .invoice-card .member-info .name {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            margin-top: 4px;
            line-height: 1.3;
        }

        .invoice-card .member-info .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 4px 10px;
            margin-top: 4px;
        }
        .invoice-card .member-info .meta span {
            font-size: 10px;
            color: #9ca3af;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .invoice-card .member-info .meta span i {
            font-size: 9px;
            color: #6b7280;
        }

        .invoice-card .price-box {
            text-align: left;
            flex-shrink: 0;
        }
        .invoice-card .price-box .amount {
            font-size: 17px;
            font-weight: 900;
            color: #a78bfa;
            line-height: 1.2;
        }
        .invoice-card .price-box .unit {
            font-size: 8px;
            color: #6b7280;
        }

        .invoice-card .action-box {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
        }

        .action-box .action-btn {
            flex: 1;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #6b7280;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            padding: 0 12px;
        }
        .action-box .action-btn:hover {
            background: rgba(167, 139, 250, 0.08);
            border-color: rgba(167, 139, 250, 0.2);
            color: #a78bfa;
        }
        .action-box .action-btn i {
            font-size: 15px;
        }

        .action-box .action-btn.delete-btn {
            color: #f87171;
        }
        .action-box .action-btn.delete-btn:hover {
            background: rgba(239, 68, 68, 0.08);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }
        .action-box .action-btn.view-btn {
            color: #a78bfa;
        }
        .action-box .action-btn.view-btn:hover {
            background: rgba(167, 139, 250, 0.08);
            border-color: rgba(167, 139, 250, 0.2);
            color: #c4b5fd;
        }

        .desktop-table {
            display: block;
        }

        .action-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            background: rgba(167, 139, 250, 0.08);
            border: 1px solid rgba(167, 139, 250, 0.15);
            border-radius: 12px;
            color: #a78bfa;
            font-size: 12px;
            font-weight: 600;
            transition: all 0.2s ease;
            text-decoration: none;
            cursor: pointer;
        }
        .action-badge:hover {
            background: rgba(167, 139, 250, 0.15);
            border-color: rgba(167, 139, 250, 0.3);
            color: #c4b5fd;
        }
        .action-badge i {
            font-size: 14px;
        }
        .action-badge.danger {
            background: rgba(239, 68, 68, 0.08);
            border-color: rgba(239, 68, 68, 0.15);
            color: #f87171;
        }
        .action-badge.danger:hover {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none !important;
            }
            .menu-btn {
                display: flex !important;
            }

            .glass-nav {
                padding: 8px 12px !important;
                border-radius: 16px !important;
            }
            .glass-nav .font-extrabold.text-xl {
                font-size: 16px !important;
            }
            .glass-nav .w-9.h-9 {
                width: 32px !important;
                height: 32px !important;
                font-size: 14px !important;
            }

            main {
                padding-top: 90px !important;
                padding-left: 12px !important;
                padding-right: 12px !important;
            }

            .desktop-table {
                display: none !important;
            }

            .invoice-card {
                padding: 14px !important;
                border-radius: 14px !important;
            }

            .invoice-card .member-info .name {
                font-size: 14px !important;
            }
            .invoice-card .member-info .meta span {
                font-size: 9px !important;
            }
            .invoice-card .price-box .amount {
                font-size: 15px !important;
            }

            .action-box .action-btn {
                font-size: 11px !important;
                height: 38px !important;
                border-radius: 12px !important;
            }
            .action-box .action-btn i {
                font-size: 13px !important;
            }

            .status-badge {
                font-size: 9px !important;
                padding: 2px 8px !important;
            }

            .invoice-number {
                font-size: 9px !important;
                color: #6b7280 !important;
                font-family: monospace !important;
            }

            .action-badge {
                padding: 6px 12px !important;
                font-size: 11px !important;
                border-radius: 10px !important;
            }
            .action-badge i {
                font-size: 12px !important;
            }
        }

        @media (max-width: 480px) {
            .glass-nav .font-extrabold.text-xl {
                font-size: 14px !important;
            }
            .glass-nav .w-9.h-9 {
                width: 28px !important;
                height: 28px !important;
                font-size: 12px !important;
            }

            main {
                padding-top: 80px !important;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .invoice-card {
                padding: 12px !important;
                border-radius: 12px !important;
            }

            .invoice-card .member-info .name {
                font-size: 13px !important;
            }
            .invoice-card .member-info .meta span {
                font-size: 8px !important;
            }
            .invoice-card .price-box .amount {
                font-size: 14px !important;
            }

            .action-box .action-btn {
                font-size: 10px !important;
                height: 34px !important;
                border-radius: 10px !important;
            }
            .action-box .action-btn i {
                font-size: 12px !important;
            }

            .action-badge {
                padding: 4px 10px !important;
                font-size: 10px !important;
                border-radius: 8px !important;
            }
            .action-badge i {
                font-size: 11px !important;
            }
        }

        @media (min-width: 769px) {
            .sidebar-overlay,
            .sidebar,
            .menu-btn {
                display: none !important;
            }

            .invoice-card {
                display: none !important;
            }
        }

        @media (max-width: 768px) {
            .desktop-table {
                display: none !important;
            }
        }
    </style>
</head>
<body class="antialiased bg-[#050508]">

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/admin/dashboard" class="sidebar-logo">
                <div class="logo-box">ا</div>
                <span>پنل ادمین</span>
            </a>
            <button class="sidebar-close" onclick="closeSidebar()">&times;</button>
        </div>

        <div class="space-y-1">
            <a href="/admin/dashboard" class="sidebar-link">
                <i class="bi bi-speedometer2"></i> داشبورد
            </a>
            <a href="/admin/users" class="sidebar-link">
                <i class="bi bi-people"></i> کاربران
            </a>
            <a href="/admin/invoices" class="sidebar-link active">
                <i class="bi bi-receipt"></i> فاکتورها
            </a>
            <a href="/admin/plans" class="sidebar-link">
                <i class="bi bi-collection"></i> پلن‌ها
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <a href="/dashboard" class="sidebar-link">
            <i class="bi bi-globe"></i> داشبورد کاربر
        </a>
        <button onclick="openLogoutModal()" class="sidebar-link" style="color: #f87171; width: 100%; text-align: right; border: none; background: transparent; cursor: pointer;">
            <i class="bi bi-box-arrow-right" style="color: #f87171;"></i> خروج
        </button>
    </div>

    <nav class="fixed top-0 right-0 left-0 z-50 px-3 md:px-6 py-3 md:py-5">
        <div class="max-w-6xl mx-auto glass-nav rounded-2xl px-3 md:px-6 py-2 md:py-3 flex items-center justify-between">
            <div class="flex items-center gap-2 md:gap-3">
                <button class="menu-btn" onclick="openSidebar()">
                    <i class="bi bi-list text-xl"></i>
                </button>
                <a href="/admin/dashboard" class="flex items-center gap-2 md:gap-2.5 no-underline shrink-0 group">
                    <div class="w-8 h-8 md:w-9 md:h-9 bg-gradient-to-br from-accent-600 to-accent-400 rounded-lg flex items-center justify-center text-white font-extrabold text-sm md:text-lg transition-transform group-hover:scale-105 shadow-lg shadow-accent-600/30">
                        ا
                    </div>
                    <span class="font-extrabold text-base md:text-xl lg:text-2xl text-white tracking-tight">پنل ادمین</span>
                </a>
            </div>

            <div class="nav-links flex items-center gap-1 md:gap-1.5">
                <a href="/admin/dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i> <span class="hidden sm:inline">داشبورد</span>
                </a>
                <a href="/admin/users" class="nav-link">
                    <i class="bi bi-people"></i> <span class="hidden sm:inline">کاربران</span>
                </a>
                <a href="/admin/invoices" class="nav-link active">
                    <i class="bi bi-receipt"></i> <span class="hidden sm:inline">فاکتورها</span>
                </a>
                <a href="/admin/plans" class="nav-link hidden lg:inline-flex">
                    <i class="bi bi-collection"></i> پلن‌ها
                </a>

                <div class="w-px h-6 bg-white/5 mx-1 md:mx-2 hidden lg:block"></div>

                <a href="/dashboard" class="nav-link hidden md:inline-flex">
                    <i class="bi bi-globe"></i> <span class="hidden lg:inline">داشبورد کاربر</span>
                </a>
                <button onclick="openLogoutModal()" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="hidden sm:inline">خروج</span>
                </button>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-3 md:px-4 pt-24 md:pt-28 pb-12 md:pb-16">

        <div class="mb-6 md:mb-10">
            <h1 class="text-2xl md:text-3xl lg:text-4xl font-black text-white mb-1 md:mb-2 flex items-center gap-3">
                <span class="bg-gradient-to-r from-accent-400 to-accent-600 bg-clip-text text-transparent">مدیریت فاکتورها</span>
                <span class="badge-purple text-xs"><%= invoices.length %></span>
            </h1>
            <p class="text-gray-500 text-xs md:text-sm">مشاهده و مدیریت تمام فاکتورهای سیستم</p>
        </div>

        <div class="invoices-wrapper" id="invoicesWrapper">

            <div class="loading-overlay" id="loadingOverlay">
                <div class="loading-spinner"></div>
            </div>

            <div id="invoicesContainer">
                <!-- DESKTOP TABLE -->
                <div class="desktop-table card rounded-2xl overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-gray-500 text-xs border-b border-white/5">
                                    <th class="p-4 text-right font-medium">شماره</th>
                                    <th class="p-4 text-right font-medium">عضو</th>
                                    <th class="p-4 text-right font-medium hidden md:table-cell">صاحب فاکتور</th>
                                    <th class="p-4 text-right font-medium hidden lg:table-cell">پلن</th>
                                    <th class="p-4 text-right font-medium">مبلغ</th>
                                    <th class="p-4 text-right font-medium">وضعیت</th>
                                    <th class="p-4 text-right font-medium hidden sm:table-cell">تاریخ</th>
                                    <th class="p-4 text-center font-medium">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoices.forEach(function(inv) { %>
                                <tr class="table-row border-b border-white/5">
                                    <td class="p-4">
                                        <span class="text-xs text-gray-400 font-mono tracking-wider">#<%= inv.invoiceNumber %></span>
                                    </td>
                                    <td class="p-4">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-7 h-7 rounded-md bg-accent-700/20 flex items-center justify-center text-accent-400 font-extrabold text-[10px]">
                                                <%= inv.member?.name ? inv.member.name.charAt(0).toUpperCase() : '?' %>
                                            </div>
                                            <span class="font-semibold text-white text-sm"><%= inv.member?.name || 'بدون نام' %></span>
                                        </div>
                                    </td>
                                    <td class="p-4 text-gray-400 hidden md:table-cell text-sm">
                                        <div class="flex items-center gap-1.5">
                                            <i class="bi bi-person text-xs"></i>
                                            <%= inv.user?.username || inv.user?.clubName || '—' %>
                                        </div>
                                    </td>
                                    <td class="p-4 text-gray-400 hidden lg:table-cell text-sm">
                                        <%= inv.plan?.name || '—' %>
                                    </td>
                                    <td class="p-4">
                                        <div class="font-bold text-white text-sm">
                                            <%= inv.totalAmount.toLocaleString("fa-IR-u-nu-latn") %>
                                        </div>
                                        <div class="text-[10px] text-gray-500">تومان</div>
                                    </td>
                                    <td class="p-4">
                                        <span class="status-badge <%= inv.isPaid ? 'status-paid' : 'status-pending' %>">
                                            <span style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: <%= inv.isPaid ? '#34d399' : '#fbbf24' %>;"></span>
                                            <%= inv.isPaid ? 'پرداخت شده' : 'در انتظار' %>
                                        </span>
                                    </td>
                                    <td class="p-4 text-gray-500 hidden sm:table-cell text-xs">
                                        <%= inv.invoiceDate %>
                                    </td>
                                    <td class="p-4">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="/i/<%= inv._id %>" class="action-badge">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <button onclick="openDeleteModalDesktop('<%= inv._id %>', '<%= inv.invoiceNumber %>')" class="action-badge danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- MOBILE CARDS -->
                <div class="space-y-3 block md:hidden">
                    <% invoices.forEach(function(inv) { %>
                    <div class="invoice-card">
                        <div class="top-row">
                            <div class="member-info">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="status-badge <%= inv.isPaid ? 'status-paid' : 'status-pending' %>">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: <%= inv.isPaid ? '#34d399' : '#fbbf24' %>;"></span>
                                        <%= inv.isPaid ? 'پرداخت شده' : 'در انتظار' %>
                                    </span>
                                    <span class="invoice-number">#<%= inv.invoiceNumber %></span>
                                </div>
                                <div class="name"><%= inv.member?.name || 'بدون نام' %></div>
                                <div class="meta">
                                    <span><i class="bi bi-person"></i> <%= inv.user?.username || '—' %></span>
                                    <span><i class="bi bi-tag"></i> <%= inv.plan?.name || '—' %></span>
                                    <span><i class="bi bi-calendar3"></i> <%= inv.invoiceDate %></span>
                                </div>
                            </div>
                            <div class="price-box">
                                <div class="amount"><%= inv.totalAmount.toLocaleString("fa-IR-u-nu-latn") %></div>
                                <div class="unit">تومان</div>
                            </div>
                        </div>

                        <div class="action-box">
                            <a href="/i/<%= inv._id %>" class="action-btn view-btn">
                                <i class="bi bi-eye"></i> مشاهده
                            </a>
                            <button onclick="openDeleteModalDesktop('<%= inv._id %>', '<%= inv.invoiceNumber %>')" class="action-btn delete-btn">
                                <i class="bi bi-trash"></i> حذف
                            </button>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <div id="paginationContainer">
            <% if (totalPages > 1) { %>
            <div class="flex items-center justify-center gap-2 mt-6 md:mt-8">
                <button onclick="loadPage(<%= currentPage - 1 %>)"
                        class="flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 <%= currentPage <= 1 ? 'opacity-30 pointer-events-none' : '' %>"
                        <%= currentPage <= 1 ? 'disabled' : '' %>>
                    <i class="bi bi-chevron-right text-sm md:text-lg"></i>
                </button>

                <%
                    const total = totalPages;
                    const current = currentPage;
                    const pages = [];

                    if (total <= 7) {
                        for (let i = 1; i <= total; i++) pages.push(i);
                    } else if (current <= 3) {
                        for (let i = 1; i <= 5; i++) pages.push(i);
                        pages.push('...');
                        pages.push(total);
                    } else if (current >= total - 2) {
                        pages.push(1);
                        pages.push('...');
                        for (let i = total - 4; i <= total; i++) pages.push(i);
                    } else {
                        pages.push(1);
                        pages.push('...');
                        for (let i = current - 1; i <= current + 1; i++) pages.push(i);
                        pages.push('...');
                        pages.push(total);
                    }
                %>

                <% pages.forEach(function(p) { %>
                    <% if (p === '...') { %>
                        <span class="text-gray-500 text-xs md:text-sm px-1 select-none">…</span>
                    <% } else { %>
                        <button onclick="loadPage(<%= p %>)"
                                class="flex items-center justify-center min-w-[32px] md:min-w-[40px] h-8 md:h-10 px-2 md:px-3 rounded-lg text-xs md:text-sm font-medium transition-all duration-200
                                <%= p === current ? 'bg-accent-600 text-white' : 'text-gray-400 hover:text-white hover:bg-white/5' %>">
                            <%= p %>
                        </button>
                    <% } %>
                <% }); %>

                <button onclick="loadPage(<%= currentPage + 1 %>)"
                        class="flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 <%= currentPage >= totalPages ? 'opacity-30 pointer-events-none' : '' %>"
                        <%= currentPage >= totalPages ? 'disabled' : '' %>>
                    <i class="bi bi-chevron-left text-sm md:text-lg"></i>
                </button>
            </div>
            <% } %>
        </div>
    </main>

    <!-- DELETE MODAL -->
    <div class="modal-overlay" id="deleteModal">
        <div class="modal-dialog text-center">
            <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-trash text-red-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">حذف فاکتور</h3>
            <p class="text-gray-400 text-sm mb-6" id="deleteMsg">
                آیا از حذف این فاکتور اطمینان دارید؟ این عمل قابل بازگشت نیست.
            </p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal('deleteModal')" class="px-6 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
                    انصراف
                </button>
                <button id="deleteConfirmBtn" class="px-6 py-2.5 rounded-xl text-white font-semibold text-sm bg-red-600 hover:bg-red-500 transition-all">
                    حذف
                </button>
            </div>
        </div>
    </div>

    <!-- LOGOUT MODAL -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-dialog text-center">
            <div class="w-16 h-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
                <i class="bi bi-box-arrow-right text-red-400 text-2xl"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">خروج از حساب</h3>
            <p class="text-gray-400 text-sm mb-6">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>
            <div class="flex gap-3 justify-center">
                <button onclick="closeModal('logoutModal')" class="px-6 py-2.5 rounded-xl text-gray-300 font-semibold text-sm bg-white/5 border border-white/10 hover:bg-white/10 transition-all">
                    انصراف
                </button>
                <a href="/auth/logout" class="px-6 py-2.5 rounded-xl text-white font-semibold text-sm bg-red-600 hover:bg-red-500 transition-all no-underline">
                    خروج
                </a>
            </div>
        </div>
    </div>

    <div id="toast" class="toast" style="display: none;"></div>

    <script>
        let currentPage = <%= currentPage %>;
        let totalPages = <%= totalPages %>;
        let isLoading = false;
        let currentStatus = '<%= filters.status || '' %>';
        let currentSearch = '<%= filters.search || '' %>';
        let deleteId = null;

        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function openLogoutModal() {
            openModal('logoutModal');
        }

        function openDeleteModalDesktop(id, invoiceNumber) {
            deleteId = id;
            document.getElementById('deleteMsg').textContent =
                `آیا از حذف فاکتور شماره #${invoiceNumber} اطمینان دارید؟ این عمل قابل بازگشت نیست.`;
            openModal('deleteModal');
        }

        document.getElementById('deleteConfirmBtn').addEventListener('click', async function() {
            if (!deleteId) return;

            const btn = this;
            btn.textContent = 'در حال حذف...';
            btn.disabled = true;

            try {
                const res = await fetch(`/admin/invoices/${deleteId}`, { method: 'DELETE' });
                const data = await res.json();

                if (data.success) {
                    toast(data.message || 'فاکتور با موفقیت حذف شد', 'success');
                    loadPage(currentPage);
                } else {
                    toast(data.message || 'خطا در حذف فاکتور', 'error');
                }
            } catch (e) {
                toast('خطا در ارتباط با سرور', 'error');
            }

            closeModal('deleteModal');
            btn.textContent = 'حذف';
            btn.disabled = false;
            deleteId = null;
        });

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('active');
            });
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeSidebar();
                document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
            }
        });

        function toast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.style.display = 'block';
            if (type === 'error') {
                t.style.background = '#3b1010';
                t.style.borderColor = 'rgba(239, 68, 68, 0.3)';
                t.style.color = '#fca5a5';
            } else if (type === 'success') {
                t.style.background = '#0d2818';
                t.style.borderColor = 'rgba(16, 185, 129, 0.3)';
                t.style.color = '#6ee7b7';
            } else {
                t.style.background = '#14141f';
                t.style.borderColor = 'rgba(255, 255, 255, 0.06)';
                t.style.color = '#d1d5db';
            }
            clearTimeout(t._t);
            t._t = setTimeout(() => { t.style.display = 'none'; }, 3000);
        }

        function showLoading() {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.classList.add('active');
        }

        function hideLoading() {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) overlay.classList.remove('active');
        }

        function renderInvoices(invoices) {
            const container = document.getElementById('invoicesContainer');
            if (!container) return;

            if (invoices.length === 0) {
                container.innerHTML = `
                    <div class="card rounded-2xl p-12 md:p-16 text-center">
                        <div class="w-16 h-16 md:w-20 md:h-20 bg-white/5 rounded-2xl flex items-center justify-center mx-auto mb-4 md:mb-5">
                            <i class="bi bi-inbox text-2xl md:text-3xl text-gray-600"></i>
                        </div>
                        <h3 class="text-base md:text-lg font-extrabold text-white mb-1 md:mb-2">هیچ فاکتوری یافت نشد</h3>
                        <p class="text-gray-500 text-xs md:text-sm">هیچ فاکتوری با این فیلترها وجود ندارد</p>
                    </div>
                `;
                return;
            }

            let desktopHtml = `
                <div class="desktop-table card rounded-2xl overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="text-gray-500 text-xs border-b border-white/5">
                                    <th class="p-4 text-right font-medium">شماره</th>
                                    <th class="p-4 text-right font-medium">عضو</th>
                                    <th class="p-4 text-right font-medium hidden md:table-cell">صاحب فاکتور</th>
                                    <th class="p-4 text-right font-medium hidden lg:table-cell">پلن</th>
                                    <th class="p-4 text-right font-medium">مبلغ</th>
                                    <th class="p-4 text-right font-medium">وضعیت</th>
                                    <th class="p-4 text-right font-medium hidden sm:table-cell">تاریخ</th>
                                    <th class="p-4 text-center font-medium">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
            `;

            let mobileHtml = '<div class="space-y-3 block md:hidden">';

            invoices.forEach(inv => {
                const statusClass = inv.isPaid ? 'status-paid' : 'status-pending';
                const statusColor = inv.isPaid ? '#34d399' : '#fbbf24';
                const statusText = inv.isPaid ? 'پرداخت شده' : 'در انتظار';

                desktopHtml += `
                    <tr class="table-row border-b border-white/5">
                        <td class="p-4">
                            <span class="text-xs text-gray-400 font-mono tracking-wider">#${inv.invoiceNumber}</span>
                        </td>
                        <td class="p-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-md bg-accent-700/20 flex items-center justify-center text-accent-400 font-extrabold text-[10px]">
                                    ${inv.member?.name ? inv.member.name.charAt(0).toUpperCase() : '?'}
                                </div>
                                <span class="font-semibold text-white text-sm">${inv.member?.name || 'بدون نام'}</span>
                            </div>
                        </td>
                        <td class="p-4 text-gray-400 hidden md:table-cell text-sm">
                            <div class="flex items-center gap-1.5">
                                <i class="bi bi-person text-xs"></i>
                                ${inv.user?.username || inv.user?.clubName || '—'}
                            </div>
                        </td>
                        <td class="p-4 text-gray-400 hidden lg:table-cell text-sm">
                            ${inv.plan?.name || '—'}
                        </td>
                        <td class="p-4">
                            <div class="font-bold text-white text-sm">
                                ${Number(inv.totalAmount).toLocaleString("fa-IR-u-nu-latn")}
                            </div>
                            <div class="text-[10px] text-gray-500">تومان</div>
                        </td>
                        <td class="p-4">
                            <span class="status-badge ${statusClass}">
                                <span style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: ${statusColor};"></span>
                                ${statusText}
                            </span>
                        </td>
                        <td class="p-4 text-gray-500 hidden sm:table-cell text-xs">
                            ${inv.invoiceDate}
                        </td>
                        <td class="p-4">
                            <div class="flex items-center justify-center gap-2">
                                <a href="/i/${inv._id}" class="action-badge">
                                    <i class="bi bi-eye"></i> مشاهده
                                </a>
                                <button onclick="openDeleteModalDesktop('${inv._id}', '${inv.invoiceNumber}')" class="action-badge danger">
                                    <i class="bi bi-trash"></i> حذف
                                </button>
                            </div>
                        </td>
                    </tr>
                `;

                mobileHtml += `
                    <div class="invoice-card">
                        <div class="top-row">
                            <div class="member-info">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="status-badge ${statusClass}">
                                        <span style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: ${statusColor};"></span>
                                        ${statusText}
                                    </span>
                                    <span class="invoice-number">#${inv.invoiceNumber}</span>
                                </div>
                                <div class="name">${inv.member?.name || 'بدون نام'}</div>
                                <div class="meta">
                                    <span><i class="bi bi-person"></i> ${inv.user?.username || '—'}</span>
                                    <span><i class="bi bi-tag"></i> ${inv.plan?.name || '—'}</span>
                                    <span><i class="bi bi-calendar3"></i> ${inv.invoiceDate}</span>
                                </div>
                            </div>
                            <div class="price-box">
                                <div class="amount">${Number(inv.totalAmount).toLocaleString("fa-IR-u-nu-latn")}</div>
                                <div class="unit">تومان</div>
                            </div>
                        </div>

                        <div class="action-box">
                            <a href="/i/${inv._id}" class="action-btn view-btn">
                                <i class="bi bi-eye"></i> مشاهده
                            </a>
                            <button onclick="openDeleteModalDesktop('${inv._id}', '${inv.invoiceNumber}')" class="action-btn delete-btn">
                                <i class="bi bi-trash"></i> حذف
                            </button>
                        </div>
                    </div>
                `;
            });

            desktopHtml += `</tbody></table></div></div>`;
            mobileHtml += '</div>';

            container.innerHTML = desktopHtml + mobileHtml;
        }

        function updatePagination(pagination) {
            const paginationContainer = document.getElementById('paginationContainer');
            if (!paginationContainer) return;

            totalPages = pagination.totalPages;
            currentPage = pagination.currentPage;

            if (totalPages <= 1) {
                paginationContainer.innerHTML = '';
                return;
            }

            const hasPrev = currentPage > 1;
            const hasNext = currentPage < totalPages;

            let html = '<div class="flex items-center justify-center gap-2 mt-6 md:mt-8">';

            html += `
                <button onclick="loadPage(${currentPage - 1})"
                        class="flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 ${!hasPrev ? 'opacity-30 pointer-events-none' : ''}"
                        ${!hasPrev ? 'disabled' : ''}>
                    <i class="bi bi-chevron-right text-sm md:text-lg"></i>
                </button>
            `;

            const total = totalPages;
            const current = currentPage;
            const pages = [];

            if (total <= 7) {
                for (let i = 1; i <= total; i++) pages.push(i);
            } else if (current <= 3) {
                for (let i = 1; i <= 5; i++) pages.push(i);
                pages.push('...');
                pages.push(total);
            } else if (current >= total - 2) {
                pages.push(1);
                pages.push('...');
                for (let i = total - 4; i <= total; i++) pages.push(i);
            } else {
                pages.push(1);
                pages.push('...');
                for (let i = current - 1; i <= current + 1; i++) pages.push(i);
                pages.push('...');
                pages.push(total);
            }

            pages.forEach(p => {
                if (p === '...') {
                    html += `<span class="text-gray-500 text-xs md:text-sm px-1 select-none">…</span>`;
                } else {
                    html += `
                        <button onclick="loadPage(${p})"
                                class="flex items-center justify-center min-w-[32px] md:min-w-[40px] h-8 md:h-10 px-2 md:px-3 rounded-lg text-xs md:text-sm font-medium transition-all duration-200
                                ${p === current ? 'bg-accent-600 text-white' : 'text-gray-400 hover:text-white hover:bg-white/5'}">
                            ${p}
                        </button>
                    `;
                }
            });

            html += `
                <button onclick="loadPage(${currentPage + 1})"
                        class="flex items-center justify-center w-8 h-8 md:w-10 md:h-10 rounded-lg text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200 ${!hasNext ? 'opacity-30 pointer-events-none' : ''}"
                        ${!hasNext ? 'disabled' : ''}>
                    <i class="bi bi-chevron-left text-sm md:text-lg"></i>
                </button>
            `;

            html += '</div>';
            paginationContainer.innerHTML = html;
        }

        window.loadPage = function(page) {
            if (page < 1 || page > totalPages || page === currentPage || isLoading) return;

            isLoading = true;
            showLoading();

            let url = `/admin/invoices?page=${page}`;
            if (currentStatus) url += `&status=${currentStatus}`;
            if (currentSearch) url += `&search=${encodeURIComponent(currentSearch)}`;

            fetch(url, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    renderInvoices(data.invoices);
                    updatePagination(data.pagination);
                } else {
                    toast(data.message || 'خطا در بارگذاری فاکتورها', 'error');
                }
            })
            .catch(error => {
                console.error('Error loading invoices:', error);
                toast('خطا در ارتباط با سرور', 'error');
            })
            .finally(() => {
                isLoading = false;
                hideLoading();
            });
        };
    </script>
</body>
</html>