<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#050508" />
    <meta name="color-scheme" content="dark" />
    <title>مدیریت پلن‌ها | فاکتوریتو</title>

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        'ink': {
                            950: '#050508',
                            900: '#0a0a12',
                            800: '#0f0f1a',
                            700: '#151522',
                            600: '#1a1a2e',
                            500: '#22223a',
                            400: '#2a2a46',
                        },
                        'accent': {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        },
                    },
                }
            }
        }
    </script>

    <style>
        :root {
            --color-bg: #050508;
            --color-surface: #0f0f1a;
            --color-surface-elevated: #14141f;
            --color-border: rgba(167, 139, 250, 0.06);
            --color-border-strong: rgba(167, 139, 250, 0.15);
            --color-accent: #a78bfa;
            --color-accent-strong: #7c3aed;
            --color-accent-soft: rgba(167, 139, 250, 0.06);
            --color-accent-soft-hover: rgba(167, 139, 250, 0.12);
            --color-text-primary: #e5e7eb;
            --color-text-secondary: #9ca3af;
            --color-text-muted: #6b7280;
            --color-danger: #f87171;
            --color-danger-soft: rgba(239, 68, 68, 0.06);
            --color-danger-soft-hover: rgba(239, 68, 68, 0.12);
            --color-success: #34d399;
            --color-success-soft: rgba(52, 211, 153, 0.08);
            --color-warning: #fbbf24;
            --color-warning-soft: rgba(251, 191, 36, 0.08);

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;

            --duration-fast: 150ms;
            --duration-base: 250ms;
            --duration-slow: 400ms;
            --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        *,
        *::before,
        *::after {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            -webkit-text-size-adjust: 100%;
            text-rendering: optimizeLegibility;
        }

        body {
            background: var(--color-bg);
            color: var(--color-text-secondary);
            line-height: 1.8;
            font-weight: 400;
            overflow-x: hidden;
            min-height: 100dvh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: var(--color-bg); }
        ::-webkit-scrollbar-thumb { background: var(--color-surface); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #2a2a46; }

        :focus-visible {
            outline: 2px solid var(--color-accent);
            outline-offset: 2px;
            border-radius: 6px;
        }

        /* ===== Skip Link ===== */
        .skip-link {
            position: absolute;
            top: -100px;
            right: 16px;
            background: var(--color-accent-strong);
            color: #fff;
            padding: 12px 20px;
            border-radius: var(--radius-md);
            z-index: 9999;
            text-decoration: none;
            font-weight: 700;
            transition: top var(--duration-fast) ease;
        }

        .skip-link:focus {
            top: 16px;
            outline: 2px solid var(--color-accent);
            outline-offset: 2px;
        }

        /* ===== Sidebar Overlay ===== */
        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            z-index: 90;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity var(--duration-slow) var(--ease-out),
                        visibility var(--duration-slow) var(--ease-out);
        }

        .sidebar-overlay--active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        /* ===== Sidebar ===== */
        .sidebar {
            position: fixed;
            top: 16px;
            right: 16px;
            bottom: 16px;
            width: 280px;
            max-width: calc(100vw - 32px);
            background: rgba(10, 10, 18, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--color-border-strong);
            border-radius: 24px;
            box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.85);
            z-index: 110;
            padding: 20px;
            overflow-y: auto;
            transform: translateX(calc(100% + 32px));
            visibility: hidden;
            pointer-events: none;
            transition: transform var(--duration-slow) var(--ease-out),
                        visibility var(--duration-slow) var(--ease-out);
            scrollbar-width: none;
            -ms-overflow-style: none;
            will-change: transform;
            contain: layout style;
        }

        .sidebar::-webkit-scrollbar {
            display: none;
            width: 0;
        }

        .sidebar--open {
            transform: translateX(0);
            visibility: visible;
            pointer-events: auto;
        }

        @media (max-width: 480px) {
            .sidebar {
                top: 12px;
                right: 12px;
                bottom: 12px;
                width: calc(100vw - 24px);
                max-width: 280px;
            }
        }

        .sidebar__header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-border);
            margin-bottom: 20px;
        }

        .sidebar__brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .sidebar__logo {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
        }

        .sidebar__title {
            font-weight: 800;
            font-size: 18px;
            color: #fff;
        }

        .sidebar__close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: var(--color-text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background-color var(--duration-fast) ease,
                        color var(--duration-fast) ease;
            font-size: 18px;
            flex-shrink: 0;
            font-family: inherit;
        }

        .sidebar__close:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .sidebar__nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar__link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: var(--color-text-secondary);
            font-size: 14px;
            font-weight: 500;
            transition: background-color var(--duration-fast) ease,
                        color var(--duration-fast) ease;
            text-decoration: none;
            min-height: 44px;
            width: 100%;
            text-align: right;
            font-family: inherit;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .sidebar__link:hover {
            background: var(--color-accent-soft);
            color: #c4b5fd;
        }

        .sidebar__link--active {
            background: rgba(167, 139, 250, 0.08);
            color: var(--color-accent);
        }

        .sidebar__link-icon {
            font-size: 18px;
            width: 22px;
            text-align: center;
            color: var(--color-text-muted);
            flex-shrink: 0;
        }

        .sidebar__link--active .sidebar__link-icon {
            color: var(--color-accent);
        }

        .sidebar__link--danger {
            color: var(--color-danger);
        }

        .sidebar__link--danger .sidebar__link-icon {
            color: var(--color-danger);
        }

        .sidebar__divider {
            height: 1px;
            background: var(--color-border);
            margin: 8px 12px;
        }

        /* ===== Navbar ===== */
        .nav {
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            z-index: 30;
            padding: 12px;
        }

        @media (min-width: 769px) {
            .nav {
                padding: 20px 24px;
            }
        }

        .nav__container {
            max-width: 72rem;
            margin: 0 auto;
            background: rgba(10, 10, 18, 0.9);
            border: 1px solid var(--color-border-strong);
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        @media (min-width: 769px) {
            .nav__container {
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                padding: 12px 24px;
            }
        }

        .nav__brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            flex-shrink: 0;
            min-width: 0;
        }

        .nav__logo {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--color-accent-strong), var(--color-accent));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 14px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
            transition: transform var(--duration-base) var(--ease-out);
        }

        .nav__brand:hover .nav__logo {
            transform: scale(1.05);
        }

        @media (min-width: 769px) {
            .nav__logo {
                width: 36px;
                height: 36px;
                font-size: 16px;
            }
        }

        .nav__title {
            font-weight: 800;
            font-size: 14px;
            color: #fff;
            letter-spacing: -0.02em;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        @media (min-width: 769px) {
            .nav__title {
                font-size: 18px;
            }
        }

        .nav__mobile {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        @media (min-width: 769px) {
            .nav__mobile {
                display: none;
            }
        }

        .nav__icon-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 10px;
            color: var(--color-text-primary);
            cursor: pointer;
            transition: background-color var(--duration-base) ease,
                        color var(--duration-base) ease;
            font-size: 18px;
            font-family: inherit;
        }

        .nav__icon-btn:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        .nav__icon-btn--danger {
            color: var(--color-danger);
            background: var(--color-danger-soft);
            border-color: rgba(239, 68, 68, 0.1);
        }

        .nav__icon-btn--danger:hover {
            background: var(--color-danger-soft-hover);
            color: #fca5a5;
        }

        .nav__links {
            display: none;
            align-items: center;
            gap: 4px;
        }

        @media (min-width: 769px) {
            .nav__links {
                display: flex;
            }
        }

        .nav__link {
            color: var(--color-text-secondary);
            font-size: 13px;
            font-weight: 600;
            padding: 10px 16px;
            border-radius: 10px;
            transition: color var(--duration-base) ease,
                        background-color var(--duration-base) ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
            min-height: 40px;
        }

        .nav__link::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 2px;
            height: 0;
            background: var(--color-accent);
            border-radius: 2px;
            transition: height var(--duration-base) ease;
        }

        .nav__link:hover {
            color: var(--color-text-primary);
            background: var(--color-accent-soft);
        }

        .nav__link--active {
            color: var(--color-accent);
            background: var(--color-accent-soft);
        }

        .nav__link--active::before {
            height: 24px;
        }

        .nav__divider {
            width: 1px;
            height: 24px;
            background: rgba(255, 255, 255, 0.05);
            margin: 0 8px;
        }

        .nav__logout {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: var(--color-danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.1);
            border-radius: 10px;
            color: var(--color-danger);
            font-size: 13px;
            font-weight: 600;
            transition: background-color var(--duration-base) ease,
                        border-color var(--duration-base) ease,
                        color var(--duration-base) ease;
            cursor: pointer;
            min-height: 40px;
            font-family: inherit;
        }

        .nav__logout:hover {
            background: var(--color-danger-soft-hover);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        /* ===== Page ===== */
        .page {
            max-width: 72rem;
            margin: 0 auto;
            padding: 76px 12px 48px;
        }

        @media (min-width: 769px) {
            .page {
                padding: 112px 16px 64px;
            }
        }

        .page__header {
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        @media (min-width: 769px) {
            .page__header {
                margin-bottom: 40px;
            }
        }

        .page__icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            background: var(--color-accent-soft);
            color: var(--color-accent);
            flex-shrink: 0;
        }

        @media (max-width: 480px) {
            .page__icon {
                width: 32px;
                height: 32px;
                font-size: 14px;
                border-radius: 10px;
            }
        }

        .page__title {
            font-size: 22px;
            font-weight: 900;
            color: #fff;
            margin-bottom: 2px;
        }

        @media (min-width: 769px) {
            .page__title {
                font-size: 30px;
            }
        }

        @media (min-width: 1025px) {
            .page__title {
                font-size: 36px;
            }
        }

        .page__subtitle {
            font-size: 12px;
            color: var(--color-text-muted);
        }

        @media (min-width: 769px) {
            .page__subtitle {
                font-size: 14px;
            }
        }

        /* ===== Plan Cards ===== */
        .plan-cards {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        @media (min-width: 769px) {
            .plan-cards {
                gap: 16px;
            }
        }

        .plan-card {
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
            padding: 16px;
            transition: border-color var(--duration-slow) var(--ease-out),
                        background-color var(--duration-slow) var(--ease-out),
                        transform var(--duration-slow) var(--ease-out),
                        box-shadow var(--duration-slow) var(--ease-out);
            content-visibility: auto;
            contain-intrinsic-size: auto 180px;
            contain: layout style;
        }

        @media (min-width: 769px) {
            .plan-card {
                padding: 24px;
                border-radius: 18px;
            }
        }

        .plan-card:hover {
            border-color: var(--color-border-strong);
            background: rgba(20, 20, 32, 0.7);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px -12px rgba(124, 58, 237, 0.15);
        }

        .plan-card__head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 12px;
        }

        .plan-card__name {
            font-size: 16px;
            font-weight: 800;
            color: #fff;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        @media (min-width: 769px) {
            .plan-card__name {
                font-size: 18px;
            }
        }

        .plan-card__desc {
            font-size: 13px;
            color: var(--color-text-secondary);
            margin-bottom: 12px;
        }

        @media (min-width: 769px) {
            .plan-card__desc {
                font-size: 14px;
            }
        }

        .plan-card__grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 12px;
        }

        .plan-card__price {
            display: flex;
            align-items: baseline;
            gap: 6px;
        }

        .plan-card__price-value {
            font-size: 20px;
            font-weight: 900;
            color: var(--color-accent);
            font-variant-numeric: tabular-nums;
        }

        @media (min-width: 769px) {
            .plan-card__price-value {
                font-size: 24px;
            }
        }

        .plan-card__price-unit {
            font-size: 13px;
            color: var(--color-text-muted);
        }

        .plan-card__owner {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            font-size: 13px;
            color: var(--color-text-primary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .plan-card__footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            gap: 8px;
        }

        .plan-card__date {
            font-size: 11px;
            color: var(--color-text-muted);
            display: flex;
            align-items: center;
            gap: 6px;
            font-variant-numeric: tabular-nums;
        }

        .plan-card__email {
            font-size: 11px;
            color: var(--color-text-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 150px;
            direction: ltr;
        }

        /* ===== Status Badge ===== */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .status-badge--active {
            background: var(--color-success-soft);
            border: 1px solid rgba(52, 211, 153, 0.2);
            color: #6ee7b7;
        }

        .status-badge--inactive {
            background: var(--color-danger-soft);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        .status-badge__dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

        @media (max-width: 480px) {
            .status-badge {
                font-size: 9px;
                padding: 2px 8px;
            }
        }

        /* ===== Pagination ===== */
        .pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            margin-top: 32px;
            flex-wrap: wrap;
        }

        @media (min-width: 769px) {
            .pagination {
                gap: 8px;
                margin-top: 40px;
            }
        }

        .pagination__btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            padding: 0 8px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 500;
            background: transparent;
            border: 1px solid transparent;
            color: var(--color-text-secondary);
            transition: all var(--duration-fast) ease;
            cursor: pointer;
            font-family: inherit;
            font-variant-numeric: tabular-nums;
        }

        @media (min-width: 769px) {
            .pagination__btn {
                min-width: 40px;
                height: 40px;
                padding: 0 12px;
                font-size: 14px;
            }
        }

        .pagination__btn:hover:not(:disabled):not(.pagination__btn--active) {
            background: rgba(255, 255, 255, 0.05);
            color: #e5e7eb;
        }

        .pagination__btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .pagination__btn--active {
            background: var(--color-accent-strong);
            color: #fff;
            font-weight: 600;
        }

        .pagination__btn i {
            font-size: 16px;
        }

        @media (min-width: 769px) {
            .pagination__btn i {
                font-size: 18px;
            }
        }

        .pagination__dots {
            color: var(--color-text-muted);
            padding: 0 4px;
            font-size: 13px;
            user-select: none;
        }

        /* ===== Empty State ===== */
        .empty-state {
            padding: 40px 20px;
            text-align: center;
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid var(--color-border);
            border-radius: var(--radius-lg);
        }

        @media (min-width: 769px) {
            .empty-state {
                padding: 64px 20px;
            }
        }

        .empty-state__icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 28px;
            color: #4a4a63;
        }

        @media (min-width: 769px) {
            .empty-state__icon {
                width: 80px;
                height: 80px;
                font-size: 32px;
            }
        }

        .empty-state__title {
            font-size: 16px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 6px;
        }

        @media (min-width: 769px) {
            .empty-state__title {
                font-size: 18px;
            }
        }

        .empty-state__desc {
            font-size: 12px;
            color: var(--color-text-muted);
        }

        @media (min-width: 769px) {
            .empty-state__desc {
                font-size: 14px;
            }
        }

        /* ===== Skeleton ===== */
        .skeleton {
            position: relative;
            overflow: hidden;
            background: rgba(167, 139, 250, 0.04);
            border-radius: 6px;
        }

        .skeleton::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                transparent 0%,
                rgba(167, 139, 250, 0.10) 50%,
                transparent 100%
            );
            transform: translateX(-100%);
            animation: skeleton-shimmer 1.6s infinite;
        }

        @keyframes skeleton-shimmer {
            100% {
                transform: translateX(100%);
            }
        }

        .skeleton__line {
            height: 12px;
            margin-bottom: 6px;
        }

        .skeleton__line--title {
            height: 16px;
            width: 60%;
        }

        .skeleton__line--subtitle {
            height: 10px;
            width: 40%;
        }

        .skeleton__line--md {
            height: 12px;
            width: 50%;
        }

        .skeleton__line--lg {
            height: 14px;
            width: 80%;
        }

        .skeleton__badge {
            width: 60px;
            height: 20px;
            border-radius: 20px;
        }

        [data-loading="true"] .js-content {
            display: none;
        }

        [data-loading="false"] .js-content {
            display: block;
        }

        [data-loading="true"] .js-skeleton {
            display: block;
        }

        [data-loading="false"] .js-skeleton {
            display: none;
        }

        /* ===== Toast ===== */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: var(--color-surface-elevated);
            color: var(--color-text-primary);
            padding: 12px 24px;
            border-radius: var(--radius-lg);
            font-size: 13px;
            font-weight: 600;
            z-index: 1000;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.06);
            animation: toast-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            max-width: calc(100vw - 32px);
        }

        @keyframes toast-in {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        .toast--success {
            background: #0d2818;
            border-color: rgba(16, 185, 129, 0.3);
            color: #6ee7b7;
        }

        .toast--error {
            background: #3b1010;
            border-color: rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        /* ===== Reduced Motion ===== */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }

            .skeleton::after {
                animation: none;
                opacity: 0.05;
            }

            .sidebar {
                transition: none;
            }
        }
    </style>
</head>
<body>

    <a href="#main-content" class="skip-link">پرش به محتوای اصلی</a>

    <!-- ===== Sidebar Overlay ===== -->
    <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

    <!-- ===== Sidebar ===== -->
    <aside class="sidebar" id="sidebar" aria-label="منوی ناوبری موبایل" aria-hidden="true">
        <div class="sidebar__header">
            <a href="/admin/dashboard" class="sidebar__brand">
                <div class="sidebar__logo" aria-hidden="true">ا</div>
                <span class="sidebar__title">پنل ادمین</span>
            </a>
            <button type="button" class="sidebar__close" onclick="closeSidebar()" aria-label="بستن منو">
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="sidebar__nav" aria-label="ناوبری اصلی">
            <a href="/admin/dashboard" class="sidebar__link">
                <i class="bi bi-speedometer2 sidebar__link-icon" aria-hidden="true"></i> داشبورد
            </a>
            <a href="/admin/users" class="sidebar__link">
                <i class="bi bi-people sidebar__link-icon" aria-hidden="true"></i> کاربران
            </a>
            <a href="/admin/invoices" class="sidebar__link">
                <i class="bi bi-receipt sidebar__link-icon" aria-hidden="true"></i> فاکتورها
            </a>
            <a href="/admin/plans" class="sidebar__link sidebar__link--active" aria-current="page">
                <i class="bi bi-collection sidebar__link-icon" aria-hidden="true"></i> پلن‌ها
            </a>

            <% if (user && (user.role === 'admin' || user.role === 'moderator')) { %>
            <a href="/admin/deletion-requests" class="sidebar__link">
                <i class="bi bi-trash3 sidebar__link-icon" aria-hidden="true"></i> درخواست‌های حذف
            </a>
            <% } %>

            <div class="sidebar__divider" role="separator"></div>

            <a href="/dashboard" class="sidebar__link">
                <i class="bi bi-globe sidebar__link-icon" aria-hidden="true"></i> داشبورد کاربر
            </a>
            <a href="/auth/logout" class="sidebar__link sidebar__link--danger">
                <i class="bi bi-box-arrow-right sidebar__link-icon" aria-hidden="true"></i> خروج
            </a>
        </nav>
    </aside>

    <!-- ===== Navbar ===== -->
    <header class="nav" role="banner">
        <div class="nav__container">
            <a href="/admin/dashboard" class="nav__brand">
                <div class="nav__logo" aria-hidden="true">ا</div>
                <span class="nav__title">پنل ادمین</span>
            </a>

            <div class="nav__mobile">
                <a href="/auth/logout" class="nav__icon-btn nav__icon-btn--danger" aria-label="خروج از حساب کاربری">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                </a>
                <button type="button" class="nav__icon-btn" onclick="openSidebar()" aria-label="باز کردن منو" aria-expanded="false" aria-controls="sidebar" id="menuBtn">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
            </div>

            <nav class="nav__links" aria-label="ناوبری اصلی">
                <a href="/admin/dashboard" class="nav__link">
                    <i class="bi bi-speedometer2" aria-hidden="true"></i> داشبورد
                </a>
                <a href="/admin/users" class="nav__link">
                    <i class="bi bi-people" aria-hidden="true"></i> کاربران
                </a>
                <a href="/admin/invoices" class="nav__link">
                    <i class="bi bi-receipt" aria-hidden="true"></i> فاکتورها
                </a>
                <a href="/admin/plans" class="nav__link nav__link--active" aria-current="page">
                    <i class="bi bi-collection" aria-hidden="true"></i> پلن‌ها
                </a>

                <% if (user && (user.role === 'admin' || user.role === 'moderator')) { %>
                <a href="/admin/deletion-requests" class="nav__link">
                    <i class="bi bi-trash3" aria-hidden="true"></i> درخواست‌های حذف
                </a>
                <% } %>

                <div class="nav__divider" role="separator"></div>

                <a href="/dashboard" class="nav__link">
                    <i class="bi bi-globe" aria-hidden="true"></i> داشبورد کاربر
                </a>
                <a href="/auth/logout" class="nav__logout">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> خروج
                </a>
            </nav>
        </div>
    </header>

    <!-- ===== Main ===== -->
    <main id="main-content" class="page">
        <header class="page__header">
            <div class="page__icon">
                <i class="bi bi-collection" aria-hidden="true"></i>
            </div>
            <div>
                <h1 class="page__title">مدیریت پلن‌ها</h1>
                <p class="page__subtitle">مشاهده تمام پلن‌های تعریف شده توسط کاربران</p>
            </div>
        </header>

        <div id="plansContainer" data-loading="true" aria-busy="true">
            <!-- Content -->
            <div class="js-content">
                <% if (typeof plans !== 'undefined' && plans.length > 0) { %>
                <div class="plan-cards">
                    <% plans.forEach(function(p) { %>
                    <div class="plan-card">
                        <div class="plan-card__head">
                            <h3 class="plan-card__name"><%= p.name %></h3>
                            <span class="status-badge <%= p.isActive ? 'status-badge--active' : 'status-badge--inactive' %>">
                                <span class="status-badge__dot" style="background: <%= p.isActive ? '#6ee7b7' : '#fca5a5' %>;"></span>
                                <%= p.isActive ? 'فعال' : 'غیرفعال' %>
                            </span>
                        </div>

                        <% if (p.description) { %>
                        <p class="plan-card__desc"><%= p.description %></p>
                        <% } %>

                        <div class="plan-card__grid">
                            <div class="plan-card__price">
                                <span class="plan-card__price-value">
                                    <%= p.price.toLocaleString("fa-IR-u-nu-latn") %>
                                </span>
                                <span class="plan-card__price-unit">تومان</span>
                            </div>
                            <div class="plan-card__owner">
                                <%= p.user?.username || p.user?.clubName || '-' %>
                            </div>
                        </div>

                        <div class="plan-card__footer">
                            <span class="plan-card__date">
                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '-' %>
                            </span>
                            <% if (p.user?.email) { %>
                            <span class="plan-card__email">
                                <%= p.user.email %>
                            </span>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <div class="empty-state__icon">
                        <i class="bi bi-collection" aria-hidden="true"></i>
                    </div>
                    <h3 class="empty-state__title">هیچ پلنی تعریف نشده</h3>
                    <p class="empty-state__desc">کاربران هنوز پلنی ایجاد نکرده‌اند</p>
                </div>
                <% } %>
            </div>

            <!-- Skeleton -->
            <div class="js-skeleton" aria-hidden="true">
                <div class="plan-cards">
                    <% for (let i = 0; i < 3; i++) { %>
                    <div class="plan-card">
                        <div class="plan-card__head">
                            <div class="skeleton skeleton__line skeleton__line--title"></div>
                            <div class="skeleton skeleton__badge"></div>
                        </div>
                        <div class="skeleton skeleton__line skeleton__line--subtitle" style="margin-bottom: 12px;"></div>
                        <div class="plan-card__grid">
                            <div class="skeleton skeleton__line skeleton__line--lg"></div>
                            <div class="skeleton skeleton__line skeleton__line--md"></div>
                        </div>
                        <div class="plan-card__footer">
                            <div class="skeleton skeleton__line skeleton__line--md"></div>
                            <div class="skeleton skeleton__line skeleton__line--md"></div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Pagination -->
        <div id="paginationContainer" class="pagination">
            <% if (totalPages > 1) { %>
            <button type="button" class="pagination__btn" onclick="loadPage(<%= currentPage - 1 %>)" <%= currentPage <= 1 ? 'disabled' : '' %> aria-label="صفحه قبلی">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </button>

            <%
                const total = totalPages;
                const current = currentPage;
                const pages = [];

                if (total <= 7) {
                    for (let i = 1; i <= total; i++) pages.push(i);
                } else if (current <= 3) {
                    for (let i = 1; i <= 5; i++) pages.push(i);
                    pages.push('...');
                    pages.push(total);
                } else if (current >= total - 2) {
                    pages.push(1);
                    pages.push('...');
                    for (let i = total - 4; i <= total; i++) pages.push(i);
                } else {
                    pages.push(1);
                    pages.push('...');
                    for (let i = current - 1; i <= current + 1; i++) pages.push(i);
                    pages.push('...');
                    pages.push(total);
                }
            %>

            <% pages.forEach(function(p) { %>
                <% if (p === '...') { %>
                <span class="pagination__dots">...</span>
                <% } else { %>
                <button type="button" class="pagination__btn <%= p === current ? 'pagination__btn--active' : '' %>" onclick="loadPage(<%= p %>)">
                    <%= p %>
                </button>
                <% } %>
            <% }); %>

            <button type="button" class="pagination__btn" onclick="loadPage(<%= currentPage + 1 %>)" <%= currentPage >= totalPages ? 'disabled' : '' %> aria-label="صفحه بعدی">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
            <% } %>
        </div>
    </main>

    <div id="toast" class="toast" style="display: none;" role="status" aria-live="polite"></div>

    <script>
        let currentPage = <%= currentPage %>;
        let totalPages = <%= totalPages %>;
        let isLoading = false;
        let currentSearch = '<%= typeof filters !== "undefined" && filters.search ? filters.search : "" %>';
        let lastFocusedElement = null;

        // ===== Sidebar =====
        function openSidebar() {
            lastFocusedElement = document.activeElement;
            var sidebar = document.getElementById('sidebar');
            var menuBtn = document.getElementById('menuBtn');
            var overlay = document.getElementById('sidebarOverlay');

            if (!sidebar) return;

            sidebar.classList.add('sidebar--open');
            sidebar.setAttribute('aria-hidden', 'false');
            sidebar.removeAttribute('inert');
            if (overlay) {
                overlay.classList.add('sidebar-overlay--active');
                overlay.setAttribute('aria-hidden', 'false');
            }
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            var sidebar = document.getElementById('sidebar');
            var menuBtn = document.getElementById('menuBtn');
            var overlay = document.getElementById('sidebarOverlay');

            if (!sidebar) return;

            sidebar.classList.remove('sidebar--open');
            sidebar.setAttribute('aria-hidden', 'true');
            if (overlay) {
                overlay.classList.remove('sidebar-overlay--active');
                overlay.setAttribute('aria-hidden', 'true');
            }
            if (menuBtn) menuBtn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';

            if (lastFocusedElement && lastFocusedElement.focus) lastFocusedElement.focus();
        }

        // ===== Toast =====
        function toast(msg, type) {
            var t = document.getElementById('toast');

            if (!t) return;

            t.textContent = msg;
            t.style.display = 'block';
            t.className = 'toast';

            if (type === 'success') t.classList.add('toast--success');
            else if (type === 'error') t.classList.add('toast--error');

            clearTimeout(t._t);
            t._t = setTimeout(function() {
                t.style.display = 'none';
            }, 3000);
        }

        // ===== Skeleton =====
        function showSkeleton() {
            var container = document.getElementById('plansContainer');
            if (container) {
                container.setAttribute('data-loading', 'true');
                container.setAttribute('aria-busy', 'true');
            }
        }

        function hideSkeleton() {
            var container = document.getElementById('plansContainer');
            if (container) {
                container.setAttribute('data-loading', 'false');
                container.setAttribute('aria-busy', 'false');
            }
        }

        // ===== Render Plans =====
        function renderPlans(plans) {
            var container = document.getElementById('plansContainer');
            if (!container) return;

            var content = container.querySelector('.js-content');
            if (!content) {
                content = document.createElement('div');
                content.className = 'js-content';
                container.appendChild(content);
            }

            if (plans.length === 0) {
                content.innerHTML =
                    '<div class="empty-state">' +
                    '<div class="empty-state__icon"><i class="bi bi-collection"></i></div>' +
                    '<h3 class="empty-state__title">هیچ پلنی تعریف نشده</h3>' +
                    '<p class="empty-state__desc">کاربران هنوز پلنی ایجاد نکرده‌اند</p>' +
                    '</div>';
                return;
            }

            var html = '<div class="plan-cards">';

            plans.forEach(function(p) {
                var isActive = p.isActive;
                var statusColor = isActive ? '#6ee7b7' : '#fca5a5';
                var statusText = isActive ? 'فعال' : 'غیرفعال';
                var statusClass = isActive ? 'status-badge--active' : 'status-badge--inactive';
                var userName = p.user && (p.user.username || p.user.clubName) ? (p.user.username || p.user.clubName) : '-';
                var userEmail = p.user && p.user.email ? p.user.email : '';
                var price = Number(p.price).toLocaleString('fa-IR-u-nu-latn');
                var date = p.createdAt ? new Date(p.createdAt).toLocaleDateString('fa-IR-u-nu-latn') : '-';

                html += '<div class="plan-card">' +
                    '<div class="plan-card__head">' +
                    '<h3 class="plan-card__name">' + p.name + '</h3>' +
                    '<span class="status-badge ' + statusClass + '">' +
                    '<span class="status-badge__dot" style="background: ' + statusColor + ';"></span>' +
                    statusText +
                    '</span>' +
                    '</div>' +
                    (p.description ? '<p class="plan-card__desc">' + p.description + '</p>' : '') +
                    '<div class="plan-card__grid">' +
                    '<div class="plan-card__price">' +
                    '<span class="plan-card__price-value">' + price + '</span>' +
                    '<span class="plan-card__price-unit">تومان</span>' +
                    '</div>' +
                    '<div class="plan-card__owner">' + userName + '</div>' +
                    '</div>' +
                    '<div class="plan-card__footer">' +
                    '<span class="plan-card__date"><i class="bi bi-calendar3"></i> ' + date + '</span>' +
                    (userEmail ? '<span class="plan-card__email">' + userEmail + '</span>' : '') +
                    '</div>' +
                    '</div>';
            });

            html += '</div>';
            content.innerHTML = html;
        }

        // ===== Update Pagination =====
        function updatePagination(pagination) {
            var container = document.getElementById('paginationContainer');
            if (!container) return;

            totalPages = pagination.totalPages;
            currentPage = pagination.currentPage;

            if (totalPages <= 1) {
                container.innerHTML = '';
                return;
            }

            var hasPrev = currentPage > 1;
            var hasNext = currentPage < totalPages;
            var html = '';

            html += '<button type="button" class="pagination__btn" onclick="loadPage(' + (currentPage - 1) + ')" ' + (!hasPrev ? 'disabled' : '') + ' aria-label="صفحه قبلی"><i class="bi bi-chevron-right"></i></button>';

            var total = totalPages;
            var current = currentPage;
            var pages = [];

            if (total <= 7) {
                for (var i = 1; i <= total; i++) pages.push(i);
            } else if (current <= 3) {
                for (var i = 1; i <= 5; i++) pages.push(i);
                pages.push('...');
                pages.push(total);
            } else if (current >= total - 2) {
                pages.push(1);
                pages.push('...');
                for (var i = total - 4; i <= total; i++) pages.push(i);
            } else {
                pages.push(1);
                pages.push('...');
                for (var i = current - 1; i <= current + 1; i++) pages.push(i);
                pages.push('...');
                pages.push(total);
            }

            pages.forEach(function(p) {
                if (p === '...') {
                    html += '<span class="pagination__dots">...</span>';
                } else {
                    html += '<button type="button" class="pagination__btn' + (p === current ? ' pagination__btn--active' : '') + '" onclick="loadPage(' + p + ')">' + p + '</button>';
                }
            });

            html += '<button type="button" class="pagination__btn" onclick="loadPage(' + (currentPage + 1) + ')" ' + (!hasNext ? 'disabled' : '') + ' aria-label="صفحه بعدی"><i class="bi bi-chevron-left"></i></button>';

            container.innerHTML = html;
        }

        // ===== Load Page =====
        window.loadPage = function(page) {
            if (page < 1 || page > totalPages || page === currentPage || isLoading) return;

            isLoading = true;
            showSkeleton();

            var url = '/admin/plans?page=' + page;
            if (currentSearch) url += '&search=' + encodeURIComponent(currentSearch);

            fetch(url, {
                method: 'GET',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function(response) {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        renderPlans(data.plans);
                        updatePagination(data.pagination);
                    } else {
                        toast(data.message || 'خطا در بارگذاری پلن‌ها', 'error');
                    }
                })
                .catch(function(error) {
                    console.error('Error loading plans:', error);
                    toast('خطا در ارتباط با سرور', 'error');
                })
                .finally(function() {
                    isLoading = false;
                    hideSkeleton();
                });
        };

        // ===== Init =====
        document.addEventListener('DOMContentLoaded', function() {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');

            // Overlay click -> close sidebar
            if (overlay) {
                overlay.addEventListener('click', closeSidebar);
            }

            // Sidebar link click -> close sidebar (then navigate)
            if (sidebar) {
                sidebar.addEventListener('click', function(e) {
                    if (e.target.closest('a[href]')) closeSidebar();
                });
            }

            // Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Reveal skeleton
            setTimeout(function() {
                hideSkeleton();
            }, 400);
        });
    </script>
    <script src="/socket.io/socket.io.js" defer></script>
    <script src="/realtime.js" defer></script>
</body>
</html>