<!DOCTYPE html>
<html lang="fa" dir="rtl" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title><%= user.username %> | فاکتوریتو</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/sahel-font@v3.4.0/dist/font-face.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sahel': ['Sahel', 'Vazirmatn', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        'ink': {
                            950: '#050508',
                            900: '#0a0a12',
                            800: '#0f0f1a',
                            700: '#151522',
                            600: '#1a1a2e',
                            500: '#22223a',
                            400: '#2a2a46',
                        },
                        'accent': {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    },
                }
            }
        }
    </script>

    <style>
        * {
            font-family: 'Sahel', 'Vazirmatn', system-ui, sans-serif !important;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #050508;
            color: #d1d5db;
            line-height: 1.8;
            font-weight: 400;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #050508; }
        ::-webkit-scrollbar-thumb { background: #1a1a2e; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #2a2a46; }

        .glass-nav {
            background: rgba(10, 10, 18, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(167, 139, 250, 0.08);
            box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.6);
        }

        .nav-link {
            color: #9ca3af;
            font-size: 13px;
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 10px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
        }
        .nav-link::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 2px;
            height: 0;
            background: #a78bfa;
            border-radius: 2px;
            transition: all 0.3s ease;
        }
        .nav-link:hover {
            color: #e5e7eb;
            background: rgba(167, 139, 250, 0.04);
        }
        .nav-link.active {
            color: #a78bfa;
            background: rgba(167, 139, 250, 0.06);
        }
        .nav-link.active::before {
            height: 24px;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            background: rgba(239, 68, 68, 0.06);
            border: 1px solid rgba(239, 68, 68, 0.1);
            border-radius: 10px;
            color: #f87171;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
        }
        .btn-logout:hover {
            background: rgba(239, 68, 68, 0.12);
            border-color: rgba(239, 68, 68, 0.2);
            color: #fca5a5;
        }

        .card {
            background: rgba(15, 15, 26, 0.6);
            border: 1px solid rgba(167, 139, 250, 0.06);
            transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            backdrop-filter: blur(4px);
            border-radius: 16px;
        }
        .card:hover {
            border-color: rgba(167, 139, 250, 0.1);
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #a78bfa;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            margin-bottom: 24px;
            padding: 8px 14px;
            border-radius: 10px;
            background: rgba(167, 139, 250, 0.04);
            border: 1px solid rgba(167, 139, 250, 0.06);
        }
        .btn-back:hover {
            background: rgba(167, 139, 250, 0.08);
            border-color: rgba(167, 139, 250, 0.2);
            color: #c4b5fd;
            gap: 12px;
        }

        .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .role-admin {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: #f87171;
        }
        .role-moderator {
            background: rgba(168, 85, 247, 0.08);
            border: 1px solid rgba(168, 85, 247, 0.15);
            color: #c4b5fd;
        }
        .role-user {
            background: rgba(167, 139, 250, 0.08);
            border: 1px solid rgba(167, 139, 250, 0.15);
            color: #a78bfa;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }
        .status-active {
            background: rgba(52, 211, 153, 0.08);
            border: 1px solid rgba(52, 211, 153, 0.15);
            color: #34d399;
        }
        .status-suspended {
            background: rgba(251, 191, 36, 0.08);
            border: 1px solid rgba(251, 191, 36, 0.15);
            color: #fbbf24;
        }
        .status-disabled {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.15);
            color: #f87171;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(167, 139, 250, 0.04);
            border-radius: 12px;
            transition: all 0.2s ease;
        }
        .info-item:hover {
            background: rgba(255, 255, 255, 0.03);
            border-color: rgba(167, 139, 250, 0.08);
        }

        .info-item .info-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }
        .info-item .info-label {
            font-size: 11px;
            color: #6b7280;
            margin-bottom: 2px;
        }
        .info-item .info-value {
            font-size: 14px;
            font-weight: 600;
            color: #e5e7eb;
        }

        .invoice-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(167, 139, 250, 0.04);
            transition: all 0.2s ease;
        }
        .invoice-item:last-child {
            border-bottom: none;
        }
        .invoice-item:hover {
            background: rgba(167, 139, 250, 0.02);
            margin: 0 -12px;
            padding-left: 12px;
            padding-right: 12px;
            border-radius: 8px;
        }

        .empty-state {
            text-align: center;
            padding: 48px 20px;
        }
        .empty-state .empty-icon {
            width: 64px;
            height: 64px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 28px;
            color: #4a4a63;
        }
        .empty-state p {
            color: #6b7280;
            font-size: 14px;
        }

        .badge-purple {
            background: rgba(167, 139, 250, 0.08);
            color: #a78bfa;
            padding: 2px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .sidebar-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.7);
            backdrop-filter: blur(8px);
            z-index: 60;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }
        .sidebar-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: -100%;
            width: 280px;
            height: 100vh;
            background: rgba(10, 10, 18, 0.95);
            backdrop-filter: blur(20px);
            border-left: 1px solid rgba(167, 139, 250, 0.06);
            z-index: 70;
            padding: 20px;
            transition: right 0.4s cubic-bezier(0.23, 1, 0.32, 1);
            overflow-y: auto;
        }
        .sidebar.open {
            right: 0;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(167, 139, 250, 0.06);
            margin-bottom: 20px;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }
        .sidebar-logo .logo-box {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 800;
            font-size: 16px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.3);
        }
        .sidebar-logo span {
            font-weight: 800;
            font-size: 18px;
            color: #fff;
        }

        .sidebar-close {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #6b7280;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-size: 18px;
        }
        .sidebar-close:hover {
            background: rgba(255, 255, 255, 0.06);
            color: #fff;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 10px;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .sidebar-link:hover {
            background: rgba(167, 139, 250, 0.06);
            color: #c4b5fd;
        }
        .sidebar-link.active {
            background: rgba(167, 139, 250, 0.08);
            color: #a78bfa;
        }
        .sidebar-link i {
            font-size: 18px;
            width: 22px;
            text-align: center;
            color: #6b7280;
        }
        .sidebar-link.active i {
            color: #a78bfa;
        }

        .sidebar-divider {
            height: 1px;
            background: rgba(167, 139, 250, 0.06);
            margin: 8px 12px;
        }

        .menu-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            color: #d1d5db;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .menu-btn:hover {
            background: rgba(255, 255, 255, 0.06);
        }

        /* ===== MODAL ===== */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.7);
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 200;
            opacity: 0;
            visibility: hidden;
            transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
            padding: 16px;
        }
        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-dialog {
            background: rgba(15, 15, 26, 0.95);
            border: 1px solid rgba(167, 139, 250, 0.08);
            border-radius: 24px;
            padding: 32px 28px;
            max-width: 420px;
            width: 100%;
            box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6), 0 0 60px rgba(124, 58, 237, 0.05);
            transform: scale(0.92) translateY(20px);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }
        .modal-overlay.active .modal-dialog {
            transform: scale(1) translateY(0);
        }

        .modal-close-btn {
            position: absolute;
            top: 16px;
            left: 16px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #6b7280;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
            font-size: 18px;
        }
        .modal-close-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #d1d5db;
        }

        .modal-icon-wrapper {
            width: 72px;
            height: 72px;
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            font-size: 32px;
            background: rgba(239, 68, 68, 0.12);
            color: #f87171;
            position: relative;
        }
        .modal-icon-wrapper::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 28px;
            background: inherit;
            opacity: 0.3;
            filter: blur(12px);
            z-index: -1;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            text-align: center;
            margin-bottom: 4px;
        }

        .modal-subtitle {
            font-size: 13px;
            color: #9ca3af;
            text-align: center;
            margin-bottom: 24px;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
        }
        .modal-actions button {
            flex: 1;
            padding: 12px 20px;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.25s ease;
            cursor: pointer;
            border: none;
            outline: none;
        }
        .modal-actions .btn-cancel {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            color: #9ca3af;
        }
        .modal-actions .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.08);
            color: #d1d5db;
        }
        .modal-actions .btn-danger {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: #fff;
            box-shadow: 0 8px 24px rgba(220, 38, 38, 0.3);
        }
        .modal-actions .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(220, 38, 38, 0.4);
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none !important;
            }
            .menu-btn {
                display: flex !important;
            }

            .glass-nav {
                padding: 8px 12px !important;
                border-radius: 16px !important;
            }
            .glass-nav .font-extrabold.text-xl {
                font-size: 16px !important;
            }
            .glass-nav .w-9.h-9 {
                width: 32px !important;
                height: 32px !important;
                font-size: 14px !important;
            }

            main {
                padding-top: 90px !important;
                padding-left: 12px !important;
                padding-right: 12px !important;
            }

            .card {
                padding: 16px !important;
                border-radius: 14px !important;
            }

            .info-item {
                padding: 12px 14px !important;
                gap: 10px !important;
            }
            .info-item .info-icon {
                width: 32px !important;
                height: 32px !important;
                font-size: 14px !important;
            }
            .info-item .info-value {
                font-size: 13px !important;
            }

            .invoice-item {
                padding: 10px 0 !important;
                flex-wrap: wrap !important;
                gap: 8px !important;
            }
            .invoice-item .flex-1 {
                width: 100% !important;
            }
            .invoice-item .flex.items-center.gap-4 {
                width: 100% !important;
                justify-content: space-between !important;
            }

            .btn-back {
                font-size: 12px !important;
                padding: 6px 10px !important;
                margin-bottom: 16px !important;
            }

            .sidebar {
                width: 280px !important;
            }

            .empty-state {
                padding: 32px 16px !important;
            }
            .empty-state .empty-icon {
                width: 48px !important;
                height: 48px !important;
                font-size: 20px !important;
            }

            .modal-dialog {
                padding: 24px 20px;
                border-radius: 20px;
            }
            .modal-icon-wrapper {
                width: 60px;
                height: 60px;
                font-size: 26px;
                border-radius: 20px;
            }
            .modal-title {
                font-size: 18px;
            }
            .modal-actions {
                flex-direction: column-reverse;
                gap: 8px;
            }
            .modal-actions button {
                width: 100%;
                padding: 14px;
            }
            .modal-close-btn {
                top: 12px;
                left: 12px;
                width: 32px;
                height: 32px;
                font-size: 16px;
            }
        }

        @media (max-width: 480px) {
            .glass-nav .font-extrabold.text-xl {
                font-size: 14px !important;
            }
            .glass-nav .w-9.h-9 {
                width: 28px !important;
                height: 28px !important;
                font-size: 12px !important;
            }

            main {
                padding-top: 80px !important;
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .card {
                padding: 12px !important;
                border-radius: 12px !important;
            }

            .info-item {
                padding: 10px 12px !important;
                gap: 8px !important;
            }
            .info-item .info-icon {
                width: 28px !important;
                height: 28px !important;
                font-size: 12px !important;
                border-radius: 8px !important;
            }
            .info-item .info-value {
                font-size: 12px !important;
            }
            .info-item .info-label {
                font-size: 10px !important;
            }

            .invoice-item {
                padding: 8px 0 !important;
            }
            .invoice-item .text-sm {
                font-size: 12px !important;
            }
            .invoice-item .text-xs {
                font-size: 10px !important;
            }

            .role-badge,
            .status-badge {
                font-size: 10px !important;
                padding: 3px 10px !important;
            }

            .btn-back {
                font-size: 11px !important;
                padding: 4px 8px !important;
            }
            .btn-logout {
                font-size: 11px !important;
                padding: 6px 12px !important;
            }

            .modal-dialog {
                padding: 20px 16px;
                border-radius: 18px;
            }
            .modal-icon-wrapper {
                width: 56px;
                height: 56px;
                font-size: 24px;
                border-radius: 18px;
            }
            .modal-title {
                font-size: 17px;
            }
            .modal-close-btn {
                top: 10px;
                left: 10px;
                width: 30px;
                height: 30px;
                font-size: 14px;
            }
        }

        @media (min-width: 769px) {
            .sidebar-overlay,
            .sidebar,
            .menu-btn {
                display: none !important;
            }
        }
    </style>
</head>
<body class="antialiased bg-[#050508]">

    <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a href="/admin/dashboard" class="sidebar-logo">
                <div class="logo-box">ا</div>
                <span>پنل ادمین</span>
            </a>
            <button class="sidebar-close" onclick="closeSidebar()">&times;</button>
        </div>

        <div class="space-y-1">
            <a href="/admin/dashboard" class="sidebar-link">
                <i class="bi bi-speedometer2"></i> داشبورد
            </a>
            <a href="/admin/users" class="sidebar-link active">
                <i class="bi bi-people"></i> کاربران
            </a>
            <a href="/admin/invoices" class="sidebar-link">
                <i class="bi bi-receipt"></i> فاکتورها
            </a>
            <a href="/admin/plans" class="sidebar-link">
                <i class="bi bi-collection"></i> پلن‌ها
            </a>
        </div>

        <div class="sidebar-divider"></div>

        <a href="/dashboard" class="sidebar-link">
            <i class="bi bi-globe"></i> داشبورد کاربر
        </a>
        <button onclick="openLogoutModal()" class="sidebar-link" style="color: #f87171; width: 100%; text-align: right; border: none; background: transparent; cursor: pointer;">
            <i class="bi bi-box-arrow-right" style="color: #f87171;"></i> خروج
        </button>
    </div>

    <nav class="fixed top-0 right-0 left-0 z-50 px-3 md:px-6 py-3 md:py-5">
        <div class="max-w-6xl mx-auto glass-nav rounded-2xl px-3 md:px-6 py-2 md:py-3 flex items-center justify-between">
            <div class="flex items-center gap-2 md:gap-3">
                <button class="menu-btn" onclick="openSidebar()">
                    <i class="bi bi-list text-xl"></i>
                </button>
                <a href="/admin/dashboard" class="flex items-center gap-2 md:gap-2.5 no-underline shrink-0 group">
                    <div class="w-8 h-8 md:w-9 md:h-9 bg-gradient-to-br from-accent-600 to-accent-400 rounded-lg flex items-center justify-center text-white font-extrabold text-sm md:text-lg transition-transform group-hover:scale-105 shadow-lg shadow-accent-600/30">
                        ا
                    </div>
                    <span class="font-extrabold text-base md:text-xl lg:text-2xl text-white tracking-tight">پنل ادمین</span>
                </a>
            </div>

            <div class="nav-links flex items-center gap-1 md:gap-1.5">
                <a href="/admin/dashboard" class="nav-link">
                    <i class="bi bi-speedometer2"></i> <span class="hidden sm:inline">داشبورد</span>
                </a>
                <a href="/admin/users" class="nav-link active">
                    <i class="bi bi-people"></i> <span class="hidden sm:inline">کاربران</span>
                </a>
                <a href="/admin/invoices" class="nav-link">
                    <i class="bi bi-receipt"></i> <span class="hidden sm:inline">فاکتورها</span>
                </a>
                <a href="/admin/plans" class="nav-link hidden lg:inline-flex">
                    <i class="bi bi-collection"></i> پلن‌ها
                </a>

                <div class="w-px h-6 bg-white/5 mx-1 md:mx-2 hidden lg:block"></div>

                <a href="/dashboard" class="nav-link hidden md:inline-flex">
                    <i class="bi bi-globe"></i> <span class="hidden lg:inline">داشبورد کاربر</span>
                </a>
                <button onclick="openLogoutModal()" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="hidden sm:inline">خروج</span>
                </button>
            </div>
        </div>
    </nav>

    <main class="max-w-4xl mx-auto px-3 md:px-4 pt-24 md:pt-28 pb-12 md:pb-16">

        <a href="/admin/users" class="btn-back">
            <i class="bi bi-arrow-right"></i> بازگشت به لیست کاربران
        </a>

        <div class="card rounded-2xl p-4 md:p-6 lg:p-8 mb-6">
            <div class="flex items-start gap-4 md:gap-5 mb-6 md:mb-8">
                <div class="w-14 h-14 md:w-16 md:h-16 bg-accent-700/20 rounded-2xl flex items-center justify-center text-accent-400 text-xl md:text-2xl font-extrabold flex-shrink-0">
                    <%= user.username ? user.username.charAt(0).toUpperCase() : '?' %>
                </div>
                <div class="flex-1 min-w-0">
                    <h1 class="text-xl md:text-2xl lg:text-3xl font-black text-white mb-1"><%= user.username %></h1>
                    <p class="text-gray-400 text-xs md:text-sm mb-3"><%= user.email %></p>
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="role-badge <%= user.role === 'admin' ? 'role-admin' : user.role === 'moderator' ? 'role-moderator' : 'role-user' %>">
                            <i class="bi <%= user.role === 'admin' ? 'bi-shield-fill' : user.role === 'moderator' ? 'bi-star-fill' : 'bi-person-fill' %> text-[10px]"></i>
                            <%= user.role === 'admin' ? 'ادمین' : user.role === 'moderator' ? 'مدیر ارشد' : 'کاربر' %>
                        </span>
                        <span class="status-badge <%= user.status === 'active' ? 'status-active' : user.status === 'suspended' ? 'status-suspended' : 'status-disabled' %>">
                            <span style="width: 6px; height: 6px; border-radius: 50%; display: inline-block; background: <%= user.status === 'active' ? '#34d399' : user.status === 'suspended' ? '#fbbf24' : '#f87171' %>;"></span>
                            <%= user.status === 'active' ? 'فعال' : user.status === 'suspended' ? 'تعلیق' : 'غیرفعال' %>
                        </span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="info-item">
                    <div class="info-icon bg-accent-700/10 text-accent-400">
                        <i class="bi bi-building"></i>
                    </div>
                    <div>
                        <div class="info-label">نام باشگاه</div>
                        <div class="info-value"><%= user.clubName || '-' %></div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon bg-emerald-700/10 text-emerald-400">
                        <i class="bi bi-telephone"></i>
                    </div>
                    <div>
                        <div class="info-label">شماره تماس</div>
                        <div class="info-value text-left dir-ltr"><%= user.clubPhone || '—' %></div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon bg-purple-700/10 text-purple-400">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <div class="info-label">تاریخ عضویت</div>
                        <div class="info-value"><%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("fa-IR-u-nu-latn") : '—' %></div>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon bg-amber-700/10 text-amber-400">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <div class="info-label">تعداد فاکتورها</div>
                        <div class="info-value"><%= invoices.length.toLocaleString("fa-IR-u-nu-latn") %> فاکتور</div>
                    </div>
                </div>

                <% if (user.clubAddress) { %>
                <div class="info-item sm:col-span-2">
                    <div class="info-icon bg-gray-700/10 text-gray-400">
                        <i class="bi bi-geo-alt"></i>
                    </div>
                    <div>
                        <div class="info-label">آدرس</div>
                        <div class="info-value"><%= user.clubAddress %></div>
                    </div>
                </div>
                <% } %>

                <% if (user.clubCode) { %>
                <div class="info-item sm:col-span-2">
                    <div class="info-icon bg-accent-700/10 text-accent-400">
                        <i class="bi bi-hash"></i>
                    </div>
                    <div>
                        <div class="info-label">کد باشگاه</div>
                        <div class="info-value text-left dir-ltr font-mono tracking-wider"><%= user.clubCode %></div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <div class="card rounded-2xl p-4 md:p-6 lg:p-8">
            <div class="flex items-center gap-3 mb-5 md:mb-6">
                <div class="w-9 h-9 md:w-10 md:h-10 bg-emerald-700/10 rounded-xl flex items-center justify-center text-emerald-400">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <div>
                    <h2 class="text-sm md:text-base font-extrabold text-white">فاکتورهای این کاربر</h2>
                    <p class="text-[10px] md:text-xs text-gray-500">لیست فاکتورهای صادر شده</p>
                </div>
                <span class="badge-purple mr-auto"><%= invoices.length %></span>
            </div>

            <% if (invoices.length > 0) { %>
            <div>
                <% invoices.forEach(function(inv) { %>
                <div class="invoice-item">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 md:gap-3 mb-1">
                            <span class="text-sm font-semibold text-white truncate"><%= inv.member?.name || 'بدون نام' %></span>
                            <span class="text-[10px] md:text-xs text-gray-500 truncate"><%= inv.plan?.name || '—' %></span>
                            <span class="text-[10px] md:text-xs text-gray-500 <%= inv.isPaid ? 'text-emerald-400' : 'text-amber-400' %>">
                                <i class="bi <%= inv.isPaid ? 'bi-check-circle-fill' : 'bi-clock-fill' %>"></i>
                            </span>
                        </div>
                        <div class="flex items-center gap-3 text-[10px] md:text-xs text-gray-500">
                            <span>#<%= inv.invoiceNumber %></span>
                            <span><%= inv.invoiceDate %></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 md:gap-4">
                        <div class="text-right">
                            <div class="text-sm font-bold <%= inv.isPaid ? 'text-emerald-400' : 'text-amber-400' %>">
                                <%= inv.totalAmount.toLocaleString("fa-IR-u-nu-latn") %>
                            </div>
                            <div class="text-[10px] md:text-xs text-gray-500">تومان</div>
                        </div>
                        <a href="/i/<%= inv._id %>" class="w-8 h-8 rounded-lg bg-white/5 border border-white/5 flex items-center justify-center text-gray-400 hover:text-accent-400 hover:bg-accent-700/10 hover:border-accent-500/30 transition-all" title="مشاهده فاکتور">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="bi bi-inbox"></i>
                </div>
                <p>این کاربر هنوز فاکتوری صادر نکرده است</p>
            </div>
            <% } %>
        </div>
    </main>

    <!-- ===== LOGOUT MODAL ===== -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-dialog">
            <button class="modal-close-btn" onclick="closeModal('logoutModal')">
                <i class="bi bi-x-lg"></i>
            </button>
            <div class="modal-icon-wrapper">
                <i class="bi bi-box-arrow-right"></i>
            </div>
            <h3 class="modal-title">خروج از حساب</h3>
            <p class="modal-subtitle">آیا مطمئن هستید که می‌خواهید خارج شوید؟</p>

            <div class="modal-actions">
                <button class="btn-cancel" onclick="closeModal('logoutModal')">انصراف</button>
                <a href="/auth/logout" class="btn-danger" style="text-decoration: none; text-align: center;">خروج</a>
            </div>
        </div>
    </div>

    <script>
        function openSidebar() {
            document.getElementById('sidebar').classList.add('open');
            document.getElementById('sidebarOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeSidebar();
                document.querySelectorAll('.modal-overlay.active').forEach(m => m.classList.remove('active'));
            }
        });

        function openModal(id) {
            document.getElementById(id).classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
            document.body.style.overflow = '';
        }

        function openLogoutModal() {
            openModal('logoutModal');
        }

        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('active');
                    document.body.style.overflow = '';
                }
            });
        });
    </script>
</body>
</html>