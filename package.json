    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.3",
    "method-override": "^3.0.0",
    "mongoose": "^9.9.4",
    "nodemailer": "^10.0.13",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
